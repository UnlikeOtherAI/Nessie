# Root-readable Infisical-only runtime environment. Copy this to
# `.env.infisical` beside docker-compose.prod.yml and chmod it 600. It is read
# by the Infisical container only — never by the Nessie API, worker, or agents.
DB_CONNECTION_URI=postgresql://infisical:replace-with-dedicated-infisical-db-password@nessie-postgres:5432/infisical
ENCRYPTION_KEY=replace-with-16-byte-hex-infisical-encryption-key
AUTH_SECRET=replace-with-infisical-auth-secret
