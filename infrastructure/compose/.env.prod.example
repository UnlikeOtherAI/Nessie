# Nessie production env — copy to `.env` next to docker-compose.prod.yml on the
# server and fill in real values. This file is consumed two ways:
#   1. docker compose variable interpolation (${NESSIE_DB_PASSWORD}) for this dir
#   2. env_file: for the api and worker containers (model/tool/auth secrets)
# Never commit the real .env.

# ── Postgres (dedicated nessie-postgres / pgvector) ──────────────────────────
# Used to interpolate DATABASE_URL in docker-compose.prod.yml.
NESSIE_DB_PASSWORD=change-me-strong-password

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signs Nessie sessions / bootstrap tokens. Generate: openssl rand -hex 32
NESSIE_AUTH_SECRET=change-me-64-hex-chars

# ── Model provider (drives agents + embeddings) ──────────────────────────────
# Provider is auto-derived (openai|minimax|kimi) but pin it explicitly for prod.
# Ledger exposes the OpenAI-compatible chat + embedding surface and records the
# signed originating org/team/user/agent/run for every invocation.
NESSIE_MODEL_PROVIDER=openai
NESSIE_MODEL_BASE_URL=https://ledger.unlikeotherai.com/v1/openai
NESSIE_MODEL_API_KEY=replace-with-nessie-ledger-proxy-token

# Infisical runs alongside Nessie but owns every secret value. Its database,
# encryption, and auth keys live only in the separate root-readable
# `.env.infisical` file; do not add them here, as this .env reaches the worker.
# Put a write-scoped service token in the root-readable file named here (chmod
# 600). It is mounted only into the API; workers and agent sandboxes never
# receive it.
INFISICAL_IMAGE=infisical/infisical:v0.151.0
INFISICAL_SERVICE_TOKEN_FILE=/srv/nessie-secrets/infisical-service-token
INFISICAL_API_URL=https://vault.unlikeotherai.com
INFISICAL_PROJECT_ID=replace-with-infisical-project-id
INFISICAL_ENVIRONMENT=prod
# Enable only after the database, Caddy route, and service token exist.
# Enable only after every INFISICAL_* value above is provisioned.
# COMPOSE_PROFILES=secrets

# Personal model subscriptions vault. A person's own Kimi/GLM plan credential
# lives in a SECOND, separately-ACLed Infisical project — never the Nessie
# Secrets project above, whose personal partition also holds that person's
# ordinary captured secrets. Both the API and the worker read these (inference
# runs in the worker), which is why they belong in this .env rather than a
# Docker secret mounted only into the API. With any of the three required
# values unset the feature is simply unavailable: /settings/connections says so
# and linking is refused, with deliberately no PostgreSQL fallback.
NESSIE_SUBSCRIPTION_VAULT_API_URL=https://vault.unlikeotherai.com
NESSIE_SUBSCRIPTION_VAULT_PROJECT_ID=replace-with-subscriptions-project-id
NESSIE_SUBSCRIPTION_VAULT_TOKEN=replace-with-token-scoped-to-that-project-only
NESSIE_SUBSCRIPTION_VAULT_ENVIRONMENT=prod

# Optional alternate providers (only needed if NESSIE_MODEL_PROVIDER points here)
MINIMAX_API_KEY=
KIMI_API_KEY=

# ── Object storage (MinIO) ───────────────────────────────────────────────────
# File uploads (chat attachments, avatars/logos, KB file nodes + attachments)
# live in the dedicated nessie-minio container. These values are both the MinIO
# root credentials and the app's S3 credentials, and are used to interpolate the
# compose file. Generate strong values: openssl rand -hex 16.
NESSIE_STORAGE_ACCESS_KEY_ID=change-me-access-key
NESSIE_STORAGE_SECRET_ACCESS_KEY=change-me-secret-key
# Optional — bucket name (default: nessie).
NESSIE_STORAGE_BUCKET=nessie

# ── Agent tools ──────────────────────────────────────────────────────────────
# serper.dev key for the agent web_search tool.
SERPER_API_KEY=
# Ledger service authentication is shared; caller identity is carried separately
# in signed UOA + Nessie headers generated per request.
LEDGER_PUBLIC_URL=https://ledger.unlikeotherai.com
LEDGER_PROXY_TOKEN=replace-with-nessie-ledger-proxy-token
# Never point this at the upstream DeepWater provider.
LEDGER_DEEPWATER_MCP_URL=https://ledger.unlikeotherai.com/v1/mcp/deepwater

# DeepSignal authenticates Nessie as an application, separately from both the
# delegated UOA user and its inbound-webhook HMAC secret. DeepSignal must issue
# this Nessie-only dsk_ key; never reuse a Ledger, model, SSO, or webhook key.
DEEPSIGNAL_MCP_APP_KEY=replace-with-deepsignal-issued-nessie-dsk-key

# ── SSO (UnlikeOtherAuthenticator) ───────────────────────────────────────────
# Single "Sign in with SSO" button → authentication.unlikeotherai.com. UOA uses
# a config-JWT flow: Nessie serves a signed config JWT at UOA_CONFIG_URL and a
# JWKS at UOA_JWKS_URL. On first use UOA raises an integration request; once a
# UOA superuser approves it, claim the one-time client secret and set
# UOA_CLIENT_SECRET, then redeploy. See docs/deployment.md.
UOA_BASE_URL=https://authentication.unlikeotherai.com
UOA_DOMAIN=api.nessie.works
UOA_CONFIG_URL=https://api.nessie.works/api/auth/sso/config
UOA_JWKS_URL=https://api.nessie.works/.well-known/jwks.json
UOA_REDIRECT_URL=https://app.nessie.works/login
UOA_CONTACT_EMAIL=ondrej.rafaj@gmail.com
UOA_CONFIG_JWT_KID=nessie-2026-06
# base64 of an RSA-2048 private key PEM (single line): openssl genrsa 2048 | base64
UOA_CONFIG_JWT_PRIVATE_KEY_B64=
# Provided by UOA after the integration is approved.
UOA_CLIENT_SECRET=

# ── Connected accounts: Gmail / Outlook OAuth (optional) ─────────────────────
# Without these, `/api/comms/providers` reports the provider unavailable and the
# Connect email dialog offers it greyed out with "Not set up on this server" —
# which is the honest answer, not a bug. Set both halves of a pair to enable it;
# a client id alone is not enough, because the code→token exchange needs the
# secret and the connector is only registered when the pair is complete.
#
# Google: register a Web application OAuth client and add the exact callback
#   https://api.nessie.works/api/comms/connections/google/callback
NESSIE_COMMS_GOOGLE_CLIENT_ID=
NESSIE_COMMS_GOOGLE_CLIENT_SECRET=
# Optional Pub/Sub topic for Gmail push (users.watch); polling is used without it.
NESSIE_COMMS_GOOGLE_PUBSUB_TOPIC=
#
# Microsoft: register an Entra application allowing personal and/or
# organisational accounts, with the exact callback
#   https://api.nessie.works/api/comms/connections/microsoft/callback
# The secret is only needed for a confidential client; PKCE covers a public one.
NESSIE_COMMS_MICROSOFT_CLIENT_ID=
NESSIE_COMMS_MICROSOFT_CLIENT_SECRET=
