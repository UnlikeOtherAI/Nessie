# Public holding-page build -> static nginx image.
FROM node:22-slim AS builder

WORKDIR /app

# pnpm's frozen lockfile resolution invokes Git for pinned private package
# entries even though this public bundle does not import them. The token is a
# BuildKit secret, available only to the install command. The system CA bundle
# lets Git validate GitHub's certificate.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml tsconfig.base.json turbo.json eslint.config.js ./
COPY scripts/with-deep-agent-token.sh scripts/with-deep-agent-token.sh
COPY packages/ packages/
COPY web/ web/
COPY api/package.json api/package.json
COPY admin/package.json admin/package.json
COPY cli/package.json cli/package.json
COPY desktop/package.json desktop/package.json
COPY gateway/package.json gateway/package.json
COPY mobile/package.json mobile/package.json
COPY worker/package.json worker/package.json

RUN --mount=type=secret,id=deep_agent_read_token,required=true \
  corepack enable \
  && DEEP_AGENT_READ_TOKEN="$(cat /run/secrets/deep_agent_read_token)" \
    scripts/with-deep-agent-token.sh pnpm install --frozen-lockfile --filter=@nessie/web...

RUN pnpm exec turbo run lint --filter=@nessie/web \
  && pnpm exec turbo run build --filter=@nessie/web

FROM nginx:alpine

COPY infrastructure/docker/web-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/web/dist /usr/share/nginx/html

EXPOSE 80
