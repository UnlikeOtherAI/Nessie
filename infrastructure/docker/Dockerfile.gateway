# Standalone vendor-operated push relay.
FROM node:22-slim

WORKDIR /app

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*

RUN corepack enable

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml tsconfig.base.json turbo.json ./
COPY packages/push/ packages/push/
COPY gateway/ gateway/

RUN pnpm install --frozen-lockfile --filter @nessie/gateway...

# The gateway build task depends on ^build, so turbo builds @nessie/push first.
RUN pnpm exec turbo run lint --filter=@nessie/gateway \
  && pnpm exec turbo run build --filter=@nessie/gateway

ENV NODE_ENV=production

EXPOSE 5556

CMD ["node", "gateway/dist/index.js"]
