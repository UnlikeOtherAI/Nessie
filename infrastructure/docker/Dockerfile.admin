# Admin SPA build → static nginx image.
#
# The admin is a Vite/React app. `VITE_API_BASE_URL` is baked in at build time:
# in production the admin runs on its own origin (nessie.unlikeotherai.com) and
# talks to the API cross-origin (api.nessie.unlikeotherai.com), so the base URL
# must be absolute. The API's CORS allowlist must include the admin origin.
FROM node:22-slim AS builder

WORKDIR /app

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml tsconfig.base.json turbo.json ./
COPY packages/ packages/
COPY admin/ admin/
COPY mobile/package.json mobile/package.json
COPY desktop/package.json desktop/package.json
COPY gateway/package.json gateway/package.json

RUN corepack enable && pnpm install --frozen-lockfile --filter='!@nessie/mobile' --filter='!@nessie/desktop' --filter='!@nessie/gateway'

# Admin imports runtime values (not just types) from its workspace packages
# (@nessie/schemas, @nessie/config, @nessie/client-core, …) through their dist
# exports, so every package it depends on must be built before the Vite bundle.
# Build the admin's full dependency graph via turbo so the order is resolved
# automatically and adding a new workspace dep never silently breaks the image.
RUN pnpm exec turbo run build --filter=@nessie/admin

FROM nginx:alpine

COPY infrastructure/docker/admin-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/admin/dist /usr/share/nginx/html

EXPOSE 80
