# Admin SPA build → static nginx image.
#
# The admin is a Vite/React app. `VITE_API_BASE_URL` is baked in at build time:
# in production the admin runs on its own origin (app.nessie.works) and talks to
# the API cross-origin (api.nessie.works), so the base URL
# must be absolute. The API's CORS allowlist must include the admin origin.
FROM node:22-slim AS builder

WORKDIR /app

# pnpm's frozen lockfile resolution invokes Git for its pinned private package
# entries, including when the installed workspace graph does not import them.
# The system CA bundle validates GitHub's certificate and the read token is a
# BuildKit secret supplied only to that install layer.
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates git \
  && rm -rf /var/lib/apt/lists/*

ARG VITE_API_BASE_URL=""
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL

COPY pnpm-lock.yaml package.json pnpm-workspace.yaml tsconfig.base.json turbo.json eslint.config.js ./
COPY scripts/with-deep-agent-token.sh scripts/with-deep-agent-token.sh
COPY packages/ packages/
COPY admin/ admin/
COPY api/package.json api/package.json
COPY api/prisma/ api/prisma/
COPY mobile/package.json mobile/package.json
COPY desktop/package.json desktop/package.json
COPY gateway/package.json gateway/package.json

# Keep the admin image scoped to the admin dependency graph. A negative filter
# installs every other workspace package, although pnpm still resolves the
# lockfile's pinned private Git entries during a frozen install.
RUN --mount=type=secret,id=deep_agent_read_token,required=true \
  corepack enable \
  && DEEP_AGENT_READ_TOKEN="$(cat /run/secrets/deep_agent_read_token)" \
    scripts/with-deep-agent-token.sh pnpm install --frozen-lockfile --filter=@nessie/admin... --filter=@nessie/api

# The admin's runtime dependency graph includes @nessie/db. Generate its Prisma
# client before Turbo compiles that graph, using the schema and CLI from the API
# package without copying the API server source into the browser image.
RUN pnpm --filter @nessie/api exec prisma generate --schema prisma/schema.prisma

# Admin imports runtime values (not just types) from its workspace packages
# (@nessie/schemas, @nessie/config, @nessie/client-core, …) through their dist
# exports, so every package it depends on must be built before the Vite bundle.
# Build the admin's full dependency graph via turbo so the order is resolved
# automatically and adding a new workspace dep never silently breaks the image.
RUN pnpm exec turbo run lint --filter=@nessie/admin \
  && pnpm exec turbo run build --filter=@nessie/admin

FROM nginx:alpine

COPY infrastructure/docker/admin-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/admin/dist /usr/share/nginx/html

EXPOSE 80
