{
  "name": "@nessie/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "nessie": "dist/index.js"
  },
  "scripts": {
    "build": "pnpm run build:config && pnpm run prisma:generate && pnpm run build:db && pnpm run build:prepared",
    "build:config": "pnpm --filter @nessie/config build",
    "build:db": "pnpm --filter @nessie/db build",
    "build:prepared": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src --max-warnings 0",
    "prisma:generate": "pnpm --filter @nessie/api exec prisma generate --schema prisma/schema.prisma",
    "typecheck": "pnpm run prisma:generate && pnpm run typecheck:prepared",
    "typecheck:prepared": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nessie/config": "workspace:*",
    "@nessie/db": "workspace:*"
  }
}
