{
  "name": "mail-agent-e2e",
  "description": "Connected-mail worker workflow: search, read, propose a send, then reissue the exact send after approval.",
  "defaults": { "latencyMs": 0, "model": "mock-model" },
  "turns": [
    { "text": "I will locate the unread client email.", "toolCalls": [{ "toolName": "mailbox_search", "toolCallId": "mail-search", "arguments": { "unseenOnly": true, "limit": 5 } }], "usage": { "inputTokens": 40, "outputTokens": 12 } },
    { "text": "I will read the client email before replying.", "toolCalls": [{ "toolName": "mailbox_read", "toolCallId": "mail-read", "arguments": { "uid": 1 } }], "usage": { "inputTokens": 45, "outputTokens": 12 } },
    { "text": "I need approval before this message leaves the mailbox.", "toolCalls": [{ "toolName": "mailbox_send", "toolCallId": "mail-send", "arguments": { "to": ["recipient@nessie.test"], "subject": "Re: Client Tuesday", "text": "Tuesday at 10:00 works." } }], "usage": { "inputTokens": 50, "outputTokens": 15 } },
    { "text": "The approved reply is being sent now.", "toolCalls": [{ "toolName": "mailbox_send", "toolCallId": "mail-send", "arguments": { "to": ["recipient@nessie.test"], "subject": "Re: Client Tuesday", "text": "Tuesday at 10:00 works." } }], "usage": { "inputTokens": 55, "outputTokens": 10 } },
    { "text": "I read the client update and sent the approved Tuesday confirmation.", "usage": { "inputTokens": 60, "outputTokens": 15 } }
  ]
}
