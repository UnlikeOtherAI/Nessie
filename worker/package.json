{
  "name": "@nessie/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "lint": "eslint src --max-warnings 0",
    "test": "node --test --import tsx 'test/**/*.test.ts' 'src/**/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nessie/comms-connect": "workspace:*",
    "@nessie/config": "workspace:*",
    "@nessie/db": "workspace:*",
    "@nessie/knowledge": "workspace:*",
    "@nessie/mcp-client": "workspace:*",
    "@nessie/mcp-manage": "workspace:*",
    "@nessie/memory": "workspace:*",
    "@nessie/push": "workspace:*",
    "@nessie/runtime": "workspace:*",
    "@nessie/schemas": "workspace:*",
    "@prisma/client": "^6.17.1",
    "cron-parser": "^5.5.0",
    "mammoth": "^1.12.0",
    "pdf-parse": "1.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pdf-parse": "^1.1.5"
  }
}
