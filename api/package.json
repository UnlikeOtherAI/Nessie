{
  "name": "@nessie/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "lsof -ti :5554 | xargs kill -9 2>/dev/null || true",
    "dev": "tsx watch --env-file=../.env src/index.ts",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost:5432/nessie} prisma validate --schema prisma/schema.prisma",
    "lint": "eslint src --max-warnings 0",
    "test": "node --test --import tsx test/**/*.test.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@nessie/config": "workspace:*",
    "@nessie/memory": "workspace:*",
    "@nessie/runtime": "workspace:*",
    "@nessie/schemas": "workspace:*",
    "@nessie/worker": "workspace:*",
    "@prisma/client": "^6.17.1",
    "cron-parser": "^5.5.0",
    "fastify": "^5.8.4",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "prisma": "^6.17.1"
  }
}
