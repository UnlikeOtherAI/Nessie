{
  "name": "@nessie/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch src/index.ts",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://localhost:5432/nessie} prisma validate --schema prisma/schema.prisma",
    "lint": "eslint src --max-warnings 0",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "prisma migrate dev --schema prisma/schema.prisma",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.17.1",
    "@nessie/config": "workspace:*",
    "@nessie/schemas": "workspace:*"
  },
  "devDependencies": {
    "prisma": "^6.17.1"
  }
}
