{
  "name": "@nessie/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "lsof -ti :5454 | xargs kill -9 2>/dev/null || true",
    "dev": "nodemon --legacy-watch --watch src --watch ../worker/dist --ext ts,js,json,mjs --exec \"tsx --env-file=../.env src/index.ts\"",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma validate --schema prisma/schema.prisma",
    "lint": "eslint src --max-warnings 0",
    "pretest": "pnpm --filter @nessie/schemas build && pnpm --filter @nessie/mcp-client build && pnpm --filter @nessie/runtime build && pnpm --filter @nessie/knowledge build",
    "test": "node --test --import tsx test/**/*.test.ts",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:resolve-rolled-back-channel-slugs": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate resolve --rolled-back 20260613100000_channel_project_slugs --schema prisma/schema.prisma",
    "prisma:migrate:status": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate status --schema prisma/schema.prisma",
    "seed:connectors": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} tsx src/db/seed-connectors-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/websocket": "^11.2.0",
    "@nessie/config": "workspace:*",
    "@nessie/connectors": "workspace:*",
    "@nessie/db": "workspace:*",
    "@nessie/knowledge": "workspace:*",
    "@nessie/mcp-client": "workspace:*",
    "@nessie/memory": "workspace:*",
    "@nessie/runtime": "workspace:*",
    "@nessie/schemas": "workspace:*",
    "@nessie/worker": "workspace:*",
    "@prisma/client": "^6.17.1",
    "cron-parser": "^5.5.0",
    "fastify": "^5.8.4",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5",
    "nodemon": "^3.1.14",
    "prisma": "^6.17.1"
  }
}
