{
  "name": "@nessie/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "node scripts/check-dev-port.mjs",
    "dev": "nodemon --legacy-watch --watch src --watch ../worker/dist --ext ts,js,json,mjs --exec \"tsx --env-file=../.env src/index.ts\"",
    "db:validate": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma validate --schema prisma/schema.prisma",
    "lint": "eslint src --max-warnings 0",
    "pretest": "pnpm --filter @nessie/schemas build && pnpm --filter @nessie/mcp-client build && pnpm --filter @nessie/mcp-manage build && pnpm --filter @nessie/executor-manage build && pnpm --filter @nessie/runtime build && pnpm --filter @nessie/knowledge build",
    "test": "node --test --import tsx 'test/**/*.test.ts'",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "prisma:migrate:deploy": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate deploy --schema prisma/schema.prisma",
    "prisma:migrate:dev": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate dev --schema prisma/schema.prisma",
    "prisma:migrate:resolve-rolled-back": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate resolve --schema prisma/schema.prisma --rolled-back",
    "prisma:migrate:status": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} prisma migrate status --schema prisma/schema.prisma",
    "seed:apps": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} tsx src/db/seed-apps-cli.ts",
    "seed:connectors": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} tsx src/db/seed-connectors-cli.ts",
    "sync:registry": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} tsx src/db/sync-registry-cli.ts",
    "recategorize:apps": "DATABASE_URL=${DATABASE_URL:-postgresql://${PGUSER:-$USER}@localhost:5432/nessie} tsx src/db/recategorize-apps-cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.0.3",
    "@fastify/websocket": "^11.2.0",
    "@nessie/comms-connect": "workspace:*",
    "@nessie/comms-providers": "workspace:*",
    "@nessie/config": "workspace:*",
    "@nessie/connectors": "workspace:*",
    "@nessie/dashboard": "workspace:*",
    "@nessie/db": "workspace:*",
    "@nessie/executor-manage": "workspace:*",
    "@nessie/knowledge": "workspace:*",
    "@nessie/mcp-client": "workspace:*",
    "@nessie/browser-cloud": "workspace:*",
    "@nessie/mcp-manage": "workspace:*",
    "@nessie/memory": "workspace:*",
    "@nessie/model-subscriptions": "workspace:*",
    "@nessie/push": "workspace:*",
    "@nessie/runtime": "workspace:*",
    "@nessie/schemas": "workspace:*",
    "@nessie/worker": "workspace:*",
    "@nessie/workspace-admin": "workspace:*",
    "@prisma/client": "^6.17.1",
    "@unlikeotherai/billing-statement-protocol": "workspace:*",
    "adm-zip": "^0.5.17",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "cron-parser": "^5.5.0",
    "fastify": "^5.8.4",
    "markdown-it": "^14.2.0",
    "pg": "^8.16.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/markdown-it": "^14.1.2",
    "@types/pg": "^8.15.5",
    "nodemon": "^3.1.14",
    "prisma": "^6.17.1"
  }
}
