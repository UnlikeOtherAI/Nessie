model User {
  id                                  String                          @id @default(uuid()) @db.Uuid
  email                               String                          @unique
  // Stable UnlikeOtherAI subject (`sub`) — THE principal key for UOA SSO
  // resolution. Nullable: local/password accounts and generic OIDC principals
  // never carry one, and a UOA row whose backfill was ambiguous stays NULL
  // until the next login adopts it (or fails closed on a conflict). Email
  // remains unique but is no longer an identity join key on the UOA path.
  uoaSub                              String?                         @unique @map("uoa_sub")
  // NON-AUTHORITATIVE MIRROR of the identity provider's profile. UOA owns the
  // profile of every SSO principal; these columns exist only so a name and a
  // picture can be rendered without a round trip per row, and they are re-synced
  // from the provider's verified claims at login, team switch, and session
  // refresh (`api/src/services/uoa-profile-mirror.ts`). Nothing manufactures a
  // value: a row the provider has not named carries its email address until it
  // does. Dropping the columns for UOA deployments is Phase 3's later step (see
  // docs/plans/2026-08-14-uoa-sso-gap-analysis.md).
  displayName                         String                          @map("display_name")
  passwordHash                        String?                         @map("password_hash")
  // Provider-supplied avatar (e.g. the Google OIDC `picture` claim) — part of the
  // same mirror. `avatarAttachmentId` is a locally uploaded picture, reachable
  // only in deployments with no UOA (a UOA session's `PATCH /api/auth/me/avatar`
  // is refused and its picture lives in UOA). Client precedence: UOA relay >
  // local attachment > this > initials.
  avatarUrl                           String?                         @map("avatar_url")
  avatarAttachmentId                  String?                         @map("avatar_attachment_id") @db.Uuid
  pronouns                            String?
  // Platform-level super-admin flag. Sits ABOVE the per-organization `owner`
  // role: org owners administer their own tenant, but only a super-admin may
  // manage platform-global resources such as the push credentials that drive
  // the central push gateway. Defaults to false; granted out-of-band.
  superAdmin                          Boolean                         @default(false) @map("super_admin")
  // Access-token generation. Minted into the session JWT as `tv` and compared on
  // every request, so bumping it revokes every outstanding access token at once.
  // Revoking the refresh family alone is not enough: an access token stays valid
  // for its whole TTL, leaving a window after logout or a forced sign-out.
  // Unrelated to `UoaProductLink.uoaTokenVersion`, which is UOA's own epoch.
  tokenVersion                        Int                             @default(0) @map("token_version")
  preferences                         Json?
  createdAt                           DateTime                        @default(now()) @map("created_at")
  updatedAt                           DateTime                        @updatedAt @map("updated_at")
  organizationMembers                 OrganizationMember[]
  projectMembers                      ProjectMember[]
  teamMembers                         TeamMember[]
  channelMembers                      ChannelMember[]
  pushSurfacePresences                UserPushSurfacePresence[]
  knowledgeSpaceMembers               KnowledgeSpaceMember[]
  callsStarted                        Call[]                          @relation("CallStarter")
  callParticipants                    CallParticipant[]               @relation("CallParticipation")
  callInvites                         CallInvite[]
  messages                            Message[]
  reactions                           MessageReaction[]
  threadReadStates                    ThreadReadState[]
  messageConversationReadStates       MessageConversationReadState[]
  userAlerts                          UserAlert[]
  disclosureGrants                    DisclosureGrant[]
  scopeDisclosureGrants               ScopeDisclosureGrant[]
  userAlertActivity                   UserAlert[]                     @relation("UserAlertActor")
  messageThreadFollows                MessageThreadFollow[]
  favorites                           Favorite[]
  assignedTasks                       Task[]                          @relation("TaskAssignee")
  ownedTasks                          Task[]                          @relation("TaskOwner")
  createdTasks                        Task[]                          @relation("TaskCreatedBy")
  mcpCatalogOwned                     McpCatalogEntry[]               @relation("McpCatalogOwner")
  mcpCatalogReviewed                  McpCatalogEntry[]               @relation("McpCatalogReviewer")
  statuses                            UserStatus[]
  feedback                            Feedback[]
  refreshTokens                       RefreshToken[]
  authSessions                        AuthSession[]
  uoaSessionCredentials               UoaSessionCredential[]
  uoaTeamSwitchIntents           UoaTeamSwitchIntent[]
  productAccountLinks                 ProductAccountLink[]
  productTeamEnablements              ProductTeamEnablement[]
  productIntegrationRuns              ProductIntegrationRun[]
  cancelledRuns                       Run[]                           @relation("RunCancelledBy")
  pairedExecutors                     Executor[]                      @relation("ExecutorPairingOwner")
  executorPrivateAssignments          ExecutorPrivateAssignment[]     @relation("ExecutorPrivateAssignmentUser")
  reviewedExecutorCapabilityRevisions ExecutorCapabilityRevision[]    @relation("ExecutorCapabilityReviewer")
  executorOperationGrantUpdates       ExecutorAgentOperationGrant[]   @relation("ExecutorAgentOperationGrantUpdater")
  executorSessionControlLeases        ExecutorSession[]               @relation("ExecutorSessionControlLease")
  executorContinuations               ExecutorContinuation[]          @relation("ExecutorContinuationActor")
  executorAvailabilityCandidates      ExecutorAvailabilityCandidate[] @relation("ExecutorAvailabilityCandidateActor")
  createdAgentTodoTemplates           AgentTodoTemplate[]             @relation("AgentTodoTemplateCreatedBy")
  createdAgentTodos                   AgentTodo[]                     @relation("AgentTodoCreatedBy")
  startedDemonstrations               Demonstration[]                 @relation("DemonstrationStartedBy")
  agentAppConnectionRequests          AgentAppConnectionRequest[]
  avatarAttachment                    Attachment?                     @relation("UserAvatar", fields: [avatarAttachmentId], references: [id], onDelete: SetNull)

  resolvedAgentCards AgentCard[] @relation("AgentCardResolvedBy")

  agentHandoffRequests AgentHandoffRequest[]

  @@map("users")
}

// A single server-side generation orders device-token ownership handoffs across
// every account and team. It is deliberately not tied to an individual
// user: an old session for a former user must never reclaim a shared device.
model PushRegistrationGeneration {
  id    Int    @id
  value BigInt

  @@map("push_registration_generations")
}

// Rotating refresh tokens for the short-lived access JWT. Only the SHA-256 hash
// of the opaque token is stored (never the raw value). Each login starts a
// `familyId` chain; on every refresh the presented token is revoked and a
// deterministic HMAC successor is issued in the same family. A just-replaced
// token can replay that same live successor during a 60-second response-loss
// grace period; reuse after the grace period revokes the whole family.
model RefreshToken {
  id                   String                @id @default(uuid()) @db.Uuid
  userId               String                @map("user_id") @db.Uuid
  familyId             String                @map("family_id") @db.Uuid
  sessionId            String                @map("session_id") @db.Uuid
  providerId           String                @map("provider_id")
  providerType         String                @map("provider_type")
  tokenHash            String                @unique @map("token_hash")
  expiresAt            DateTime              @map("expires_at")
  revokedAt            DateTime?             @map("revoked_at")
  replacedById         String?               @map("replaced_by_id") @db.Uuid
  replayProtectedUntil DateTime?             @map("replay_protected_until") @db.Timestamptz(6)
  userAgent            String?               @map("user_agent")
  clientType           String?               @map("client_type")
  createdAt            DateTime              @default(now()) @map("created_at")
  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  uoaSessionCredential UoaSessionCredential? @relation("UoaSessionLocalToken")

  @@index([userId])
  @@index([userId, sessionId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// The revocation authority for one local login session, keyed by the access
/// token's `sid` claim (security hardening workstream 1e: S9/SB-04). Every
/// issuance minting or refreshing an access token upserts the row for that
/// `sid`; `DELETE /api/auth/sessions/:sessionId` and password change set
/// `revokedAt`, and central auth rejects any token whose sid carries one.
/// The refresh-token family table is deliberately NOT this authority: every
/// rotation revokes predecessor rows sharing the sid, so revocation state
/// there cannot outlive a rotation (docs/plans/2026-08-13, Sol M-07).
model AuthSession {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  createdAt  DateTime  @default(now()) @map("created_at")
  lastSeenAt DateTime? @map("last_seen_at")
  revokedAt  DateTime? @map("revoked_at")
  userAgent  String?   @map("user_agent")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@map("auth_sessions")
}

/// Server-side UOA refresh state bound to one Nessie refresh-token family.
/// The opaque UOA credential is AES-256-GCM encrypted; its hash supports an
/// exact compare-and-swap without persisting plaintext. `lastLocalTokenId`
/// couples every upstream rotation to one deterministic local successor.
model UoaSessionCredential {
  familyId               String                    @id @map("family_id") @db.Uuid
  userId                 String                    @map("user_id") @db.Uuid
  providerId             String                    @map("provider_id")
  subject                String                    @map("subject")
  // UOA's OWN organization/team identifiers, not local Organization/Team ids —
  // they are opaque provider strings, so no foreign key belongs here.
  organizationId         String                    @map("organization_id")
  teamId                 String                    @map("team_id")
  tokenVersion           Int                       @map("token_version")
  configUrl              String                    @map("config_url")
  refreshTokenHash       String                    @unique @map("refresh_token_hash")
  refreshTokenCiphertext String                    @map("refresh_token_ciphertext")
  refreshTokenIv         String                    @map("refresh_token_iv")
  refreshTokenAuthTag    String                    @map("refresh_token_auth_tag")
  refreshTokenExpiresAt  DateTime                  @map("refresh_token_expires_at") @db.Timestamptz(6)
  lastLocalTokenId       String                    @unique @map("last_local_token_id") @db.Uuid
  generation             Int                       @default(0)
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  user                   User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastLocalToken         RefreshToken              @relation("UoaSessionLocalToken", fields: [lastLocalTokenId], references: [id], onDelete: Cascade)
  teamSwitchIntent  UoaTeamSwitchIntent?

  @@index([userId])
  @@map("uoa_session_credentials")
}

/// One crash-recoverable team rescope request for a UOA refresh family.
/// Its source fields bind the requested target to the exact encrypted upstream
/// credential and local cookie that authorized it. The row is deleted only by
/// the atomic rescope commit, an explicit safe upstream refusal, or family
/// revocation.
model UoaTeamSwitchIntent {
  familyId                String               @id @map("family_id") @db.Uuid
  userId                  String               @map("user_id") @db.Uuid
  providerId              String               @map("provider_id")
  subject                 String
  sourceOrganizationId    String               @map("source_organization_id")
  sourceTeamId            String               @map("source_team_id")
  sourceTokenVersion      Int                  @map("source_token_version")
  sourceGeneration        Int                  @map("source_generation")
  sourceLocalTokenId      String               @map("source_local_token_id") @db.Uuid
  sourceUpstreamTokenHash String               @map("source_upstream_token_hash")
  targetOrganizationId    String               @map("target_organization_id")
  targetTeamId            String               @map("target_team_id")
  createdAt               DateTime             @default(now()) @map("created_at")
  updatedAt               DateTime             @updatedAt @map("updated_at")
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  credential              UoaSessionCredential @relation(fields: [familyId], references: [familyId], onDelete: Cascade)

  @@index([userId])
  @@map("uoa_team_switch_intents")
}

