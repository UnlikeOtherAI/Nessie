  name                   String
  projectId              String                  @map("project_id") @db.Uuid
  systemManaged          Boolean                 @default(false) @map("system_managed")
  callProvider           String                  @default("google_meet") @map("call_provider")
  // Slack-style team binding. When this Nessie team represents a UOA
  // team, `externalTeamId` is that team's UOA team id
  // (`active.teamId`) — unique, so one Nessie team per UOA team — and
  // `externalOrgId` is the owning UOA org id, kept for traceability. Null on
