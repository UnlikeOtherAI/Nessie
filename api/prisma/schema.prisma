model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  displayName         String               @map("display_name")
  passwordHash        String?              @map("password_hash")
  // Provider-supplied avatar (e.g. the Google OIDC `picture` claim), captured at
  // provisioning. `avatarAttachmentId` is a user-uploaded custom avatar that, when
  // present, overrides this. Gravatar (derived from `email`) is the next fallback.
  avatarUrl           String?              @map("avatar_url")
  avatarAttachmentId  String?              @map("avatar_attachment_id") @db.Uuid
  pronouns            String?
  // Platform-level super-admin flag. Sits ABOVE the per-organization `owner`
  // role: org owners administer their own tenant, but only a super-admin may
  // manage platform-global resources such as the push credentials that drive
  // the central push gateway. Defaults to false; granted out-of-band.
  superAdmin          Boolean              @default(false) @map("super_admin")
  preferences         Json?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  teamMembers         TeamMember[]
  channelMembers      ChannelMember[]
  knowledgeSpaceMembers KnowledgeSpaceMember[]
  callsStarted        Call[]               @relation("CallStarter")
  callParticipants    CallParticipant[]    @relation("CallParticipation")
  messages            Message[]
  reactions           MessageReaction[]
  threadReadStates    ThreadReadState[]
  userAlerts          UserAlert[]
  userAlertActivity   UserAlert[]          @relation("UserAlertActor")
  messageThreadFollows MessageThreadFollow[]
  favorites           Favorite[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  ownedTasks          Task[]               @relation("TaskOwner")
  createdTasks        Task[]               @relation("TaskCreatedBy")
  mcpCatalogOwned     McpCatalogEntry[]    @relation("McpCatalogOwner")
  mcpCatalogReviewed  McpCatalogEntry[]    @relation("McpCatalogReviewer")
  statuses            UserStatus[]
  feedback            Feedback[]
  refreshTokens       RefreshToken[]
  uoaSessionCredentials UoaSessionCredential[]
  productAccountLinks ProductAccountLink[]
  productTeamEnablements ProductTeamEnablement[]
  productIntegrationRuns ProductIntegrationRun[]
  cancelledRuns       Run[]                @relation("RunCancelledBy")
  avatarAttachment    Attachment?          @relation("UserAvatar", fields: [avatarAttachmentId], references: [id], onDelete: SetNull)

  @@map("users")
}

// Rotating refresh tokens for the short-lived access JWT. Only the SHA-256 hash
// of the opaque token is stored (never the raw value). Each login starts a
// `familyId` chain; on every refresh the presented token is revoked and a
// deterministic HMAC successor is issued in the same family. A just-replaced
// token can replay that same live successor during a 60-second response-loss
// grace period; reuse after the grace period revokes the whole family.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  sessionId    String    @map("session_id") @db.Uuid
  providerId   String    @map("provider_id")
  providerType String    @map("provider_type")
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  replayProtectedUntil DateTime? @map("replay_protected_until") @db.Timestamptz(6)
  userAgent    String?   @map("user_agent")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  uoaSessionCredential UoaSessionCredential? @relation("UoaSessionLocalToken")

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

/// Server-side UOA refresh state bound to one Nessie refresh-token family.
/// The opaque UOA credential is AES-256-GCM encrypted; its hash supports an
/// exact compare-and-swap without persisting plaintext. `lastLocalTokenId`
/// couples every upstream rotation to one deterministic local successor.
model UoaSessionCredential {
  familyId              String   @id @map("family_id") @db.Uuid
  userId                String   @map("user_id") @db.Uuid
  providerId            String   @map("provider_id")
  subject               String   @map("subject")
  organizationId        String   @map("organization_id")
  teamId                 String   @map("team_id")
  tokenVersion           Int      @map("token_version")
  configUrl              String   @map("config_url")
  refreshTokenHash       String   @unique @map("refresh_token_hash")
  refreshTokenCiphertext String   @map("refresh_token_ciphertext")
  refreshTokenIv         String   @map("refresh_token_iv")
  refreshTokenAuthTag    String   @map("refresh_token_auth_tag")
  refreshTokenExpiresAt  DateTime @map("refresh_token_expires_at") @db.Timestamptz(6)
  lastLocalTokenId       String   @unique @map("last_local_token_id") @db.Uuid
  generation             Int      @default(0)
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  lastLocalToken         RefreshToken @relation("UoaSessionLocalToken", fields: [lastLocalTokenId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("uoa_session_credentials")
}

model Organization {
  id               String               @id @default(uuid()) @db.Uuid
  name             String
  logoAttachmentId String?              @map("logo_attachment_id") @db.Uuid
  // Owner/admin opt-out for EXIF/GPS metadata stripping on image uploads at
  // the FileService chokepoint. Defaults to stripping (true); set false to
  // preserve original metadata.
  stripImageMetadata Boolean             @default(true) @map("strip_image_metadata")
  createdAt        DateTime             @default(now()) @map("created_at")
  updatedAt        DateTime             @updatedAt @map("updated_at")
  logoAttachment   Attachment?          @relation("OrganizationLogo", fields: [logoAttachmentId], references: [id], onDelete: SetNull)
  members          OrganizationMember[]
  projects         Project[]
  channels         Channel[]
  thoughts         Thought[]
  knowledgeSpaces  KnowledgeSpace[]
  knowledgePages   KnowledgePage[]
  knowledgePageChunks KnowledgePageChunk[]
  tasks            Task[]
  budgets          Budget[]
  plans            Plan[]
  approvalRequests ApprovalRequest[]
  resourceLocks    ResourceLock[]
  userStatuses     UserStatus[]
  userAlerts       UserAlert[]
  feedback         Feedback[]
  favorites        Favorite[]
  productAccountLinks ProductAccountLink[]
  productTeamEnablements ProductTeamEnablement[]
  productIntegrationRuns ProductIntegrationRun[]
  productWebhookSecrets ProductWebhookSecret[]

  // Inference control-plane back-relations. The org FKs on these tables were
  // dropped by 20260516202000_reconcile_drift and re-added (ON DELETE CASCADE)
  // by 20260530170100_reinstate_inference_org_fkeys.
  inferenceProviders          InferenceProvider[]
  inferenceModels             InferenceModel[]
  inferenceCredentialBindings InferenceCredentialBinding[]
  inferenceRoutingProfiles    InferenceRoutingProfile[]
  mcpCatalogEntries           McpCatalogEntry[]
  mcpOAuthClients             McpOAuthClient[]

  @@map("organizations")
}

model IntegratedProduct {
  id                  String                         @id @default(uuid()) @db.Uuid
  slug                String                         @unique
  name                String
  summary             String
  category            IntegratedProductCategory
  launchUrl           String?                        @map("launch_url")
  apiBaseUrl          String?                        @map("api_base_url")
  authMode            IntegratedProductAuthMode      @map("auth_mode")
  defaultInstallState IntegratedProductInstallState  @map("default_install_state")
  mcpCatalogEntryId   String?                        @map("mcp_catalog_entry_id") @db.Uuid
  pluginManifestRef   String?                        @map("plugin_manifest_ref")
  healthStatus        IntegratedProductHealthStatus  @default(unknown) @map("health_status")
  healthDetail        String?                        @map("health_detail")
  capabilities        String[]                       @default([])
  setupHint           String?                        @map("setup_hint")
  sortOrder           Int                            @default(100) @map("sort_order")
  createdAt           DateTime                       @default(now()) @map("created_at")
  updatedAt           DateTime                       @updatedAt @map("updated_at")

  accountLinks        ProductAccountLink[]
  teamEnablements     ProductTeamEnablement[]
  integrationRuns     ProductIntegrationRun[]
  mcpCatalogEntry     McpCatalogEntry?               @relation(fields: [mcpCatalogEntryId], references: [id], onDelete: SetNull)

  @@index([category])
  @@index([healthStatus])
  @@map("integrated_products")
}

model ProductAccountLink {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  userId            String                   @map("user_id") @db.Uuid
  productSlug       String                   @map("product_slug")
  uoaSub            String?                  @map("uoa_sub")
  uoaTokenVersion   Int?                     @map("uoa_token_version")
  externalAccountId String?                  @map("external_account_id")
  activeOrgId       String?                  @map("active_org_id")
  activeTeamId      String?                  @map("active_team_id")
  status            ProductAccountLinkStatus
  lastVerifiedAt    DateTime?                @map("last_verified_at")
  metadata          Json                     @default("{}") @map("metadata_json")
  createdAt         DateTime                 @default(now()) @map("created_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")

  organization      Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product           IntegratedProduct        @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  user              User                     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId, productSlug])
  @@index([productSlug, status])
  @@map("product_account_links")
}

model ProductTeamEnablement {
  id                 String            @id @default(uuid()) @db.Uuid
  organizationId     String            @map("organization_id") @db.Uuid
  teamId             String            @map("team_id") @db.Uuid
  productSlug        String            @map("product_slug")
