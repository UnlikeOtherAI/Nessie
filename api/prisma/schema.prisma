  error                    String?

  catalogEntry McpCatalogEntry @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)

  @@index([checkedAt])
  @@map("mcp_server_health")
}

model McpServerInstance {
  id                        String                  @id @default(uuid()) @db.Uuid
