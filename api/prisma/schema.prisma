  boardStyle               BoardStyle                @default(kanban) @map("board_style")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  organization             Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channels                 Channel[]
  members                  ProjectMember[]
  teams                    Team[]
  plans                    Plan[]
  approvalRequests         ApprovalRequest[]
  statusRules              UserStatusRule[]
  tasks                    Task[]
  boardColumns             BoardColumn[]
  iterations               Iteration[]
  knowledgeSpaces          KnowledgeSpace[]
  knowledgePages           KnowledgePage[]
  knowledgePageChunks      KnowledgePageChunk[]
  pushAttentionAlerts      UserAlert[]               @relation("PushAttentionAlertProject")
  userPushSurfacePresences UserPushSurfacePresence[]
  executors                Executor[]
  avatarAttachment         Attachment?               @relation("ProjectAvatar", fields: [avatarAttachmentId], references: [id], onDelete: SetNull)

  @@unique([id, organizationId])
  @@index([avatarAttachmentId])
  @@map("projects")
}

