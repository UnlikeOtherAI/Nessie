/// Encrypted MCP OAuth token storage (production SecretStore backing table).
/// Rows hold AES-256-GCM ciphertext of the OAuth token bundle keyed by the
/// opaque `secret_oauth_*` ref handed back to the credential resolution chain.
model McpOAuthSecret {
  ref        String   @id
  ciphertext String
  iv         String
  authTag    String   @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("mcp_oauth_secret")
}

/// Nessie-managed metadata for a secret held by an external vault. No secret
/// value, ciphertext, key material, or vault token may be added to this model.
model Secret {
  id             String          @id @default(uuid()) @db.Uuid
  reference      String          @unique @map("reference")
  organizationId String          @map("organization_id") @db.Uuid
  name           String
  description    String?
  provider       String?
  scopeType      SecretScopeType @map("scope_type")
  scopeId        String          @map("scope_id") @db.Uuid
  vaultReference String          @unique @map("vault_reference")
  createdById    String          @map("created_by_id") @db.Uuid
  rotatedAt      DateTime?       @map("rotated_at")
  expiresAt      DateTime?       @map("expires_at")
  status         SecretStatus    @default(active)
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grants       SecretGrant[]

  @@unique([organizationId, scopeType, scopeId, name])
  @@index([organizationId, scopeType, scopeId])
  @@index([organizationId, status])
  @@map("secrets")
}

/// Explicit permissions supplement a secret's home scope. An agent can receive
/// only `use`; the API refuses every other permission for an agent principal.
model SecretGrant {
  id            String              @id @default(uuid()) @db.Uuid
  secretId      String              @map("secret_id") @db.Uuid
  principalType SecretPrincipalType @map("principal_type")
  principalId   String              @map("principal_id") @db.Uuid
  permissions   SecretPermission[]
  expiresAt     DateTime?           @map("expires_at")
  createdById   String              @map("created_by_id") @db.Uuid
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  secret Secret @relation(fields: [secretId], references: [id], onDelete: Cascade)

  @@unique([secretId, principalType, principalId])
  @@index([principalType, principalId])
  @@map("secret_grants")
}

/// Per-organization signing secret for an integrated product's inbound webhooks
/// (e.g. DeepSignal `insight.surfaced`). Set once by an org admin who pastes the
/// secret the product returned at webhook-registration time. Stored encrypted at
/// rest (AES-256-GCM under a key derived from the deployment auth secret); the
/// plaintext is only ever read to verify an inbound HMAC signature.
model ProductWebhookSecret {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productSlug    String   @map("product_slug")
  ciphertext     String
  iv             String
  authTag        String   @map("auth_tag")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productSlug])
  @@map("product_webhook_secrets")
}

/// One-shot OAuth authorization state (RFC 6749 `state` + PKCE verifier and
/// the dynamic-flow parameters the callback needs). Postgres-backed so any
/// API/worker process can mint a flow that another process completes; rows
/// are deleted on first read and expire after 10 minutes.
model McpOAuthState {
  token     String   @id
  payload   Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mcp_oauth_states")
}

/// OAuth client obtained via Dynamic Client Registration (RFC 7591), one per
/// (organization, authorization-server issuer). Public clients carry no
/// secret; when a server issues one anyway it is stored behind an encrypted
/// `secret_*` ref, never in plaintext.
model McpOAuthClient {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  issuer          String
  clientId        String       @map("client_id")
  clientSecretRef String?      @map("client_secret_ref")
  redirectUris    String[]     @map("redirect_uris")
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, issuer])
  @@map("mcp_oauth_clients")
}

// ─── File uploads / attachments (Slack-parity files slice) ──────────────────
// Standalone, relation-free model so the files slice can land additively
// without editing the User / Message / Organization models. The link to a
// message is a nullable scalar `messageId` set after upload when the message
// is created; integrity is enforced at the application layer.
model Attachment {
  id                 String   @id @default(uuid()) @db.Uuid
  organizationId     String   @map("organization_id") @db.Uuid
  uploaderId         String?  @map("uploader_id") @db.Uuid
  messageId          String?  @map("message_id") @db.Uuid
  // App-enforced link to a knowledge-base page when this attachment is one of a
  // page's drawer attachments (no FK relation, mirroring messageId).
  knowledgePageId    String?  @map("knowledge_page_id") @db.Uuid
  // App-enforced link to a hosted-mailbox email (mirroring messageId). Inbound
  // MIME parts hang off the EmailMessage, never off the compact chat reference
  // message — chat visibility must not become an email attachment's authority.
  emailMessageId     String?  @map("email_message_id") @db.Uuid
  kind               String
  mime               String
  filename           String
  // BigInt: uploads can be up to 5 GB, which overflows a 32-bit Int.
  sizeBytes          BigInt   @map("size_bytes")
  storageKey         String   @map("storage_key")
  width              Int?
  height             Int?
  // Cheap inline preview derived from the stored bytes and kept next to them
  // (`<storage_key>.thumb.webp`), so a feed never transfers a multi-megabyte
  // original to paint a 320px box. Null on every attachment with no preview:
  // pre-existing rows (never backfilled), unsupported kinds, and failures.
  // `thumbnailStatus` is pending|ready|unavailable for the async (worker)
  // path; images thumbnailed inline at store time go straight to ready.
  thumbnailKey       String?  @map("thumbnail_key")
  thumbnailMime      String?  @map("thumbnail_mime")
  thumbnailSizeBytes BigInt?  @map("thumbnail_size_bytes")
  thumbnailWidth     Int?     @map("thumbnail_width")
  thumbnailHeight    Int?     @map("thumbnail_height")
  thumbnailStatus    String?  @map("thumbnail_status")
  createdAt          DateTime @default(now()) @map("created_at")

  logoForOrganizations Organization[] @relation("OrganizationLogo")
  avatarForUsers       User[]         @relation("UserAvatar")
  avatarForAgents      Agent[]        @relation("AgentAvatar")
  avatarForProjects    Project[]      @relation("ProjectAvatar")
  feedbackItems        Feedback[]     @relation("FeedbackAttachment")
  organization         Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@index([knowledgePageId])
  @@index([emailMessageId])
  @@index([organizationId, createdAt])
  @@map("attachments")
}

// In-app user feedback. Each row is one submission; when GitHub is configured
// it is mirrored to an issue (github_issue_number/url) and status becomes
// "submitted" (else "saved"; "failed" if the GitHub call errored).
model Feedback {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  title             String
  body              String
  attachmentId      String?      @map("attachment_id") @db.Uuid
  githubIssueNumber Int?         @map("github_issue_number")
  githubIssueUrl    String?      @map("github_issue_url")
  status            String       @default("saved")
  createdAt         DateTime     @default(now()) @map("created_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment        Attachment?  @relation("FeedbackAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
  @@map("feedback")
}

// ─── Device-token registry (native push targeting) ──────────────────────────
// One row per native device token. Mobile apps register the *native* APNs/FCM
// token on every launch. Registering transfers the installation to the current
// user and organization, so a shared device cannot retain a former person's
// private notification previews. Relation-free so the slice lands additively;
// integrity is enforced at the application layer.
enum DevicePlatform {
  ios
  android
}

model DeviceToken {
  id                  String               @id @default(uuid()) @db.Uuid
  organizationId      String               @map("organization_id") @db.Uuid
  userId              String               @map("user_id") @db.Uuid
  platform            DevicePlatform
  token               String
  appVersion          String?              @map("app_version")
  apnsEnvironment     PushApnsEnvironment? @map("apns_environment")
  registrationVersion BigInt               @default(0) @map("registration_version")
  inactiveAt          DateTime?            @map("inactive_at")
  lastSeenAt          DateTime             @default(now()) @map("last_seen_at")
  createdAt           DateTime             @default(now()) @map("created_at")
  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([organizationId])
  @@index([userId])
  @@map("device_tokens")
}

// ─── Web Push subscription registry (browser push targeting) ────────────────
// One row per (user, browser PushSubscription). The admin SPA subscribes via
// the Push API and POSTs the resulting endpoint + keys here; the worker fans a
// notification out to a user's browser subscriptions exactly like device
// tokens. `endpoint` is unique per browser; `p256dh`/`auth` are the per-
// subscription public key and secret used for RFC 8291 payload encryption.
// `organization_id`-scoped like every child table; integrity enforced at the
// application layer to keep the slice additive.
model WebPushSubscription {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?      @map("user_agent")
  lastSeenAt     DateTime     @default(now()) @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([organizationId])
  @@index([userId])
  @@map("web_push_subscriptions")
}

// ─── Push credentials (platform-global, super-admin only) ───────────────────
// Non-secret metadata for the Apple APNs / Google FCM credentials that the
// central push gateway uses. The secret bytes themselves (the `.p8` key, the
// FCM service-account JSON) live encrypted in `mcp_oauth_secret` via the
// SecretStore under a stable ref (`secretRef`); they are NEVER stored here and
// NEVER returned from any endpoint. One row per provider (apns | fcm).
enum PushProvider {
  apns
  fcm
  webpush
}

enum PushDeliveryStatus {
  sent
  failed
  dead
}

enum PushApnsEnvironment {
  sandbox
  production
}

model PushCredential {
  id              String               @id @default(uuid()) @db.Uuid
  provider        PushProvider         @unique
  // Opaque ref into the encrypted SecretStore (`mcp_oauth_secret`).
  secretRef       String               @map("secret_ref")
  // APNs metadata (null for fcm rows).
  apnsKeyId       String?              @map("apns_key_id")
  apnsTeamId      String?              @map("apns_team_id")
  apnsTopic       String?              @map("apns_topic")
  apnsEnvironment PushApnsEnvironment? @map("apns_environment")
  // FCM metadata (null for apns rows).
  fcmProjectId    String?              @map("fcm_project_id")
  fcmClientEmail  String?              @map("fcm_client_email")
  updatedByUserId String               @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("push_credentials")
}

model PushDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  messageId      String?            @map("message_id") @db.Uuid
  provider       PushProvider
  status         PushDeliveryStatus
  errorCode      String?            @map("error_code")
  attempts       Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at")
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("push_deliveries")
}

// ─── Individual Communications Connectors ───────────────────────────────────
// Per-user connections to Slack / Google (Gmail) / Microsoft (Teams+Outlook).
// The connector layer only authenticates, retrieves, syncs, and normalizes into
// one shared event model — it holds no business intelligence. Tokens live in a
// separate credential table (never shipped to the browser); ingestion is
// idempotent on the deterministic canonical key
// `provider:tenantId:conversationId:messageId` with explicit edit-versioning;
// sync jobs resume from stored cursors. Connections are per-user, never
// per-team. See docs/plans/2026-07-21-individual-communications-connector.md.

enum CommsProvider {
  slack
  google
  microsoft
}

enum CommsConnectionStatus {
  active
  needs_reauthorization
  disconnected
  error
}

enum CommsSyncPhase {
  history
  incremental
  reconciliation
}

enum CommsSyncStatus {
  pending
  running
  completed
  failed
}

enum CommsSubscriptionStatus {
  active
  expired
  failed
}

/// A single user's authenticated connection to one external communications
/// provider tenant. Scoped to the organization AND the owning user — a
/// connection is never shared across a team. The unique key makes
/// re-connecting the same provider account idempotent.
model CommsConnection {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  ownerUserId            String                @map("owner_user_id") @db.Uuid
  provider               CommsProvider
  externalTenantId       String                @map("external_tenant_id")
  externalUserId         String                @map("external_user_id")
  status                 CommsConnectionStatus @default(active)
  /// What the provider ACTUALLY granted, read from the token response — never
  /// what was requested. Google's consent screen lets a person un-tick
  /// individual scopes, so this is the only truthful account of the grant and
  /// every capability check reads it.
  grantedScopes          Json                  @default("[]") @map("granted_scopes")
  /// The capability ids most recently asked for. Kept only so the UI can show
  /// "asked for, declined" instead of an indistinguishable "not granted";
  /// it is never an authority for what the connection may do.
  requestedCapabilities  Json                  @default("[]") @map("requested_capabilities")
  /// Capability ids blocked locally. Google cannot partially revoke a grant —
  /// /revoke kills all of it — so this is how a person removes one capability
  /// without disconnecting. Enforced at the credential chokepoint, not in the
  /// UI, because the underlying Google scope is still live.
  disabledCapabilities   Json                  @default("[]") @map("disabled_capabilities")
  /// The provider's stable, immutable account id (Google's OIDC `sub`). The
  /// natural key uses the email address, which a person can rename; this is
  /// what proves the same account came back when re-authorizing to add a scope.
  providerAccountId      String?               @map("provider_account_id")
  initialSyncCompletedAt DateTime?             @map("initial_sync_completed_at")
  lastSuccessfulSyncAt   DateTime?             @map("last_successful_sync_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt              DateTime              @updatedAt @map("updated_at")

  credential            CommsConnectionCredential?
  draftActions          GmailDraftAction[]
  sendGrants            SendAuthorizationGrant[]
  resources             CommsResource[]
  syncJobs              CommsSyncJob[]
  events                CommsEvent[]
  subscriptions         CommsSubscription[]
  appConnectionRequests AgentAppConnectionRequest[]
  organization          Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ownerUserId, provider, externalTenantId, externalUserId])
  @@index([organizationId, ownerUserId])
  @@index([status])
  @@map("comms_connections")
}

/// The state of one composed email Nessie is responsible for.
///
/// This exists because an approval must bind to a draft's CONTENT, not its id:
/// a Gmail draft stays mutable through the chat card's Edit button, through
/// Gmail itself, and through another run, so hashing `{draftId}` would let an
/// approved send deliver something nobody approved. `contentFingerprint` is
/// re-read and compared on every send path — the agent tool and the human Send
/// button alike — and it is also where the conditional `draft → sending → sent`
/// claim lives, so a double click or a retried job cannot send twice.
model GmailDraftAction {
  id                 String                @id @default(uuid()) @db.Uuid
  organizationId     String                @map("organization_id") @db.Uuid
  ownerUserId        String                @map("owner_user_id") @db.Uuid
  connectionId       String                @map("connection_id") @db.Uuid
  /// Gmail's draft id. Stable across updates, unlike the message id.
  providerDraftId    String                @map("provider_draft_id")
  /// Gmail thread this draft replies into, when it is a reply.
  providerThreadId   String?               @map("provider_thread_id")
  /// SHA-256 over the canonical recipients/subject/body/attachments.
  contentFingerprint String                @map("content_fingerprint")
  /// Bumped on every edit, so a stale card can tell it is looking at old text.
  revision           Int                   @default(1)
  state              GmailDraftActionState @default(draft)
  /// The chat message carrying the card, so realtime can refresh it in place.
  messageId          String?               @map("message_id") @db.Uuid
  /// Set when a send is held for the undo window; the job fires at this time.
  sendAfter          DateTime?             @map("send_after")
  /// Set when a dispatcher claims the row (`sending → dispatching`). Cleared
  /// on every terminal transition. A row still `dispatching` long after this
  /// timestamp means the claiming worker died mid-send and may be reclaimed.
  claimedAt          DateTime?             @map("claimed_at")
  sentAt             DateTime?             @map("sent_at")
  sentMessageId      String?               @map("sent_message_id")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, providerDraftId])
  @@index([organizationId, ownerUserId, state])
  @@index([state, sendAfter])
  @@map("gmail_draft_actions")
}

enum GmailDraftActionState {
  draft
  /// Held for the undo window, ready for the send sweep to claim.
  sending
  /// Atomically claimed by a dispatcher (the API's immediate send or the
  /// worker's send sweep) ahead of the provider call. The flip
  /// `sending → dispatching` is the cross-worker ownership claim, so two
  /// worker replicas can never both pass it and send the same email twice.
  /// Not user-visible — a row should sit here only for a send's duration.
  dispatching
  sent
  discarded
}

/// Standing consent for an agent to send email as a person WITHOUT asking each
/// time, modelled on ScopeDisclosureGrant: evaluation is a single exact-key
/// lookup with no wildcard, inheritance, or fallback, so consenting for one
/// agent implies nothing about another and one mailbox implies nothing about
/// another. `expiresAt` null means "until revoked".
///
/// It never covers an unattended run, never covers a requester who is not the
/// mailbox owner, and never replaces the content-fingerprint check.
/// How a grant behaves. `always` sends whenever the owner asks; `judged` has
/// the assistant weigh each action against the owner's own written boundary
/// and ask when it is unsure. There is deliberately no "deny" outcome — the
/// assistant never silently refuses on somebody's behalf, so anything outside
/// the boundary becomes a question rather than a rejection.
enum SendAuthorizationMode {
  always
  judged
}

model SendAuthorizationGrant {
  id              String                @id @default(uuid()) @db.Uuid
  mode            SendAuthorizationMode @default(always)
  /// The owner's boundary, in their own words. Judged by a model on every
  /// action, never parsed: a rule builder with keyword fields could not honour
  /// a boundary written in Czech about mail written in Slovak. Owner-private —
  /// it is read through an owner-gated route and never leaves in metadata.
  boundary        String?
  /// Running shape, so the settings row can say "12 sent · 3 asked you".
  decidedCount    Int                   @default(0) @map("decided_count")
  askedCount      Int                   @default(0) @map("asked_count")
  lastDecidedAt   DateTime?             @map("last_decided_at")
  organizationId  String                @map("organization_id") @db.Uuid
  connectionId    String                @map("connection_id") @db.Uuid
  agentId         String                @map("agent_id") @db.Uuid
  grantedByUserId String                @map("granted_by_user_id") @db.Uuid
  expiresAt       DateTime?             @map("expires_at")
  revokedAt       DateTime?             @map("revoked_at")
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  agent        Agent           @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([connectionId, agentId])
  @@index([organizationId, connectionId])
  @@map("send_authorization_grants")
}

/// Encrypted OAuth token bundle for a connection, isolated in its own table so
/// token material never sits alongside connection metadata or normalized event
/// data. Ciphertext is produced with the shared `@nessie/runtime` AES-256-GCM
/// secret-crypto primitives (packed iv/authTag/ciphertext), never sent to the
/// browser. `keyVersion` supports future key rotation; `scopeHash` lets a
/// re-auth detect a scope change without decrypting.
model CommsConnectionCredential {
  id                     String    @id @default(uuid()) @db.Uuid
  connectionId           String    @unique @map("connection_id") @db.Uuid
  accessTokenCiphertext  String    @map("access_token_ciphertext")
  refreshTokenCiphertext String?   @map("refresh_token_ciphertext")
  expiresAt              DateTime? @map("expires_at")
  keyVersion             Int       @default(1) @map("key_version")
  scopeHash              String    @map("scope_hash")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  connection CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("comms_connection_credentials")
}

/// Single-use, short-lived OAuth authorization state bound to the initiating
/// user + provider + organization. `payload` carries the PKCE verifier and
/// redirect parameters the callback needs. Consumed on first read and expired
/// by TTL, mirroring `mcp_oauth_states`.
model CommsOAuthState {
  token          String        @id
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       CommsProvider
  payload        Json
  expiresAt      DateTime      @map("expires_at")
  consumedAt     DateTime?     @map("consumed_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, userId, provider])
  @@index([expiresAt])
  @@map("comms_oauth_states")
}

/// A syncable resource inside a connection: a Slack channel/DM, a Teams chat or
/// channel, a Gmail label, an Outlook folder, etc. `resourceType` is a free
/// string so providers can name their own container kinds. Unique per external
/// id within the connection.
model CommsResource {
  id            String   @id @default(uuid()) @db.Uuid
  connectionId  String   @map("connection_id") @db.Uuid
  resourceType  String   @map("resource_type")
  externalId    String   @map("external_id")
  name          String?
  visibility    String?
  userHasAccess Boolean  @default(true) @map("user_has_access")
  syncEnabled   Boolean  @default(true) @map("sync_enabled")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  connection    CommsConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncJobs      CommsSyncJob[]
  subscriptions CommsSubscription[]

  @@unique([connectionId, externalId])
  @@index([connectionId, syncEnabled])
  @@map("comms_resources")
}

/// A resumable sync job for a connection (optionally scoped to one resource).
/// `cursor` is the provider pagination/delta token; a failed job resumes from
/// it rather than restarting. `oldest`/`newestImportedAt` bound the imported
/// window for history back-fill and incremental catch-up.
model CommsSyncJob {
  id               String          @id @default(uuid()) @db.Uuid
  connectionId     String          @map("connection_id") @db.Uuid
  resourceId       String?         @map("resource_id") @db.Uuid
  phase            CommsSyncPhase
  cursor           String?
  oldestImportedAt DateTime?       @map("oldest_imported_at")
  newestImportedAt DateTime?       @map("newest_imported_at")
  status           CommsSyncStatus @default(pending)
  retryCount       Int             @default(0) @map("retry_count")
  lastError        String?         @map("last_error")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  connection CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  resource   CommsResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([connectionId, status])
  @@index([resourceId])
  @@map("comms_sync_jobs")
}

/// The normalized event store: every imported message/thread/email in one
/// provider-agnostic shape. `canonicalMessageId` is the deterministic key
/// (`provider:tenantId:conversationId:messageId`); edits create a new `version`
/// of the same canonical id rather than mutating in place, so the unique key is
/// (connectionId, canonicalMessageId, version). Deletes flip `isDeleted`.
model CommsEvent {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  connectionId       String        @map("connection_id") @db.Uuid
  canonicalMessageId String        @map("canonical_message_id")
  version            Int           @default(1)
  isDeleted          Boolean       @default(false) @map("is_deleted")
  editedAt           DateTime?     @map("edited_at")
  provider           CommsProvider
  externalTenantId   String        @map("external_tenant_id")
  conversationId     String        @map("conversation_id")
  threadId           String?       @map("thread_id")
  messageId          String        @map("message_id")
  eventType          String        @map("event_type")
  occurredAt         DateTime      @map("occurred_at")
  senderExternalId   String?       @map("sender_external_id")
  senderDisplayName  String?       @map("sender_display_name")
  senderEmail        String?       @map("sender_email")
  participants       Json          @default("[]")
  subject            String?
  contentText        String?       @map("content_text")
  contentHtml        String?       @map("content_html")
  attachments        Json          @default("[]")
  mentions           Json          @default("[]")
  reactions          Json          @default("[]")
  visibility         String
  sourceUrl          String?       @map("source_url")
  rawPayloadRef      String?       @map("raw_payload_ref")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  connection   CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  organization Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([connectionId, canonicalMessageId, version])
  @@index([organizationId, connectionId, occurredAt])
  @@index([connectionId, conversationId, occurredAt])
  @@map("comms_events")
}

/// A provider webhook/watch subscription that must be renewed before it
/// expires (Microsoft Graph subscriptions, Gmail watch, Slack Events). The
/// renewal sweep queries by `status` + `expiresAt`. `clientState` is the
/// provider-echoed validation token.
model CommsSubscription {
  id                     String                  @id @default(uuid()) @db.Uuid
  connectionId           String                  @map("connection_id") @db.Uuid
  resourceId             String?                 @map("resource_id") @db.Uuid
  provider               CommsProvider
  externalSubscriptionId String                  @map("external_subscription_id")
  clientState            String?                 @map("client_state")
  expiresAt              DateTime                @map("expires_at")
  status                 CommsSubscriptionStatus @default(active)
  createdAt              DateTime                @default(now()) @map("created_at")
  updatedAt              DateTime                @updatedAt @map("updated_at")

  connection CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  resource   CommsResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalSubscriptionId])
  @@index([status, expiresAt])
  @@map("comms_subscriptions")
}

/// Fixed-window counters for the auth-sensitive request rate limiter
/// (api/src/services/rate-limit.ts). One row per (bucket, key, window start);
/// atomic upsert-increment makes multi-replica counting safe. Rows are
/// deleted once their window has passed (probabilistic cleanup per hit), so
/// the table stays bounded by active keys per window. `keyHash` is a SHA-256
/// of the caller identity (IP or user id) — raw IPs are never persisted.
model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String
  keyHash     String   @map("key_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([bucket, keyHash, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}

// ---------------------------------------------------------------------------
// Live Data Dashboards (docs/plans/2026-08-13-live-data-dashboards/overview.md)
//
// Tenancy note: `organizationId` carries a real FK on the two roots (Dashboard,
// DashboardDataSource) and is a denormalized plain column on their children —
// the same shape the Thought/KnowledgePage envelope uses for its loose scope
// columns. Children cascade through their parent, and every by-id read still
// filters on organizationId (never a bare findUnique on a caller-supplied id).
// ---------------------------------------------------------------------------

/// Which container a dashboard belongs to. Exactly one matching scope column is
/// set; the pairing is enforced by a CHECK constraint in the migration, not by
/// convention, because an unmatched pair would silently widen an audience.
enum DashboardHome {
  organization
  project
  team
  channel
  personal
}

enum DashboardAuthorType {
  user
  agent
}

/// Only `http` at v1. In-process adapters for internal Nessie data are a later
/// kind, deliberately not a loopback HTTP source (privilege confusion).
enum DashboardSourceKind {
  http
}

enum DashboardRefreshMode {
  manual
  interval
}

enum DashboardGrantLevel {
  view
  edit
}

/// `delegated`: fetched under the source authority's credential and visible to
/// the dashboard's audience — the confirmed model for external APIs, because a
/// third-party service cannot evaluate a Nessie viewer. `viewer` is reserved
/// for future in-process adapters where per-viewer entitlement IS expressible.
enum DashboardAccessMode {
  delegated
  viewer
}

model Dashboard {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  home           DashboardHome
  projectId      String?       @map("project_id") @db.Uuid
  teamId         String?       @map("team_id") @db.Uuid
  channelId      String?       @map("channel_id") @db.Uuid
  ownerUserId    String?       @map("owner_user_id") @db.Uuid

  title       String
  description String?
  /// DashboardLayout — per-breakpoint rects (lg/md/sm), validated on write.
  layout      Json    @default("{\"lg\":[],\"md\":[],\"sm\":[]}")
  /// Optimistic concurrency: a stale editor loses rather than silently
  /// overwriting an agent that moved a widget a second ago.
  revision    Int     @default(1)

  createdByType DashboardAuthorType @map("created_by_type")
  createdBy     String              @map("created_by")
  archivedAt    DateTime?           @map("archived_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  widgets      DashboardWidget[]
  versions     DashboardVersion[]

  @@index([organizationId, home, archivedAt])
  @@index([organizationId, projectId])
  @@map("dashboards")
}

model DashboardDataSource {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String
  kind           DashboardSourceKind @default(http)

  /// Locked once a credential is attached: changing it revokes the secret, so
  /// "point Alice's key at my server" is not expressible.
  origin      String
  path        String @default("/")
  /// Bounded literals plus closed relative-time tokens. No templating.
  queryParams Json?  @map("query_params")

  /// Server-minted `secret_dashboard_*` reference. Never returned by any read
  /// API and never accepted from a client — write-only, including for agents.
  credentialRef    String? @map("credential_ref")
  credentialMode   String? @map("credential_mode")
  credentialHeader String? @map("credential_header")

  /// Whose API access refreshes this source. Visible to the audience.
  authorityUserId String              @map("authority_user_id") @db.Uuid
  accessMode      DashboardAccessMode @default(delegated) @map("access_mode")

  /// JMESPath, compiled at write through the shared sandboxed evaluator.
  transform     String
  /// Declared [{ key, label, type, nullable }] — rows carrying anything else
  /// fail the refresh rather than being persisted "just in case".
  outputColumns Json   @map("output_columns")

  refreshMode     DashboardRefreshMode @default(manual) @map("refresh_mode")
  intervalMinutes Int?                 @map("interval_minutes")
  cacheTtlSeconds Int                  @default(300) @map("cache_ttl_seconds")

  latestDatasetId     String?   @map("latest_dataset_id") @db.Uuid
  lastAttemptAt       DateTime? @map("last_attempt_at")
  lastValidatedAt     DateTime? @map("last_validated_at")
  /// A stable code, never an upstream message and never a response body.
  lastErrorCode       String?   @map("last_error_code")
  consecutiveFailures Int       @default(0) @map("consecutive_failures")
  nextRunAt           DateTime? @map("next_run_at")
  claimedAt           DateTime? @map("claimed_at")
  etag                String?
  lastModified        String?   @map("last_modified")

  createdByType DashboardAuthorType @map("created_by_type")
  createdBy     String              @map("created_by")
  archivedAt    DateTime?           @map("archived_at")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  datasets     DashboardDataset[]
  widgets      DashboardWidget[]

  @@unique([organizationId, name])
  @@index([nextRunAt, claimedAt])
  @@map("dashboard_data_sources")
}

/// One immutable normalized fetch. Bytes live in an Attachment through the
/// FileService chokepoint, so they carry storage accounting like every blob.
model DashboardDataset {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourceId       String   @map("source_id") @db.Uuid
  attachmentId   String   @map("attachment_id") @db.Uuid
  schemaVersion  Int      @map("schema_version")
  rowCount       Int      @map("row_count")
  byteSize       Int      @map("byte_size")
  fetchedAt      DateTime @map("fetched_at")
  createdAt      DateTime @default(now()) @map("created_at")

  source    DashboardDataSource       @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  snapshots DashboardWidgetSnapshot[]

  @@index([organizationId, sourceId, fetchedAt(sort: Desc)])
  @@map("dashboard_datasets")
}

model DashboardWidget {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  dashboardId    String @map("dashboard_id") @db.Uuid
  sourceId       String @map("source_id") @db.Uuid

  kind          String
  schemaVersion Int    @default(1) @map("schema_version")
  /// Validated WidgetDefinition. Re-validated on read: a stored row is
  /// untrusted, and one no current reader accepts renders inert.
  spec          Json

  /// "Agents can't change this widget" — enforced server-side, not by asking.
  lockedAt DateTime? @map("locked_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  dashboard Dashboard           @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  source    DashboardDataSource @relation(fields: [sourceId], references: [id], onDelete: Restrict)

  @@index([organizationId, dashboardId])
  @@map("dashboard_widgets")
}

/// A frozen moment: spec, binding and the exact dataset pinned together.
/// `widgetId` is a loose column deliberately — a snapshot outlives the widget
/// it came from, because it has already been quoted into a message or a page.
model DashboardWidgetSnapshot {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  widgetId       String @map("widget_id") @db.Uuid
  dashboardId    String @map("dashboard_id") @db.Uuid

  kind          String
  schemaVersion Int    @map("schema_version")
  spec          Json
  datasetId     String @map("dataset_id") @db.Uuid

  takenByType    DashboardAuthorType @map("taken_by_type")
  takenById      String              @map("taken_by_id")
  /// "Captured under Alice's API access" — delegation stays visible on the
  /// frozen copy, because that is where it travels furthest from its origin.
  authorityLabel String?             @map("authority_label")
  createdAt      DateTime            @default(now()) @map("created_at")

  dataset DashboardDataset @relation(fields: [datasetId], references: [id], onDelete: Restrict)

  @@index([organizationId, widgetId])
  @@map("dashboard_widget_snapshots")
}

/// Append-only. A version captures STRUCTURE, never data — data has its own
/// immutable lineage in datasets and snapshots. Restore appends a new version.
model DashboardVersion {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  dashboardId    String @map("dashboard_id") @db.Uuid
  versionNumber  Int    @map("version_number")

  layout  Json
  /// Frozen validated widget specs, not joins: history must survive deletion.
  widgets Json

  authorType DashboardAuthorType @map("author_type")
  authorId   String              @map("author_id")
  /// The run that made the change, so "why did this move?" is one click away.
  runId      String?             @map("run_id") @db.Uuid
  /// Composed deterministically from the op log (structural fact, never a
  /// reading of message content).
  summary    String
  createdAt  DateTime            @default(now()) @map("created_at")

  dashboard Dashboard @relation(fields: [dashboardId], references: [id], onDelete: Cascade)

  @@unique([dashboardId, versionNumber])
  @@index([organizationId, dashboardId, createdAt(sort: Desc)])
  @@map("dashboard_versions")
}

/// An explicit grant. Audience grants (channel/team/project/knowledge space)
/// follow membership dynamically; user and agent grants are exact principals.
model DashboardGrant {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  resourceType   String              @map("resource_type")
  resourceId     String              @map("resource_id") @db.Uuid
  subjectType    String              @map("subject_type")
  subjectId      String              @map("subject_id") @db.Uuid
  level          DashboardGrantLevel
  createdBy      String              @map("created_by")
  expiresAt      DateTime?           @map("expires_at")
  revokedAt      DateTime?           @map("revoked_at")
  createdAt      DateTime            @default(now()) @map("created_at")

  @@unique([resourceType, resourceId, subjectType, subjectId])
  @@index([organizationId, subjectType, subjectId])
  @@map("dashboard_grants")
}

/// Where an embed physically sits. Grants NOTHING by itself: every read
/// re-checks both the target container and the resource.
model DashboardEmbedPlacement {
  id               String  @id @default(uuid()) @db.Uuid
  organizationId   String  @map("organization_id") @db.Uuid
  mode             String
  widgetId         String? @map("widget_id") @db.Uuid
  widgetSnapshotId String? @map("widget_snapshot_id") @db.Uuid
  targetType       String  @map("target_type")
  targetId         String  @map("target_id") @db.Uuid

  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([organizationId, targetType, targetId])
  @@map("dashboard_embed_placements")
}

// ── Hosted agent mailboxes (docs/plans/2026-09-02-agent-email.md, Model B) ───
//
// Amazon SES is integrated directly, so the deployment's own account sends and
// receives and an address is unique per deployment. Emails are their own store,
// NOT Message rows: delivery state, MIME identity and external participants are
// not a chat thread's semantics. Each mailbox keeps one backing channel
// (ChannelSystemType.agent_email) with one Thread per EmailConversation — that
// thread is the operations room where runs, approval gates and human discussion
// live, while the mail itself stays here.

enum MailboxTransportSecurity {
  /// Encrypted from the first byte (IMAPS 993 / SMTPS 465).
  tls
  /// Plaintext then upgraded. The client refuses to continue if the server
  /// does not offer the upgrade — a missing STARTTLS is a downgrade, not a
  /// fallback, and the password would otherwise go out in the clear.
  starttls
}

enum MailboxConnectionStatus {
  active
  /// The provider rejected the credential. A person reconnects; nothing retries.
  needs_reauthorization
  disabled
}

enum AgentMailboxStatus {
  active
  suspended
}

/// What an agent may do with its mailbox without a human in the loop.
/// P1 ships the column, the PATCH route and the control; P2 unlocks the two
/// non-default values behind the structural floors in the plan's §3.6.
enum AgentMailboxSendPolicy {
  approval
  auto_reply
  auto
}

enum EmailMessageDirection {
  inbound
  outbound
}

/// Structural header classification (RFC facts, never content interpretation).
/// `bulk` and `dsn` are stored and displayed but never start a run.
enum EmailMessageClassification {
  normal
  bulk
  dsn
}

/// Outbound lifecycle. `sending` is a claim, not a state anyone rests in:
/// a worker death between SES accept and the local write resolves to
/// `delivery_unknown`, which is surfaced and NEVER auto-retried — a retry is a
/// duplicate email.
enum EmailDeliveryState {
  queued
  sending
  sent
  delivery_unknown
  bounced
  complained
}

enum EmailDomainStatus {
  pending_dns
  verified
  failed
  revoked
}

model AgentMailbox {
  id              String                 @id @default(uuid()) @db.Uuid
  organizationId  String                 @map("organization_id") @db.Uuid
  agentId         String                 @unique @map("agent_id") @db.Uuid
  // Full, lowercased address. Unique per deployment — deleting a mailbox
  // retires the address permanently (retiredAt set, row kept read-only) so a
  // recycled local part can never inherit an old correspondent's trust.
  address         String                 @unique
  domainId        String?                @map("domain_id") @db.Uuid
  channelId       String                 @unique @map("channel_id") @db.Uuid
  status          AgentMailboxStatus     @default(active)
  statusReason    String?                @map("status_reason")
  retiredAt       DateTime?              @map("retired_at")
  sendPolicy      AgentMailboxSendPolicy @default(approval) @map("send_policy")
  displayName     String?                @map("display_name")
  createdByUserId String?                @map("created_by_user_id") @db.Uuid
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  organization  Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent         Agent               @relation(fields: [agentId], references: [id], onDelete: Cascade)
  domain        EmailDomain?        @relation(fields: [domainId], references: [id], onDelete: SetNull)
  // Restrict, not Cascade: the backing channel is created with the mailbox and
  // is not independently disposable — deleting it would take the whole
  // correspondence with it. Mailbox deletion removes the pair in order.
  channel       Channel             @relation(fields: [channelId], references: [id], onDelete: Restrict)
  conversations EmailConversation[]
  messages      EmailMessage[]

  @@index([organizationId, status])
  @@map("agent_mailboxes")
}

/// Custom sending domains verified in the deployment's own SES account (P2,
/// behind NESSIE_EMAIL_CUSTOM_DOMAINS). Stores the SES-returned DKIM tokens as
/// facts; the DNS records an operator pastes are rendered from them at read
/// time, never stored pre-rendered (rendered records go stale against SES).
model EmailDomain {
  id              String            @id @default(uuid()) @db.Uuid
  organizationId  String            @map("organization_id") @db.Uuid
  domain          String            @unique
  status          EmailDomainStatus @default(pending_dns)
  statusReason    String?           @map("status_reason")
  sesIdentityArn  String?           @map("ses_identity_arn")
  dkimTokens      Json              @default("[]") @map("dkim_tokens")
  verifiedAt      DateTime?         @map("verified_at")
  lastCheckedAt   DateTime?         @map("last_checked_at")
  createdByUserId String?           @map("created_by_user_id") @db.Uuid
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailboxes    AgentMailbox[]

  @@index([organizationId, status])
  @@map("email_domains")
}

/// One email thread. Deliberately carries NO unreadCount, NO muted and NO
/// needs_approval state: per-viewer read state would need the existing
/// ThreadReadState pattern (added only if a real need appears), and the
/// approval/bounce chips the mailbox list renders are DERIVED from the live
/// ApprovalRequest / EmailMessage rows rather than a second mutable copy.
model EmailConversation {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  mailboxId      String   @map("mailbox_id") @db.Uuid
  subject        String
  // Denormalized participant addresses for the list view.
  participants   Json     @default("[]")
  threadId       String   @unique @map("thread_id") @db.Uuid
  lastMessageAt  DateTime @map("last_message_at")
  messageCount   Int      @default(0) @map("message_count")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailbox      AgentMailbox   @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  thread       Thread         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  messages     EmailMessage[]

  @@index([mailboxId, lastMessageAt])
  @@map("email_conversations")
}

model EmailMessage {
  id                 String                     @id @default(uuid()) @db.Uuid
  organizationId     String                     @map("organization_id") @db.Uuid
  mailboxId          String                     @map("mailbox_id") @db.Uuid
  conversationId     String                     @map("conversation_id") @db.Uuid
  direction          EmailMessageDirection
  // Inbound idempotency key: the SES receipt / SNS message id. SNS and SES
  // legitimately retry, so the claim-and-wake transaction turns on THIS, never
  // on the RFC Message-ID (which can be absent, duplicated or attacker-forged).
  receiptId          String?                    @unique @map("receipt_id")
  // Outbound idempotency key: `{runId}:{toolCallId}`, the same identity the
  // approval machinery uses. A replayed run re-issues the same tool call, and
  // without this each replay inserted another queued row — two rows claim
  // independently and the recipient gets two copies, which cannot be undone.
  sendKey            String?                    @unique @map("send_key")
  // Raw MIME staging reference in the inbound bucket (transport staging only —
  // every durable byte goes through FileService).
  s3ObjectKey        String?                    @map("s3_object_key")
  rfcMessageId       String                     @map("rfc_message_id")
  inReplyTo          String?                    @map("in_reply_to")
  referencesIds      Json                       @default("[]") @map("references_ids")
  fromAddress        String                     @map("from_address")
  fromName           String?                    @map("from_name")
  replyToAddress     String?                    @map("reply_to_address")
  toAddresses        Json                       @default("[]") @map("to_addresses")
  ccAddresses        Json                       @default("[]") @map("cc_addresses")
  bccAddresses       Json                       @default("[]") @map("bcc_addresses")
  // Inbound routing truth: the SES receipt envelope recipients. MIME To/Cc are
  // attacker-controlled, omit Bcc destinations, and can name another tenant.
  envelopeRecipients Json                       @default("[]") @map("envelope_recipients")
  subject            String
  textBody           String                     @map("text_body")
  // Stored already sanitized at ingest (allowlist; remote images neutralized).
  htmlBody           String?                    @map("html_body")
  snippet            String
  // SPF/DKIM/DMARC/spam/virus verdicts from the SES receipt.
  authResults        Json?                      @map("auth_results")
  classification     EmailMessageClassification @default(normal)
  deliveryState      EmailDeliveryState?        @map("delivery_state")
  sesMessageId       String?                    @map("ses_message_id")
  // Projections of the authoritative run/approval rows, kept for list
  // rendering only.
  sentByRunId        String?                    @map("sent_by_run_id") @db.Uuid
  approvalId         String?                    @map("approval_id") @db.Uuid
  occurredAt         DateTime                   @map("occurred_at")
  createdAt          DateTime                   @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  mailbox      AgentMailbox      @relation(fields: [mailboxId], references: [id], onDelete: Cascade)
  conversation EmailConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, occurredAt])
  // Threading lookup (In-Reply-To / References resolution) — an index, never a
  // uniqueness claim: a forged or duplicated Message-ID must degrade to a new
  // conversation, not drop or mis-merge a message.
  @@index([mailboxId, rfcMessageId])
  @@index([mailboxId, deliveryState])
  @@map("email_messages")
}

/// Deployment-wide suppression list. Reputation is per SES account, so this is
/// deliberately org-agnostic: a recipient that hard-bounced or complained for
/// one organisation must not be re-mailed by another on the same account.
model EmailSuppression {
  id         String   @id @default(uuid()) @db.Uuid
  address    String   @unique
  reason     String
  detail     String?
  occurredAt DateTime @map("occurred_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("email_suppressions")
}

// ─── Calling the Personal Assistant with live voice ─────────────────────────
// The API brokers a one-use Gemini Live credential from Ledger; audio then
// flows directly between the client and Google. These rows are the durable
// state that survives the socket: what was minted, for whom, under which UOA
// identity, and what the call is allowed to spend.
// Spec: docs/plans/2026-09-02-gemini-voice-calling.md

enum VoiceInstallationPlatform {
  web
  ios
  android
}

enum VoiceSessionStatus {
  active
  ended
  failed
}

/// One browser or app that may place voice calls.
///
/// Server-minted on purpose: Ledger reserves daily budget per device slot, so
/// a client that could choose its own device identifier could multiply those
/// reservations. Per-user caps are enforced against these rows, and the
/// identifier Ledger sees is derived from `id` rather than anything a client
/// supplied.
model VoiceInstallation {
  id             String                    @id @default(uuid()) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  platform       VoiceInstallationPlatform
  label          String?
  revokedAt      DateTime?                 @map("revoked_at")
  lastSeenAt     DateTime                  @default(now()) @map("last_seen_at")
  createdAt      DateTime                  @default(now()) @map("created_at")

  organization Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  sessions     VoiceSession[]
  credentials  VoiceDeviceCredential[]

  @@index([organizationId])
  @@index([userId, revokedAt])
  @@map("voice_installations")
}

/// The credential the native layer holds during a call.
///
/// The Expo shell's rule is that the native app never sees an authenticated
/// Nessie session. A CallKit call outlives the WebView, so the native side
/// needs its own — narrowed to the voice routes, and backed by server state so
/// every request can recheck revocation exactly as an ordinary session does.
/// Only the token's digest is stored; `sessionId` binds it to the sign-in it
/// came from, so it cannot outlive that.
model VoiceDeviceCredential {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  installationId String    @map("installation_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash")
  sessionId      String    @map("session_id")
  /// The tenant scope the WebView held when it provisioned this device — cost
  /// attribution is scoped by project/team, so the phone must carry the same.
  projectId      String    @map("project_id") @db.Uuid
  teamId         String    @map("team_id") @db.Uuid
  tokenVersion   Int       @map("token_version")
  expiresAt      DateTime  @map("expires_at")
  lastUsedAt     DateTime? @map("last_used_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation VoiceInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)

  @@index([installationId])
  @@index([userId, sessionId])
  @@map("voice_device_credentials")
}

/// One call.
///
/// `id` is call-scoped and survives credential rotation: a 30-minute Gemini
/// credential is replaced in place (`ledgerSessionId` moves, `rotationCount`
/// increments) so one call keeps one usage stream and one transcript slot.
/// The UOA tuple is captured at mint and re-used to sign every later relay —
/// never re-read from ambient request context, which could have drifted to
/// another team mid-call.
model VoiceSession {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId         String @map("user_id") @db.Uuid
  installationId String @map("installation_id") @db.Uuid
  channelId      String @map("channel_id") @db.Uuid
  threadId       String @map("thread_id") @db.Uuid
  agentId        String @map("agent_id") @db.Uuid

  uoaSubject        String? @map("uoa_subject")
  uoaOrganizationId String? @map("uoa_organization_id")
  uoaTeamId         String? @map("uoa_team_id")
  uoaTokenVersion   Int?    @map("uoa_token_version")

  ledgerSessionId     String   @map("ledger_session_id")
  model               String
  credentialExpiresAt DateTime @map("credential_expires_at")
  rotationCount       Int      @default(0) @map("rotation_count")

  status        VoiceSessionStatus @default(active)
  maxDurationMs Int                @map("max_duration_ms")
  maxToolCalls  Int                @map("max_tool_calls")
  toolCallCount Int                @default(0) @map("tool_call_count")

  /// Highest usage sequence accepted by Ledger. Reports arrive in order and a
  /// replayed or stale sequence is refused rather than double-counted.
  lastUsageSequence Int     @default(0) @map("last_usage_sequence")
  /// False once the call ends without its final usage report landing — spend
  /// nobody can attribute, which must be visible rather than silently final.
  usageComplete     Boolean @default(false) @map("usage_complete")

  /// Set once, so a retried submission cannot write a second call record.
  transcriptMessageId String? @unique @map("transcript_message_id") @db.Uuid

  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  installation VoiceInstallation @relation(fields: [installationId], references: [id], onDelete: Cascade)
  toolCalls    VoiceToolCall[]

  @@index([organizationId, status])
  @@index([userId, startedAt])
  @@index([installationId, status])
  @@map("voice_sessions")
}

// ─── Personal model subscriptions ─────────────────────────────────────────
// A person links their own consumer AI subscription (Kimi, GLM, and later
// OpenAI Codex / xAI Grok) and the agents THEY own run on it. Token values
// never live here: they are held by the deployment's vault under a dedicated,
// separately-ACLed project, and these rows carry only the pointer plus the
// metadata the coordinator needs to serialize rotation.
// Spec: docs/plans/2026-09-02-personal-model-subscriptions.md

enum ModelSubscriptionProvider {
  kimi
  glm
  openai_codex @map("openai-codex")
  grok
}

enum ModelSubscriptionStatus {
  active
  needs_reauthorization
  disconnected
  error
}

/// Why a subscription is not healthy. Typed because the remedy differs:
/// `needs_reauthorization` is a button (relink), everything else is an edit or
/// a wait. Mirrors the trigger-health discipline — the transition owns the
/// alert, and the reason is persisted so a surface can explain without parsing
/// a message string.
enum ModelSubscriptionHealthReason {
  ok
  needs_reauthorization
  provider_rejected
  quota_exhausted
  owner_inactive
  vault_unavailable
}

/// Which purse paid for one inference. Structural, never inferred from an
/// absent pricing profile: connector invocations record the *runtime* provider
/// (`openai-compatible`), and an owner-authored wildcard ModelPricingProfile
/// would otherwise price a run the organization never paid for.
enum InferenceBillingSource {
  ledger
  personal_subscription
}

/// One person's link to one account at one subscription provider. Scoped to
/// the organization AND the user — never shared across a team. Several
/// accounts per provider are allowed (work + personal), which is why
/// `providerAccountId` is part of the natural key and why an agent points at a
/// subscription by id rather than by provider string.
model ModelSubscription {
  id                String                        @id @default(uuid()) @db.Uuid
  organizationId    String                        @map("organization_id") @db.Uuid
  userId            String                        @map("user_id") @db.Uuid
  provider          ModelSubscriptionProvider
  status            ModelSubscriptionStatus       @default(active)
  /// The provider's stable account identity (an OIDC subject, or a fingerprint
  /// of an API key for key-based adapters). Proves the same account came back
  /// on relink; an account mismatch is refused rather than silently re-pointed.
  providerAccountId String                        @map("provider_account_id")
  /// Human label for the account picker — an email or masked key suffix. Never
  /// a credential.
  accountLabel      String?                       @map("account_label")
  /// Monotonic credential generation. Every rotation bumps it; a failure
  /// transition is applied only when the FAILING epoch is still current, so a
  /// delayed 401 carrying a pre-relink token cannot kill a fresh link.
  credentialEpoch   Int                           @default(1) @map("credential_epoch")
  /// Set while one process holds the refresh claim. The claim is short and
  /// released before the provider call, so no transaction is held open across
  /// the network; a stale claim is reclaimable after the lease expires.
  refreshClaimedAt  DateTime?                     @map("refresh_claimed_at")
  healthReason      ModelSubscriptionHealthReason @default(ok) @map("health_reason")
  healthDetail      String?                       @map("health_detail")
  /// Bumped on every health transition so an alert fires exactly once per
  /// transition rather than once per failing run.
  healthRevision    Int                           @default(0) @map("health_revision")
  lastUsedAt        DateTime?                     @map("last_used_at")
  createdAt         DateTime                      @default(now()) @map("created_at")
  updatedAt         DateTime                      @updatedAt @map("updated_at")

  credential   ModelSubscriptionCredential?
  agents       Agent[]
  runs         Run[]
  organization Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Tenancy at the storage boundary, exactly as `Agent.ownerUserId` does it:
  /// the owner must be a member of THIS organization. It does not prove the
  /// membership is live — every read re-derives `deactivatedAt: null`.
  owner        OrganizationMember?          @relation("ModelSubscriptionOwner", fields: [organizationId, userId], references: [organizationId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@unique([organizationId, userId, provider, providerAccountId])
  @@index([organizationId, userId])
  @@index([status])
  @@map("model_subscriptions")
}

/// The vault pointer for a subscription. Deliberately holds NO ciphertext:
/// `docs/secret-management-spec.md` bars new secret-capture flows from putting
/// values in PostgreSQL, so the token bundle lives in the vault and this row
/// records where. `expiresAt` is an advisory copy for cheap "refresh soon"
/// queries — the vault bundle is the truth.
model ModelSubscriptionCredential {
  id              String    @id @default(uuid()) @db.Uuid
  subscriptionId  String    @unique @map("subscription_id") @db.Uuid
  vaultReference  String    @unique @map("vault_reference")
  vaultSecretName String    @map("vault_secret_name")
  expiresAt       DateTime? @map("expires_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  subscription ModelSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("model_subscription_credentials")
}

/// A vault secret whose PostgreSQL pointer is gone (disconnect, owner
/// deactivation, organization deletion) and which still has to be deleted from
/// the vault. Without this, a cascade would strand a live refresh token that
/// nothing can address any more. Swept idempotently; `deletedAt` closes it.
model ModelSubscriptionVaultTombstone {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  vaultSecretName String    @map("vault_secret_name")
  attempts        Int       @default(0)
  lastError       String?   @map("last_error")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([deletedAt, createdAt])
  @@map("model_subscription_vault_tombstones")
}

/// One-shot OAuth / device-code flow state. Flow state is not a durable secret
/// value — it is single-use and expires in minutes — so it follows the standing
/// `comms_oauth_states` / `mcp_oauth_states` pattern. `pollLeaseUntil` is what
/// stops several tabs or replicas from each polling the provider.
model ModelSubscriptionAuthState {
  token          String                    @id
  organizationId String                    @map("organization_id") @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  provider       ModelSubscriptionProvider
  payload        Json
  pollLeaseUntil DateTime?                 @map("poll_lease_until")
  nextPollAt     DateTime?                 @map("next_poll_at")
  expiresAt      DateTime                  @map("expires_at")
  consumedAt     DateTime?                 @map("consumed_at")
  createdAt      DateTime                  @default(now()) @map("created_at")

  @@index([organizationId, userId])
  @@index([expiresAt])
  @@map("model_subscription_auth_states")
}

/// Which account pays for, and can replay, the browsers opened through this
/// connection. Decided by the surface that accepted the key (owner-only org
/// settings vs a member's own connections page), never inferred from the key
/// itself — Browserbase authenticates by API key only and its keys carry no
/// personal-vs-company signal.
/// A setting resolved across three scopes: organisation, team, person.
///
/// Cascading resolution was already bespoke four times over here — budgets
/// resolve most-specific-first, policy rules run a seven-level chain
/// deny-first, `Team.callProvider` is a bare column with no organisation
/// default, and the cloud browser resolved organisation-first with the
/// ordering hardcoded. This is the one store behind all of it.
///
/// Resolution walks organisation → team → user and takes the most specific
/// value, stopping at the first level marked `locked`: a lock is how an
/// ancestor says "this is the answer for everyone below". The level that
/// locked it is carried out to the surface, so a control a person cannot
/// change is greyed with the reason rather than silently ignoring their edit.
///
/// Structurally the hierarchy is Organisation → Project → Team, and budgets
/// cascade through all three. Settings deliberately expose only the three
/// scopes people work in; adding a project tier later is a scope value and a
/// resolver step, not a redesign.
model ScopedSetting {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scope          SettingScope
  /// Exactly one of these is set, per scope: neither at organization scope,
  /// `teamId` at team scope, `userId` at user scope. A CHECK ties each to its
  /// scope, so a malformed write cannot produce a row the resolver would read
  /// at the wrong level.
  teamId         String?      @map("team_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid
  /// Dotted, e.g. `calls.provider`, `browser.connection`.
  key            String
  /// The value chosen at this level. NULL means the row expresses only a lock
  /// — "whatever resolves above here is what everyone below uses" — which is
  /// how a setting whose value lives in its own table (the cloud browser's
  /// credential rows) is still governed by one cascade.
  value          Json?
  /// Levels below this one may not override the resolved value.
  locked         Boolean      @default(false)

  updatedByUserId String   @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Teams carry no organization_id of their own (tenancy runs through their
  /// project), so this FK proves the team exists and the service re-checks
  /// that it belongs to this organization.
  team         Team?               @relation("ScopedSettingTeam", fields: [teamId], references: [id], onDelete: Cascade)
  /// Tenancy at the storage boundary, the `Agent.ownerMembership` precedent: a
  /// user-scoped row's owner must be a member of THIS organization. It does
  /// not prove the membership is live — readers re-derive that.
  owner        OrganizationMember? @relation("ScopedSettingOwner", fields: [organizationId, userId], references: [organizationId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, key])
  @@map("scoped_settings")
}

enum SettingScope {
  organization
  team
  user
}

enum CloudBrowserConnectionScope {
  organization
  team
  user
}

/// A capability that can stop working owns the way a person finds out: a
/// revoked key, deleted project or suspended account claims
/// `needs_attention` with a persisted reason and alerts once, instead of
/// retrying forever behind a toolset that still advertises a browser.
enum CloudBrowserConnectionStatus {
  active
  needs_attention
  disabled
}

/// A remote resource's lifecycle, not a boolean. A create that times out may
/// still have produced a paid session at Browserbase (`allocating` — the
/// reconciler's problem), and `active` may only clear once Browserbase has
/// confirmed termination, because two sessions on one context make websites
/// force logouts.
enum CloudBrowserSessionStatus {
  allocating
  active
  releasing
  released
  failed
  unknown
}

/// One Browserbase account bound to this team. Bring-your-own key at
/// both scopes: the organization subscription an owner connects, or a
/// member's own account (the free tier is the intended on-ramp) which powers
/// only runs that member requested.
model CloudBrowserConnection {
  id             String                      @id @default(uuid()) @db.Uuid
  organizationId String                      @map("organization_id") @db.Uuid
  scope          CloudBrowserConnectionScope
  /// Exactly one of these is set, per scope: neither at organization scope,
  /// `teamId` at team scope, `userId` at user scope. A CHECK ties each to its
  /// scope, and partial unique indexes keep one row per organization, one per
  /// team, and one per (organization, member).
  teamId         String?                     @map("team_id") @db.Uuid
  userId         String?                     @map("user_id") @db.Uuid
  projectId      String                      @map("project_id")
  /// Server-minted `secret_browserbase_*` ref into the encrypted secret
  /// store. Never caller-chosen, never returned to a client: the key plus a
  /// context id is session-equivalent material.
  apiKeyRef      String                      @map("api_key_ref")

  status          CloudBrowserConnectionStatus @default(active)
  /// Machine reason behind a non-active status (`auth_failed`,
  /// `unreachable`, `disabled_by_owner`), so the surface can name the remedy
  /// without parsing a message string.
  healthReason    String?                      @map("health_reason")
  healthDetail    String?                      @map("health_detail")
  /// Bumped by every health transition; the alert key is derived from it so
  /// one transition alerts exactly once.
  healthRevision  Int                          @default(0) @map("health_revision")
  healthCheckedAt DateTime?                    @map("health_checked_at")

  createdByUserId String   @map("created_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Tenancy at the storage boundary, the `Agent.ownerMembership` precedent:
  /// a user-scoped connection's owner must be a member of THIS organization.
  /// It does not prove the membership is live — readers re-derive that.
  owner        OrganizationMember? @relation("CloudBrowserConnectionOwner", fields: [organizationId, userId], references: [organizationId, userId], onDelete: NoAction, onUpdate: NoAction)
  /// Teams carry no organization_id of their own (tenancy runs through their
  /// project), so this FK proves the team exists and the service re-checks
  /// that it belongs to this organization.
  team         Team?               @relation("CloudBrowserConnectionTeam", fields: [teamId], references: [id], onDelete: Cascade)

  sessions      CloudBrowserSession[]
  agentBrowsers AgentBrowser[]

  @@unique([organizationId, id])
  @@index([organizationId, scope])
  @@map("cloud_browser_connections")
}

/// One Browserbase session opened for one run. Browser-hours are money, so
/// release is fused to every terminal writer and a reaper stops whatever a
/// crashed worker left running.
model CloudBrowserSession {
  id             String  @id @default(uuid()) @db.Uuid
  organizationId String  @map("organization_id") @db.Uuid
  /// Mandatory: the reaper cannot stop a remote session without knowing which
  /// API key owns it, and `/ops/usage` attributes hours by connection scope.
  connectionId   String  @map("connection_id") @db.Uuid
  runId          String  @map("run_id") @db.Uuid
  threadId       String  @map("thread_id") @db.Uuid
  agentId        String  @map("agent_id") @db.Uuid
  /// Null for an ephemeral session. Set when this session rides the agent's
  /// durable browser, which one live session at a time may do.
  agentBrowserId String? @map("agent_browser_id") @db.Uuid

  /// NULL while `allocating`: a create that timed out may still have produced
  /// a remote session, which reconciliation resolves.
  browserbaseSessionId String?                   @map("browserbase_session_id")
  status               CloudBrowserSessionStatus @default(allocating)

  /// Monotone within the session: set the moment the browser is known to
  /// carry a human's authenticated state (cookie-bearing context at open, a
  /// completed login handoff, or any control claim). Never clears — it is
  /// what makes the disclosure basis safe to evaluate per read.
  authenticated Boolean @default(false)

  /// The person whose ask started the run, when there is one. NULL for an
  /// unattended run, which may never use a personal connection.
  requestedByUserId String? @map("requested_by_user_id") @db.Uuid

  /// Control is one-winner coordination: claimed by conditional UPDATE, and
  /// while held every browser tool for this session is refused.
  controlledByUserId String?   @map("controlled_by_user_id") @db.Uuid
  controlClaimedAt   DateTime? @map("control_claimed_at")

  /// Hard TTL, mirrored into Browserbase's own session timeout so a dead
  /// worker cannot run a browser past it.
  expiresAt  DateTime  @map("expires_at")
  startedAt  DateTime  @default(now()) @map("started_at")
  endedAt    DateTime? @map("ended_at")
  /// `run_terminal` | `tool` | `reaper` | `expiry` | `control_release` —
  /// which writer released it, for diagnosing leaks.
  releasedBy String?   @map("released_by")
  lastError  String?   @map("last_error")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   CloudBrowserConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  run          Run                    @relation(fields: [runId], references: [id], onDelete: Cascade)
  thread       Thread                 @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agent        Agent                  @relation(fields: [agentId], references: [id], onDelete: Cascade)
  agentBrowser AgentBrowser?          @relation(fields: [agentBrowserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([threadId, status])
  @@index([connectionId, startedAt])
  @@map("cloud_browser_sessions")
}

/// A durable browser is either usable, or tombstoned and awaiting the queue
/// job that deletes its Browserbase context. There is no third state: an
/// external delete cannot join a database transaction, so the row is retired
/// locally first and reconciled remotely after.
enum AgentBrowserStatus {
  active
  tombstoned
}

/// One agent, one durable browser — its own machine. Created lazily on the
/// agent's first persistent `browser_open`.
///
/// Two agents never share browser state, which is what makes clashes
/// structurally impossible; the only contention left is one agent running in
/// two threads at once, which the single-live-session index refuses.
model AgentBrowser {
  id                   String @id @default(uuid()) @db.Uuid
  organizationId       String @map("organization_id") @db.Uuid
  agentId              String @map("agent_id") @db.Uuid
  /// Load-bearing: a Browserbase context belongs to the account that created
  /// it, so a browser is only usable through its own connection. When an
  /// organisation subscribes after personal connections were in use, the
  /// agent starts a fresh browser rather than migrating — one login per
  /// service again, which the UI says out loud.
  connectionId         String @map("connection_id") @db.Uuid
  /// The persistent Browserbase context holding cookies and localStorage.
  /// Retained on a tombstoned row so the delete job still has its target.
  browserbaseContextId String @map("browserbase_context_id")

  status       AgentBrowserStatus @default(active)
  createdAt    DateTime           @default(now()) @map("created_at")
  lastUsedAt   DateTime?          @map("last_used_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  /// Set when the row was tombstoned, so the reconciler can order its work
  /// and surface a context whose delete has been failing for too long.
  tombstonedAt DateTime?          @map("tombstoned_at")
  lastError    String?            @map("last_error")

  organization Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  /// Composite tenancy, the `Agent.ownerMembership` precedent: this browser's
  /// agent must belong to THIS organization, so one tenant's context can
  /// never ride another tenant's key.
  agent        Agent                  @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)
  connection   CloudBrowserConnection @relation(fields: [organizationId, connectionId], references: [organizationId, id], onDelete: NoAction, onUpdate: NoAction)

  logins   AgentBrowserLogin[]
  sessions CloudBrowserSession[]

  @@index([organizationId, agentId])
  @@index([connectionId])
  @@map("agent_browsers")
}

/// Who signed this browser into what.
///
/// Audit and revocation, not the disclosure trigger: a person can also sign
/// in during an ad-hoc control claim, so "is this browser authenticated" is a
/// monotone fact on the session, never derived from these rows alone.
model AgentBrowserLogin {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  agentBrowserId String   @map("agent_browser_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  /// Display metadata the person confirmed at handoff ("Google — a@b.c"),
  /// never parsed out of page content.
  serviceHint    String   @map("service_hint")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agentBrowser AgentBrowser       @relation(fields: [agentBrowserId], references: [id], onDelete: Cascade)
  member       OrganizationMember @relation("AgentBrowserLoginMember", fields: [organizationId, userId], references: [organizationId, userId], onDelete: NoAction, onUpdate: NoAction)

  @@index([agentBrowserId])
  @@index([organizationId, userId])
  @@map("agent_browser_logins")
}

/// SMTP/IMAP mailbox connections — agent email Model A, where the provider
/// holds the mail and Nessie holds only the credential and the audit trail.
/// Design: docs/plans/2026-09-02-agent-email.md §2.2.
///
/// Scope is "which of the two owner columns is set", enforced by a CHECK rather
/// than mirrored in an enum: a `scope` column beside the ids would be a second
/// statement of one fact, free to drift. A user-scope connection is one
/// person's own mailbox; a team-scope one is a shared mailbox an owner or admin
/// connected for a team.
///
/// IMAP is all-or-nothing — whoever holds the password reads everything and
/// sends as the mailbox — so there is deliberately no capability catalog here.
/// One connection is one honest `mailbox.full` grant, and which agents may use
/// it is decided per pair in `mailbox_connection_agent_access`.
model MailboxConnection {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  /// Exactly one of these is set; the CHECK constraint is the scope.
  ownerUserId     String?                  @map("owner_user_id") @db.Uuid
  teamId          String?                  @map("team_id") @db.Uuid
  label           String
  /// The mailbox's own address, lowercased. Also the SMTP envelope sender: an
  /// agent can only send AS the mailbox it was given, never as someone else.
  address         String
  imapHost        String                   @map("imap_host")
  imapPort        Int                      @map("imap_port")
  imapSecurity    MailboxTransportSecurity @default(tls) @map("imap_security")
  smtpHost        String                   @map("smtp_host")
  smtpPort        Int                      @map("smtp_port")
  smtpSecurity    MailboxTransportSecurity @default(starttls) @map("smtp_security")
  username        String
  status          MailboxConnectionStatus  @default(active)
  /// Why the status is what it is, in words a person can act on. A provider
  /// rejection names the remedy; it is never a silent retry-forever.
  statusReason    String?                  @map("status_reason")
  lastVerifiedAt  DateTime?                @map("last_verified_at")
  createdByUserId String?                  @map("created_by_user_id") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")

  organization    Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team            Team?                          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  /// Tenancy in the database, the `Agent.ownerMembership` pattern: the
  /// composite key proves the owner is a member of THIS organization. NoAction
  /// because SET NULL on a composite key blanks organizationId with it.
  ownerMembership OrganizationMember?            @relation("MailboxConnectionOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: NoAction, onUpdate: NoAction)
  credential      MailboxConnectionCredential?
  agentAccess     MailboxConnectionAgentAccess[]

  @@index([organizationId, status])
  @@index([organizationId, ownerUserId])
  @@index([teamId])
  @@map("mailbox_connections")
}

/// The password, isolated in its own table exactly as `CommsConnectionCredential`
/// is: every list, status and presenter read touches the connection row only, so
/// secret-bearing rows are never on a read path that renders to a browser.
model MailboxConnectionCredential {
  id               String   @id @default(uuid()) @db.Uuid
  connectionId     String   @unique @map("connection_id") @db.Uuid
  /// AES-256-GCM through the shared `sealSecret` packing. Never leaves the
  /// server, and is decrypted only at the one credential chokepoint.
  secretCiphertext String   @map("secret_ciphertext")
  keyVersion       Int      @default(1) @map("key_version")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  connection MailboxConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("mailbox_connection_credentials")
}

/// Which agent may use which mailbox.
///
/// `Agent.toolPolicy` is `Record<toolId, boolean>` and therefore cannot name a
/// resource: a bare grant on `mailbox_search` would silently widen to every
/// mailbox connected afterwards. Access is a per-pair row instead, so
/// connecting a second team mailbox grants nothing to anybody.
model MailboxConnectionAgentAccess {
  id              String   @id @default(uuid()) @db.Uuid
  organizationId  String   @map("organization_id") @db.Uuid
  connectionId    String   @map("connection_id") @db.Uuid
  agentId         String   @map("agent_id") @db.Uuid
  grantedByUserId String?  @map("granted_by_user_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  connection   MailboxConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  /// Composite so an access row cannot name an agent from another tenant.
  agent        Agent             @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Cascade)

  @@unique([connectionId, agentId])
  @@index([organizationId, agentId])
  @@map("mailbox_connection_agent_access")
}

/// One tool call inside a voice conversation.
///
/// Gemini retries a tool call it did not see answered, and a retry must not
/// run the work twice — so the provider's own call id is the claim, with the
/// argument hash beside it: a replay carrying different arguments is a
/// different action wearing the same id and is refused rather than served
/// from cache.
model VoiceToolCall {
  id             String   @id @default(uuid()) @db.Uuid
  voiceSessionId String   @map("voice_session_id") @db.Uuid
  /// The id Gemini assigned the call; unique per session.
  providerCallId String   @map("provider_call_id")
  toolName       String   @map("tool_name")
  argumentsHash  String   @map("arguments_hash")
  /// The response already returned, replayed verbatim to a retry.
  result         Json?
  createdAt      DateTime @default(now()) @map("created_at")

  session VoiceSession @relation(fields: [voiceSessionId], references: [id], onDelete: Cascade)

  @@unique([voiceSessionId, providerCallId])
  @@index([voiceSessionId])
  @@map("voice_tool_calls")
}
