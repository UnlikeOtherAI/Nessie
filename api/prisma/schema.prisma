  outputPreview     String?          @map("output_preview")
  success           Boolean?
  startedAt         DateTime         @map("started_at")
  endedAt           DateTime?        @map("ended_at")
  durationMs        Int?             @map("duration_ms")
  executorBindingId String?          @map("executor_binding_id") @db.Uuid
