  inferenceInvocationId String?                @unique @map("inference_invocation_id")
  organizationId        String                 @map("organization_id") @db.Uuid
  userId                String?                @map("user_id") @db.Uuid
  projectId             String?                @map("project_id") @db.Uuid
  teamId                String?                @map("team_id") @db.Uuid
  channelId             String?                @map("channel_id") @db.Uuid
  threadId              String?                @map("thread_id") @db.Uuid
  sessionId             String?                @map("session_id")
  taskId                String?                @map("task_id") @db.Uuid
  runId                 String?                @map("run_id") @db.Uuid
  agentId               String?                @map("agent_id") @db.Uuid
  actorId               String                 @map("actor_id")
  actorType             AuditActorType?        @map("actor_type")
  requestId             String                 @map("request_id")
  correlationId         String?                @map("correlation_id")
  provider              String
  model                 String
  providerId            String?                @map("provider_id") @db.Uuid
  modelId               String?                @map("model_id") @db.Uuid
  operationType         OperationType          @map("operation_type")
  inputTokens           Int?                   @map("input_tokens")
  outputTokens          Int?                   @map("output_tokens")
  cachedInputTokens     Int?                   @map("cached_input_tokens")
  cachedOutputTokens    Int?                   @map("cached_output_tokens")
  cacheReadTokens       Int?                   @map("cache_read_tokens")
  cacheWriteTokens      Int?                   @map("cache_write_tokens")
  totalTokens           Int?                   @map("total_tokens")
  providerCostAmount    Decimal?               @map("provider_cost_amount") @db.Decimal(20, 8)
  providerCostCurrency  String?                @map("provider_cost_currency")
  pricingProfileId      String?                @map("pricing_profile_id") @db.Uuid
  pricingSource         PricingSource?         @map("pricing_source")
  pricingCurrency       String?                @map("pricing_currency")
  pricingInputPerM      Decimal?               @map("pricing_input_per_m") @db.Decimal(20, 8)
  pricingOutputPerM     Decimal?               @map("pricing_output_per_m") @db.Decimal(20, 8)
  estimatedCostAmount   Decimal?               @map("estimated_cost_amount") @db.Decimal(20, 8)
  estimatedCostCurrency String?                @map("estimated_cost_currency")
  /// Which purse paid. `personal_subscription` events are excluded from
  /// pricing resolution and from every organization budget sum by THIS field,
