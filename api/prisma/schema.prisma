model ProductIntegrationRun {
  id                String                      @id @default(uuid()) @db.Uuid
  organizationId    String                      @map("organization_id") @db.Uuid
  teamId            String                      @map("team_id") @db.Uuid
  productSlug       String                      @map("product_slug")
  requestedByUserId String?                     @map("requested_by_user_id") @db.Uuid
  connectorId       String?                     @map("connector_id") @db.Uuid
  channelId         String?                     @map("channel_id") @db.Uuid
  threadId          String?                     @map("thread_id") @db.Uuid
  messageId         String?                     @map("message_id") @db.Uuid
  externalRunId     String?                     @map("external_run_id")
  status            ProductIntegrationRunStatus @default(queued)
  title             String?
  queryPreview      String                      @default("") @map("query_preview")
  input             Json                        @default("{}") @map("input_json")
  result            Json                        @default("{}") @map("result_json")
  sourceCount       Int?                        @map("source_count")
  knowledgePageId   String?                     @map("knowledge_page_id") @db.Uuid
  requestedAt       DateTime                    @default(now()) @map("requested_at")
  completedAt       DateTime?                   @map("completed_at")
  createdAt         DateTime                    @default(now()) @map("created_at")
  updatedAt         DateTime                    @updatedAt @map("updated_at")

  organization      Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team              Team                        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  product           IntegratedProduct           @relation(fields: [productSlug], references: [slug], onDelete: Cascade)
  requestedByUser   User?                       @relation(fields: [requestedByUserId], references: [id], onDelete: SetNull)
  connector         McpServerInstance?          @relation(fields: [connectorId], references: [id], onDelete: SetNull)
  channel           Channel?                    @relation(fields: [channelId], references: [id], onDelete: SetNull)
  thread            Thread?                     @relation(fields: [threadId], references: [id], onDelete: SetNull)
  message           Message?                    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  knowledgePage     KnowledgePage?              @relation(fields: [knowledgePageId], references: [id], onDelete: SetNull)

  @@index([organizationId, teamId, productSlug, requestedAt(sort: Desc)], map: "product_integration_runs_scope_requested_idx")
  @@index([organizationId, productSlug, status], map: "product_integration_runs_status_idx")
  @@index([connectorId, requestedAt(sort: Desc)], map: "product_integration_runs_connector_idx")
  @@index([messageId], map: "product_integration_runs_message_idx")
  @@index([knowledgePageId], map: "product_integration_runs_knowledge_page_idx")
  @@map("product_integration_runs")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           MemberRole   @default(member)
  // When set, the membership is deactivated: the user is denied access to this
  // organisation (enforced in authenticateRequest) but the row + audit history
  // are kept so an owner can reactivate. Reversible — no hard delete.
  deactivatedAt  DateTime?    @map("deactivated_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

