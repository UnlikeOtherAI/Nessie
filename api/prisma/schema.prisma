model WorkflowStateEntry {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String               @map("organization_id") @db.Uuid
  workflowInstallationId String               @map("workflow_installation_id") @db.Uuid
  workflowRunId          String?              @map("workflow_run_id") @db.Uuid
  workflowStepRunId      String?              @map("workflow_step_run_id") @db.Uuid
  key                    String               @map("state_key")
  value                  Json
  valueHash              String               @map("value_hash")
  version                Int                  @default(1)
  // W18: the writer of the current version. A repeat write from the same
  // (stepRun, attempt) with the same value hash is a no-op success, so a
  // crash after a successful write cannot wedge the retry on a stale
  // expectedVersion.
  writerAttempt          Int?                 @map("writer_attempt")
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")
  workflowInstallation   WorkflowInstallation @relation("WorkflowInstallationStateEntries", fields: [workflowInstallationId], references: [id], onDelete: Cascade)
  workflowRun            WorkflowRun?         @relation("WorkflowRunStateEntries", fields: [workflowRunId], references: [id], onDelete: SetNull)
  workflowStepRun        WorkflowStepRun?     @relation("WorkflowStepRunStateEntries", fields: [workflowStepRunId], references: [id], onDelete: SetNull)
  organization           Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([workflowInstallationId, key])
  @@index([organizationId, updatedAt(sort: Desc)])
  @@index([workflowInstallationId, updatedAt(sort: Desc)])
  @@map("workflow_state_entries")
}

model WorkflowRun {
  id                            String                         @id @default(uuid()) @db.Uuid
  installationId                String                         @map("installation_id") @db.Uuid
  organizationId                String                         @map("organization_id") @db.Uuid
  triggerId                     String?                        @map("trigger_id") @db.Uuid
  triggerDeliveryId             String?                        @map("trigger_delivery_id") @db.Uuid
  parentRunId                   String?                        @map("parent_run_id") @db.Uuid
  retriedFromWorkflowRunId      String?                        @map("retried_from_workflow_run_id") @db.Uuid
  retriedByActorType            String?                        @map("retried_by_actor_type")
  // W25: run origin — where the run was asked for. `originMessageId` is the
  // message that triggered the run (when invoked from a conversation) and
  // `replyRootMessageId` the reply-thread root a result should attach to.
  originChannelId               String?                        @map("origin_channel_id") @db.Uuid
  originThreadId                String?                        @map("origin_thread_id") @db.Uuid
  originMessageId               String?                        @map("origin_message_id") @db.Uuid
  replyRootMessageId            String?                        @map("reply_root_message_id") @db.Uuid
  retriedByActorId              String?                        @map("retried_by_actor_id")
  retriedAt                     DateTime?                      @map("retried_at")
  planId                        String?                        @map("plan_id") @db.Uuid
  planStepId                    String?                        @map("plan_step_id") @db.Uuid
  status                        WorkflowRunStatus              @default(pending)
  input                         Json                           @default("{}")
  graphSnapshot                 Json?                          @map("graph_snapshot")
  output                        Json?                          @default("{}")
  summary                       String?
  errorMessage                  String?                        @map("error_message")
  startedByActorType            String                         @map("started_by_actor_type")
  startedByActorId              String                         @map("started_by_actor_id")
  // W18: executor dispatch counter, so a retried step's state_put attempt is
  // distinguishable from the crashed one it repeats.
  attempt                       Int                            @default(1)
  startedAt                     DateTime?                      @map("started_at")
  finishedAt                    DateTime?                      @map("finished_at")
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  installation                  WorkflowInstallation           @relation(fields: [installationId], references: [id], onDelete: Cascade)
  trigger                       AgentTrigger?                  @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  triggerDelivery               AgentTriggerDelivery?          @relation(fields: [triggerDeliveryId], references: [id], onDelete: SetNull)
  parentRun                     Run?                           @relation("WorkflowParentRun", fields: [parentRunId], references: [id], onDelete: SetNull)
  retriedFromWorkflowRun        WorkflowRun?                   @relation("WorkflowRunRetry", fields: [retriedFromWorkflowRunId], references: [id], onDelete: SetNull)
  retries                       WorkflowRun[]                  @relation("WorkflowRunRetry")
  plan                          Plan?                          @relation(fields: [planId], references: [id], onDelete: SetNull)
  planStep                      PlanStep?                      @relation(fields: [planStepId], references: [id], onDelete: SetNull)
  originChannel                 Channel?                       @relation("WorkflowRunOriginChannel", fields: [originChannelId], references: [id], onDelete: SetNull)
  originThread                  Thread?                        @relation("WorkflowRunOriginThread", fields: [originThreadId], references: [id], onDelete: SetNull)
  originMessage                 Message?                       @relation("WorkflowRunOriginMessage", fields: [originMessageId], references: [id], onDelete: SetNull)
  replyRootMessage              Message?                       @relation("WorkflowRunReplyRootMessage", fields: [replyRootMessageId], references: [id], onDelete: SetNull)
  stepRuns                      WorkflowStepRun[]
  stateEntries                  WorkflowStateEntry[]           @relation("WorkflowRunStateEntries")
  executionEnvironmentInstances ExecutionEnvironmentInstance[]
  executionUsageEntries         ExecutionUsageLedger[]
  organization                  Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([installationId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([triggerId, createdAt(sort: Desc)])
  @@index([parentRunId, createdAt(sort: Desc)])
  @@index([retriedFromWorkflowRunId, createdAt(sort: Desc)])
  @@index([originChannelId, createdAt(sort: Desc)])
  @@map("workflow_runs")
}

