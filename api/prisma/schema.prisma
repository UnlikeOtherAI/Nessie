model Run {
  id                                  String                          @id @default(uuid()) @db.Uuid
  agentId                             String                          @map("agent_id") @db.Uuid
  threadId                            String                          @map("thread_id") @db.Uuid
  // Set only for a PA presence run. This makes its per-principal slot durable
  // across queue redelivery and pending-message drains.
  principalUserId                     String?                         @map("principal_user_id") @db.Uuid
  triggerId                           String?                         @map("trigger_id") @db.Uuid
  triggerDeliveryId                   String?                         @unique @map("trigger_delivery_id") @db.Uuid
  status                              RunStatus                       @default(pending)
  startedAt                           DateTime?                       @map("started_at")
  finishedAt                          DateTime?                       @map("finished_at")
  createdAt                           DateTime                        @default(now()) @map("created_at")
  // Cooperative-cancel signal. Set by POST /api/runs/:id/cancel; the agentic
  // loop polls it between iterations and between tool-call batches and exits via
  // the classified-stop machinery with reason `cancelled`. Also recorded on a
  // queued run so its (never-executed) job is skipped by the idempotency guard.
  cancelRequestedAt                   DateTime?                       @map("cancel_requested_at")
  // Who asked for the cancellation. The worker reads this to attribute the
  // terminal `run.cancelled` TaskEvent; the queued-cancel path records it in the
  // same statement that flips the run to `cancelled`.
  cancelRequestedByUserId             String?                         @map("cancel_requested_by_user_id") @db.Uuid
  // The user message that started this run. Populated by the chat orchestrator
  // and integration handoffs. Enables the cancel handoff-guard (reads the
  // message's `integrationLaunch` metadata) and restart (replays the same input).
  triggerMessageId                    String?                         @map("trigger_message_id") @db.Uuid
  // Set on a run created by POST /api/runs/:id/restart, pointing at the original
  // terminal run it re-runs.
  restartOfRunId                      String?                         @map("restart_of_run_id") @db.Uuid
  // Set on a run created by continue (user tap, natural-language resume, or the
  // worker's non-interactive auto-continue), pointing at the run whose
  // RunCheckpoint seeded it.
  continuationOfRunId                 String?                         @map("continuation_of_run_id") @db.Uuid
  // Pre-run reply-placement judgement (the orchestrator's model decision, or a
  // structural 'thread' for @mentions and PA DMs). Null ≡ historical default.
  // This is the *input* to placement resolution, not its outcome.
  replyPlacement                      RunReplyPlacement?              @map("reply_placement")
  // The *resolved* reply anchor, persisted by the worker right after
  // `resolveReplyRootMessageId` runs (so the structural carve-outs — DeepWater
  // handoff, external agents — are already applied). Plain uuid with no
  // relation, mirroring `Message.replyParticipantIds`: readers (the thinking
  // bootstrap endpoint) never re-derive placement.
  replyRootMessageId                  String?                         @map("reply_root_message_id") @db.Uuid
  // The inference lane, PINNED at run admission. A subscription-routed run
  // records which subscription and which credential generation admitted it, so
  // a relink mid-run cannot switch accounts underneath it and a continuation
  // whose binding is no longer valid fails closed instead of silently sliding
  // back to the organization's Ledger route.
  modelSubscriptionId                 String?                         @map("model_subscription_id") @db.Uuid
  modelSubscriptionEpoch              Int?                            @map("model_subscription_epoch")
  modelSubscription                   ModelSubscription?              @relation(fields: [modelSubscriptionId], references: [id], onDelete: SetNull)
  agent                               Agent                           @relation(fields: [agentId], references: [id], onDelete: Cascade)
  thread                              Thread                          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  trigger                             AgentTrigger?                   @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  triggerDelivery                     AgentTriggerDelivery?           @relation("RunTriggerDelivery", fields: [triggerDeliveryId], references: [id], onDelete: SetNull)
  cancelRequestedBy                   User?                           @relation("RunCancelledBy", fields: [cancelRequestedByUserId], references: [id], onDelete: SetNull)
  triggerMessage                      Message?                        @relation("RunTriggerMessage", fields: [triggerMessageId], references: [id], onDelete: SetNull)
  restartOfRun                        Run?                            @relation("RunRestart", fields: [restartOfRunId], references: [id], onDelete: SetNull)
  restarts                            Run[]                           @relation("RunRestart")
  continuationOfRun                   Run?                            @relation("RunContinuation", fields: [continuationOfRunId], references: [id], onDelete: SetNull)
  continuations                       Run[]                           @relation("RunContinuation")
  checkpoint                          RunCheckpoint?
  tasks                               Task[]
  toolCalls                           ToolCall[]
  plans                               Plan[]
  approvalRequests                    ApprovalRequest[]
  resourceLocks                       ResourceLock[]
  workflowRuns                        WorkflowRun[]                   @relation("WorkflowParentRun")
  workflowStepRuns                    WorkflowStepRun[]               @relation("WorkflowAgentRun")
  executionEnvironmentInstances       ExecutionEnvironmentInstance[]
  executorAvailabilityCandidates      ExecutorAvailabilityCandidate[]
  thinkingChunks                      RunThinkingChunk[]
  documentSessions                    RunDocumentSession[]
  basisScopes                         RunBasisScope[]
  executorSessions                    ExecutorSession[]
  executorBindings                    ExecutorBinding[]
  proposedAgentTodoTemplates          AgentTodoTemplate[]             @relation("AgentTodoTemplateProposedByRun")
  activeAgentTodos                    AgentTodo[]                     @relation("AgentTodoActiveRun")
  demonstrationSteps                  DemonstrationStep[]
  originAppConnectionRequests         AgentAppConnectionRequest[]     @relation("AgentAppConnectionRequestOriginRun")
  continuationForAppConnectionRequest AgentAppConnectionRequest?      @relation("AgentAppConnectionRequestContinuationRun")
  originAgentHandoffRequests          AgentHandoffRequest[]

  postedAgentCards     AgentCard[] @relation("AgentCardPostingRun")
  waitingAgentCard     AgentCard?  @relation("AgentCardWaitRun")
  resumedFromAgentCard AgentCard?  @relation("AgentCardResumedByRun")

  cloudBrowserSessions CloudBrowserSession[]

  @@index([agentId, status])
  @@index([threadId, createdAt])
  @@index([triggerId, createdAt])
  @@index([restartOfRunId])
  @@index([continuationOfRunId])
  @@map("runs")
}

/// Durable state for a user-approved app connection proposed by an agent in a
/// conversation. The corresponding assistant message stores only this row's
/// opaque id; it never becomes mutable connection authority.
/// Terminal states of an agent-posted chat card. Every transition is claimed by
/// one conditional UPDATE whose WHERE carries `status = 'open'`, so two presses
/// — or a press racing the expiry sweep — have exactly one winner.
enum AgentCardStatus {
  open
  resolved
  expired
  cancelled
}

/// An interactive card an agent posted into a conversation: a ticket summary,
/// an email overview, an image with a caption, a small form. This row is the
/// authority — the assistant message carries only this id, and never becomes
/// mutable card state (the same discipline `AgentAppConnectionRequest` follows).
///
/// Design: docs/plans/2026-09-01-agent-chat-cards.md
model AgentCard {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  channelId         String          @map("channel_id") @db.Uuid
  threadId          String          @map("thread_id") @db.Uuid
  messageId         String          @unique @map("message_id") @db.Uuid
  agentId           String          @map("agent_id") @db.Uuid
  runId             String          @map("run_id") @db.Uuid
  /// Set only when the posting run suspended on this card (`wait: true`), so
  /// the press knows which run to resume. Unique: one run waits on one card.
  waitRunId         String?         @unique @map("wait_run_id") @db.Uuid
  /// Enqueue-time actor context for the continuation, exactly as
  /// `ApprovalRequest.resumeState`. Server-only; never presented to a client.
  resumeState       Json?           @map("resume_state")
  /// The validated `AgentCardSpec`. Immutable after insert — a changed ticket
  /// is a new card, never an edit, so what a person pressed cannot be rewritten
  /// underneath their decision.
  spec              Json
  /// Empty = anyone who can read the card message may press. Otherwise exactly
  /// these people, resolved at post time from the agent's `respondents` choice.
  respondentUserIds String[]        @map("respondent_user_ids") @db.Uuid
  status            AgentCardStatus @default(open)
  expiresAt         DateTime?       @map("expires_at")
  resolvedAt        DateTime?       @map("resolved_at")
  resolvedByUserId  String?         @map("resolved_by_user_id") @db.Uuid
  resolvedActionKey String?         @map("resolved_action_key")
  /// Submitted input values only. A secret's value is never here, and never
  /// anywhere else — see `secretOutcomes`.
  resolutionValues  Json?           @map("resolution_values")
  responseMessageId String?         @unique @map("response_message_id") @db.Uuid
  /// `{ [fieldKey]: { kind, instanceId, placement } }` — the fact that a secret
  /// was stored and where it landed. Never a reference, never a value.
  secretOutcomes    Json?           @map("secret_outcomes")
  /// `{ agentBrowserId, service, sessionId? }` for a browser sign-in handoff.
  /// The press writes the `AgentBrowserLogin` row from this and releases the
  /// human-only session, so a person who signs in and presses Done is
  /// recorded even if the resumed run then fails.
  browserLogin      Json?           @map("browser_login")
  resumedByRunId    String?         @unique @map("resumed_by_run_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")

  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  thread          Thread       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message         Message      @relation("AgentCardMessage", fields: [messageId], references: [id], onDelete: Cascade)
  responseMessage Message?     @relation("AgentCardResponseMessage", fields: [responseMessageId], references: [id], onDelete: SetNull)
  agent           Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  run             Run          @relation("AgentCardPostingRun", fields: [runId], references: [id], onDelete: Cascade)
  waitRun         Run?         @relation("AgentCardWaitRun", fields: [waitRunId], references: [id], onDelete: SetNull)
  resumedByRun    Run?         @relation("AgentCardResumedByRun", fields: [resumedByRunId], references: [id], onDelete: SetNull)
  resolvedBy      User?        @relation("AgentCardResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, status, expiresAt])
  @@index([threadId, status])
  @@index([agentId, status])
  @@map("agent_cards")
}

model AgentAppConnectionRequest {
  id                        String                          @id @default(uuid()) @db.Uuid
  organizationId            String                          @map("organization_id") @db.Uuid
  threadId                  String                          @map("thread_id") @db.Uuid
  messageId                 String                          @unique @map("message_id") @db.Uuid
  originRunId               String                          @map("origin_run_id") @db.Uuid
  originTriggerMessageId    String?                         @map("origin_trigger_message_id") @db.Uuid
  agentId                   String                          @map("agent_id") @db.Uuid
  requestedByUserId         String                          @map("requested_by_user_id") @db.Uuid
  candidateCatalogEntryIds  String[]                        @map("candidate_catalog_entry_ids") @db.Uuid
  selectedCatalogEntryId    String?                         @map("selected_catalog_entry_id") @db.Uuid
  connectionBackend         AgentAppConnectionBackend?      @map("connection_backend")
  mcpInstanceId             String?                         @map("mcp_instance_id") @db.Uuid
  commsConnectionId         String?                         @map("comms_connection_id") @db.Uuid
  scopeType                 McpServerScopeType?             @map("scope_type")
  scopeId                   String?                         @map("scope_id") @db.Uuid
  status                    AgentAppConnectionRequestStatus @default(offered)
  // Server-derived ids, trust label, known capability keys, target agent and
  // scope only. URLs and credentials never enter this immutable consent record.
  consentSnapshot           Json                            @map("consent_snapshot")
  failureCode               String?                         @map("failure_code")
  // A lookup aid only: the final status-transition transaction remains the
  // one-shot guard because PostgreSQL allows multiple NULLs in this key.
  continuationRunId         String?                         @unique @map("continuation_run_id") @db.Uuid
  offerCooldownUntil        DateTime                        @map("offer_cooldown_until")
  connectAttemptRevision    Int                             @default(0) @map("connect_attempt_revision")
  returnedAt                DateTime?                       @map("returned_at")
  returnRevision            Int                             @default(0) @map("return_revision")
  returnClaimedBySessionId  String?                         @map("return_claimed_by_session_id")
  returnClaimLeaseExpiresAt DateTime?                       @map("return_claim_lease_expires_at")
  expiresAt                 DateTime                        @map("expires_at")
  createdAt                 DateTime                        @default(now()) @map("created_at")
  updatedAt                 DateTime                        @updatedAt @map("updated_at")
  completedAt               DateTime?                       @map("completed_at")

  organization         Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  thread               Thread             @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message              Message            @relation("AgentAppConnectionRequestCardMessage", fields: [messageId], references: [id], onDelete: Cascade)
  originRun            Run                @relation("AgentAppConnectionRequestOriginRun", fields: [originRunId], references: [id], onDelete: Cascade)
  originTriggerMessage Message?           @relation("AgentAppConnectionRequestOriginTriggerMessage", fields: [originTriggerMessageId], references: [id], onDelete: SetNull)
  agent                Agent              @relation(fields: [agentId], references: [id], onDelete: Cascade)
  requestedByUser      User               @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  selectedCatalogEntry McpCatalogEntry?   @relation(fields: [selectedCatalogEntryId], references: [id], onDelete: SetNull)
  mcpInstance          McpServerInstance? @relation(fields: [mcpInstanceId], references: [id], onDelete: SetNull)
  commsConnection      CommsConnection?   @relation(fields: [commsConnectionId], references: [id], onDelete: SetNull)
  continuationRun      Run?               @relation("AgentAppConnectionRequestContinuationRun", fields: [continuationRunId], references: [id], onDelete: SetNull)

  @@index([requestedByUserId, agentId, threadId, createdAt(sort: Desc)], map: "app_conn_req_requester_agent_thread_created_idx")
  @@index([organizationId, status, expiresAt], map: "app_conn_req_organization_status_expires_idx")
  @@index([requestedByUserId, returnedAt], map: "app_conn_req_requester_returned_idx")
  @@map("agent_app_connection_requests")
}

/// One live handoff of a conversation to a global agent, per person per target.
///
/// The row is the loop bound `agent_handoff` needs: a repeated ask, a queue
/// retry, or a continuation run (new `runId`, same request) finds this row
/// inside its cooldown and converges on the briefing already waiting in the
/// person's DM instead of stacking a second one. Queue idempotency
/// (`handoff:{originRunId}:{slug}`) sits underneath it as the crash guard.
///
/// The convergence lookup is serialized by a `pg_advisory_xact_lock` on
/// `(requestedByUserId, targetSlug)` — the `AgentAppConnectionRequest`
/// precedent — so no unique constraint is needed and history is retained.
model AgentHandoffRequest {
  id                   String    @id @default(uuid()) @db.Uuid
  organizationId       String    @map("organization_id") @db.Uuid
  requestedByUserId    String    @map("requested_by_user_id") @db.Uuid
  /// The global-agent blueprint slug. Half of the convergence key.
  targetSlug           String    @map("target_slug")
  targetAgentId        String    @map("target_agent_id") @db.Uuid
  fromAgentId          String    @map("from_agent_id") @db.Uuid
  originRunId          String    @map("origin_run_id") @db.Uuid
  destinationChannelId String    @map("destination_channel_id") @db.Uuid
  destinationThreadId  String    @map("destination_thread_id") @db.Uuid
  /// The hidden server-authored `system` brief that started the target's run.
  briefMessageId       String    @unique @map("brief_message_id") @db.Uuid
  /// Repeat asks inside this window converge instead of briefing again.
  cooldownUntil        DateTime  @map("cooldown_until")
  /// After this the row is no longer the live handoff for the pair.
  expiresAt            DateTime  @map("expires_at")
  supersededAt         DateTime? @map("superseded_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  requestedByUser    User         @relation(fields: [requestedByUserId], references: [id], onDelete: Cascade)
  targetAgent        Agent        @relation("AgentHandoffTargetAgent", fields: [targetAgentId], references: [id], onDelete: Cascade)
  fromAgent          Agent        @relation("AgentHandoffFromAgent", fields: [fromAgentId], references: [id], onDelete: Cascade)
  originRun          Run          @relation(fields: [originRunId], references: [id], onDelete: Cascade)
  destinationChannel Channel      @relation(fields: [destinationChannelId], references: [id], onDelete: Cascade)
  destinationThread  Thread       @relation(fields: [destinationThreadId], references: [id], onDelete: Cascade)
  briefMessage       Message      @relation("AgentHandoffBriefMessage", fields: [briefMessageId], references: [id], onDelete: Cascade)

  @@index([requestedByUserId, targetSlug, createdAt(sort: Desc)], map: "agent_handoff_requester_target_created_idx")
  @@index([organizationId, expiresAt], map: "agent_handoff_organization_expires_idx")
  @@map("agent_handoff_requests")
}

// Durable work-state saved when a run stops at a policy ceiling (explicit run
// limit, backstop, org-budget block). `note` is model-written UNTRUSTED
// narrative — injected into follow-up runs as clearly-labeled notes, never as
// instructions, and never carrying approval/side-effect state. `sources` is
// the typed verbatim source list. A follow-up run in the same (thread, root)
// claims the checkpoint via the race-safe conditional update on
// `consumedByRunId` (set-once); see
// docs/plans/2026-08-05-run-budgets-context-and-research-routing.md §5.
model RunCheckpoint {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  runId           String       @unique @map("run_id") @db.Uuid
  taskId          String?      @map("task_id") @db.Uuid
  agentId         String       @map("agent_id") @db.Uuid
  threadId        String       @map("thread_id") @db.Uuid
  rootMessageId   String?      @map("root_message_id") @db.Uuid
  // 1-based continuation depth along the continuationOfRunId chain; the
  // worker's non-interactive auto-continue stops after
  // NESSIE_RUN_AUTO_CONTINUATIONS generations.
  generation      Int          @default(1)
  // The RunStopReason that produced this checkpoint (string, not enum, so the
  // worker's classification can evolve without migrations).
  reason          String
  note            String
  sources         Json?
  consumedByRunId String?      @map("consumed_by_run_id") @db.Uuid
  consumedAt      DateTime?    @map("consumed_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  run             Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([threadId, rootMessageId, createdAt])
  @@map("run_checkpoints")
}

// Durable thought log for a run — the retrievable record behind the live
// "thinking" bubble. The SSE stream is lossy (live-only, never replayed from
// backlog), so the recorder writes one row per coalesced flush and publishes
// the same chunk with its id, letting a client merge fetched history with live
// events without duplication. Per-run order is `id` order: exactly one worker
// writes a run at a time (the queue renews its lock for the job's lifetime).
/// One live document composition (`kb_document_compose`). Identity is the
/// provider tool-call id plus the inference invocation that produced it — the
/// tool-call *index* restarts at 0 for every HTTP attempt and cannot correlate
/// a retried or re-issued call with the handler that later executes it.
model RunDocumentSession {
  id             String @id @default(uuid()) @db.Uuid
  runId          String @map("run_id") @db.Uuid
  threadId       String @map("thread_id") @db.Uuid
  agentId        String @map("agent_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  invocationId   String @map("invocation_id")
  toolCallId     String @map("tool_call_id")

  status      RunDocumentSessionStatus @default(streaming)
  errorReason String?                  @map("error_reason")

  // Target parsed from the model's arguments.
  title        String?
  spaceId      String? @map("space_id") @db.Uuid
  parentPageId String? @map("parent_page_id") @db.Uuid

  // Target chosen by the user from the popup's address bar. Wins over the
  // model's arguments at save time.
  overrideSpaceId      String? @map("override_space_id") @db.Uuid
  overrideParentPageId String? @map("override_parent_page_id") @db.Uuid

  // Set once the document is saved as a .md file node.
  pageId        String? @map("page_id") @db.Uuid
  attachmentId  String? @map("attachment_id") @db.Uuid
  versionNumber Int?    @map("version_number")
  published     Boolean @default(false)

  chars      Int       @default(0)
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  finishedAt DateTime? @map("finished_at")

  run    Run                @relation(fields: [runId], references: [id], onDelete: Cascade)
  chunks RunDocumentChunk[]

  @@unique([runId, invocationId, toolCallId], map: "run_document_sessions_identity_key")
  @@index([threadId, createdAt])
  @@index([runId])
  @@map("run_document_sessions")
}

/// Durable lane for a composing document: coalesced markdown appended as it
/// streams, so a reconnecting or late-joining client can bootstrap. Working
/// data — pruned once the session has been terminal for a week.
model RunDocumentChunk {
  id        BigInt   @id @default(autoincrement())
  sessionId String   @map("session_id") @db.Uuid
  /// Offset of this chunk within the decoded markdown, in UTF-16 code units.
  offset    Int
  content   String
  createdAt DateTime @default(now()) @map("created_at")

  session RunDocumentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, id])
  @@map("run_document_chunks")
}

model RunThinkingChunk {
  id        BigInt               @id @default(autoincrement())
  runId     String               @map("run_id") @db.Uuid
  kind      RunThinkingChunkKind
  content   String
  createdAt DateTime             @default(now()) @map("created_at")
  run       Run                  @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId, id])
  @@map("run_thinking_chunks")
}

// Per-(agent, thread) run serialization: a message that arrives while a run is
// in flight for the same agent+thread is recorded here instead of spawning a
// concurrent run. When the in-flight run reaches a terminal state, the worker
// drains all pending rows into ONE batched follow-up run (seq order preserved).
// The row is the durable no-lost-messages marker: if the worker crashes before
// draining, the pending-batch sweep re-discovers it and enqueues the follow-up.
// Note the batched follow-up sees pended `user`/`assistant` messages as ordinary
// thread history, but `system`-role kickoffs (PA scheduled triggers) are
// excluded from model context — repeated system kickoffs coalesce to the
// latest, which is intended (each is a self-contained "check for work" nudge).
model RunThreadPendingMessage {
  // BIGSERIAL primary key doubles as the strict arrival ordering for batching.
  seq               BigInt                @id @default(autoincrement())
  agentId           String                @map("agent_id") @db.Uuid
  threadId          String                @map("thread_id") @db.Uuid
  principalUserId   String?               @map("principal_user_id") @db.Uuid
  messageId         String                @map("message_id") @db.Uuid
  channelId         String                @map("channel_id") @db.Uuid
  // Mirrors RunExecuteJobPayload.interactive at record time: a live human chat
  // turn stays budget-exempt when the batched follow-up run executes it.
  interactive       Boolean               @default(false)
  // The base AuthorizedActionContext of the triggering message (before the
  // run/task ids are injected); the drain re-injects fresh ids for the
  // follow-up run it creates.
  actorContext      Json                  @map("actor_context") @db.JsonB
  // Trigger provenance of a pended trigger fire (null for chat/mailbox
  // pends). When the LATEST pending row carries it, the drain copies it onto
  // the batched follow-up run so trigger delivery dedupe and audit keep their
  // run linkage.
  triggerId         String?               @map("trigger_id") @db.Uuid
  triggerDeliveryId String?               @map("trigger_delivery_id") @db.Uuid
  // A scheduled to-do is materialized only by the run that adopts this
  // pending marker. Keeping the template provenance here lets a batched drain
  // coalesce repeated fires into one instance without minting orphaned work.
  todoTemplateId    String?               @map("todo_template_id") @db.Uuid
  createdAt         DateTime              @default(now()) @map("created_at")
  agent             Agent                 @relation(fields: [agentId], references: [id], onDelete: Cascade)
  thread            Thread                @relation(fields: [threadId], references: [id], onDelete: Cascade)
  message           Message               @relation(fields: [messageId], references: [id], onDelete: Cascade)
  trigger           AgentTrigger?         @relation(fields: [triggerId], references: [id], onDelete: SetNull)
  triggerDelivery   AgentTriggerDelivery? @relation(fields: [triggerDeliveryId], references: [id], onDelete: SetNull)

  @@index([agentId, messageId, principalUserId])
  @@index([todoTemplateId])
  @@index([threadId, seq])
  @@map("run_thread_pending_messages")
}

model AgentTrigger {
  id                       String                    @id @default(uuid()) @db.Uuid
  agentId                  String?                   @map("agent_id") @db.Uuid
  workflowInstallationId   String?                   @map("workflow_installation_id") @db.Uuid
  type                     AgentTriggerType
  status                   AgentTriggerStatus        @default(active)
  enabled                  Boolean                   @default(true)
  name                     String?
  description              String?
  config                   Json                      @default("{}")
  targetChannelId          String?                   @map("target_channel_id") @db.Uuid
  targetThreadId           String?                   @map("target_thread_id") @db.Uuid
  schedulerClaimId         String?                   @map("scheduler_claim_id") @db.Uuid
  schedulerClaimedAt       DateTime?                 @map("scheduler_claimed_at")
  // Inbound webhook HMAC signing secret (sp-webhook). When set, the webhook
  // intake endpoint requires a valid X-Nessie-Signature instead of bearer key.
  signingSecret            String?                   @map("signing_secret")
  // Why this trigger is not runnable, as a stable code plus the sentence shown
  // to a person. Before this, the only record of a fatal fire lived in the
  // newest delivery row's `error_message`, so the Triggers page could say a
  // schedule was in ERROR but never why, and nothing else could read the reason
  // to decide whether it was recoverable.
  healthReason             String?                   @map("health_reason")
  healthDetail             String?                   @map("health_detail")
  // Bumped on every transition INTO a non-runnable state. It is the identity of
  // "this failure", which is what makes alerting exactly-once per transition:
  // the alert's `UserAlert.eventKey` embeds it, and that table already carries
  // `@@unique([userId, eventKey])`. A stuck state therefore never re-notifies,
  // while a genuine repeat failure after a repair does.
  healthRevision           Int                       @default(0) @map("health_revision")
  lastFiredAt              DateTime?                 @map("last_fired_at")
  nextRunAt                DateTime?                 @map("next_run_at")
  createdAt                DateTime                  @default(now()) @map("created_at")
  updatedAt                DateTime                  @updatedAt @map("updated_at")
  agent                    Agent?                    @relation(fields: [agentId], references: [id], onDelete: Cascade)
  workflowInstallation     WorkflowInstallation?     @relation(fields: [workflowInstallationId], references: [id], onDelete: Cascade)
  targetChannel            Channel?                  @relation("TriggerTargetChannel", fields: [targetChannelId], references: [id], onDelete: SetNull)
  targetThread             Thread?                   @relation("TriggerTargetThread", fields: [targetThreadId], references: [id], onDelete: SetNull)
  deliveries               AgentTriggerDelivery[]
  runs                     Run[]
  workflowRuns             WorkflowRun[]
  runThreadPendingMessages RunThreadPendingMessage[]
  healthAlerts             UserAlert[]               @relation("TriggerHealthAlert")
  agentTodos               AgentTodo[]

  @@index([agentId, createdAt])
  @@index([agentId, enabled, status])
  @@index([workflowInstallationId, createdAt])
  @@index([workflowInstallationId, enabled, status])
  @@index([targetChannelId])
  @@index([targetThreadId])
  // The 4-col (type, enabled, status, nextRunAt) index was dropped in
  // 20260530170400_trigger_index_prune — it is a strict prefix of the 5-col
  // index below, which already serves every query the shorter one could.
  @@index([type, enabled, status, nextRunAt, schedulerClaimedAt])
  @@map("agent_triggers")
}

model AgentTriggerDelivery {
  id                       String                     @id @default(uuid()) @db.Uuid
  triggerId                String                     @map("trigger_id") @db.Uuid
  dedupeKey                String?                    @map("dedupe_key")
  status                   AgentTriggerDeliveryStatus @default(pending)
  source                   String?
  payload                  Json                       @default("{}")
  errorMessage             String?                    @map("error_message")
  deliveredAt              DateTime?                  @map("delivered_at")
  // Delivery retry/backoff (sp-webhook). A `failed` delivery with
  // retryCount < max and nextRetryAt <= now is retryable by the worker poller.
  retryCount               Int                        @default(0) @map("retry_count")
  nextRetryAt              DateTime?                  @map("next_retry_at")
  createdAt                DateTime                   @default(now()) @map("created_at")
  trigger                  AgentTrigger               @relation(fields: [triggerId], references: [id], onDelete: Cascade)
  run                      Run?                       @relation("RunTriggerDelivery")
  workflowRuns             WorkflowRun[]
  runThreadPendingMessages RunThreadPendingMessage[]

  @@unique([triggerId, dedupeKey])
  @@index([triggerId, createdAt])
  @@index([status, createdAt])
  // Retry poller scan: find failed deliveries due for re-attempt (sp-webhook).
  @@index([status, nextRetryAt])
  @@map("agent_trigger_deliveries")
}

model Plan {
  id                 String         @id @default(uuid()) @db.Uuid
  organizationId     String         @map("organization_id") @db.Uuid
  projectId          String?        @map("project_id") @db.Uuid
  teamId             String?        @map("team_id") @db.Uuid
  channelId          String?        @map("channel_id") @db.Uuid
  runId              String?        @map("run_id") @db.Uuid
  agentId            String?        @map("agent_id") @db.Uuid
  goal               String
  summary            String?
  status             PlanStatus     @default(draft)
  createdByActorType String         @map("created_by_actor_type")
  createdByActorId   String         @map("created_by_actor_id")
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project?       @relation(fields: [projectId], references: [id], onDelete: SetNull)
  team               Team?          @relation(fields: [teamId], references: [id], onDelete: SetNull)
  channel            Channel?       @relation(fields: [channelId], references: [id], onDelete: SetNull)
  run                Run?           @relation(fields: [runId], references: [id], onDelete: SetNull)
  agent              Agent?         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  workflowRuns       WorkflowRun[]
  resourceLocks      ResourceLock[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Desc)])
  @@index([agentId, status])
  @@map("plans")
}

model AgentTodoTemplate {
  id              String                  @id @default(uuid()) @db.Uuid
  organizationId  String                  @map("organization_id") @db.Uuid
  agentId         String                  @map("agent_id") @db.Uuid
  name            String
  description     String?
  steps           Json
  version         Int                     @default(1)
  status          AgentTodoTemplateStatus @default(draft)
  authorType      AgentTodoActorType      @map("author_type")
