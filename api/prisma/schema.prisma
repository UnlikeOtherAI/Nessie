model McpCatalogEntry {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String?              @map("organization_id") @db.Uuid
  name                   String
  label                  String
  description            String
  protocol               McpCatalogProtocol
  authMethod             McpCatalogAuthMethod @map("auth_method")
  authConfig             Json                 @default("{}") @map("auth_config")
  defaultTransportConfig Json                 @default("{}") @map("default_transport_config")
  iconUrl                String?              @map("icon_url")
  vendor                 String?
  sourceUrl              String?              @map("source_url")
  signature              String?
  status                 McpCatalogStatus     @default(draft)
  visibility             McpCatalogVisibility @default(private)
  // Admin lock: members cannot install (or re-register the same endpoint as)
  // a locked connector; owners/admins are exempt. Purely an install-time
  // gate — already-installed instances keep working until removed.
  locked                 Boolean              @default(false)
  lockedAt               DateTime?            @map("locked_at")
  lockedBy               String?              @map("locked_by") @db.Uuid
  ownerUserId            String?              @map("owner_user_id") @db.Uuid
  submittedAt            DateTime?            @map("submitted_at")
  reviewedAt             DateTime?            @map("reviewed_at")
  reviewedBy             String?              @map("reviewed_by") @db.Uuid
  rejectionReason        String?              @map("rejection_reason")
  /// No FK on `createdBy`: it is NOT NULL, so onDelete:SetNull is impossible and
  /// onDelete:Restrict would orphan-block legitimate user deletions. Left as a
  /// bare provenance UUID by design. ownerUserId / reviewedBy (nullable) DO
  /// carry SetNull FKs.
  createdBy              String               @map("created_by") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User?               @relation("McpCatalogOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviewer     User?               @relation("McpCatalogReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  instances    McpServerInstance[]
  integratedProducts IntegratedProduct[]

  // Uniqueness is enforced by partial indexes (see migration): public entries
  // are unique on `name` store-wide; private entries are unique per owner. A
  // single `@@unique` can't express either, so they live in raw SQL.
  @@index([organizationId, status])
  @@index([ownerUserId, status])
  @@index([visibility, status])
  @@map("mcp_catalog_entries")
}

