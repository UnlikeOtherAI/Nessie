/// Compliance note: audit_logs INTENTIONALLY has no Organization FK on
/// organization_id. Audit rows must survive organization deletion for legal /
/// forensic retention, so org deletes must not cascade them away. Do not add a
/// FK here.
model AuditLog {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String?        @map("project_id") @db.Uuid
  teamId         String?        @map("team_id") @db.Uuid
  channelId      String?        @map("channel_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String         @map("actor_id")
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  outcome        AuditOutcome
  reason         String?
  metadata       Json?
  requestId      String         @map("request_id")
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")
  createdAt      DateTime       @default(now()) @map("created_at")
  // Tamper-evident per-organization SHA-256 hash chain. Nullable: rows written
  // before the chain existed are a pre-chain epoch (both null); the chain starts
  // at the first new row per org (genesis: prevHash = null). See
  // @nessie/db audit-chain.ts and docs/functionality.md §Audit trail.
  prevHash       String?        @map("prev_hash")
  entryHash      String?        @map("entry_hash")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  // Serves listAuditLog's resourceType filter + createdAt-desc ordering
  // (audit.ts): the resourceType/resourceId index above cannot satisfy the sort.
  @@index([organizationId, resourceType, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Compliance note: token_ledger_events INTENTIONALLY has no Organization FK on
/// organization_id. Ledger rows must survive organization deletion for billing /
/// audit retention, so org deletes must not cascade them away. Do not add a FK.
model TokenLedgerEvent {
  id                    String                 @id @default(uuid()) @db.Uuid
  occurredAt            DateTime               @map("occurred_at") @db.Timestamptz(6)
  /// Stable per-inference idempotency key. The write path
