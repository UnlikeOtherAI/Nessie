/// This model documents the raw-SQL queue table so Prisma Migrate stays in sync
/// with the development database. Queue polling and dequeue remain SQL-backed.
model QueueJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic          String
  payload        Json
  status         String    @default("pending")
  idempotencyKey String?   @map("idempotency_key")
