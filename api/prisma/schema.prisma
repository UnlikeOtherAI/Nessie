  adoptedAt                      DateTime?              @map("adopted_at")
  requiredEnvironmentTemplateIds Json                   @default("[]") @map("required_environment_template_ids")
  // W17 (§5): last successful designer test run's per-step output, keyed by
  // step id — a sensitive-data store (W0-redacted on write, provenance in
