  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scopeType, scopeId])
  @@index([organizationId])
  @@map("budgets")
}

// Durable dedupe marker for budget alerts. One row per governing budget scope,
// period window, and alert kind ('threshold' when cumulative spend first crosses
// the warn threshold, 'blocked' when the gate first blocks a run). The unique
// constraint makes "notify at most once per budget per period per kind" atomic
// and crash-safe: the worker inserts with skipDuplicates and only the first
// inserter delivers the notification. organizationId is a scalar (no relation),
// matching the token_ledger_events pattern — this is append-only ops telemetry.
model BudgetAlert {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  scopeType      BudgetScopeType @map("scope_type")
  scopeId        String          @map("scope_id") @db.Uuid
  period         BudgetPeriod
  periodStart    DateTime        @map("period_start") @db.Timestamptz(6)
  kind           String
  percentUsed    Int?            @map("percent_used")
  spentUsd       Decimal?        @map("spent_usd") @db.Decimal(14, 4)
  costLimitUsd   Decimal?        @map("cost_limit_usd") @db.Decimal(14, 4)
  createdAt      DateTime        @default(now()) @map("created_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scopeType, scopeId, periodStart, kind])
  @@index([organizationId, createdAt])
  @@map("budget_alerts")
}

model ModelPricingProfile {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  provider               String
  modelPattern           String        @map("model_pattern")
  currency               String        @default("USD")
  source                 PricingSource
  inputPerMillion        Decimal?      @map("input_per_million") @db.Decimal(20, 8)
  outputPerMillion       Decimal?      @map("output_per_million") @db.Decimal(20, 8)
  cachedInputPerMillion  Decimal?      @map("cached_input_per_million") @db.Decimal(20, 8)
  cachedOutputPerMillion Decimal?      @map("cached_output_per_million") @db.Decimal(20, 8)
  cacheReadPerMillion    Decimal?      @map("cache_read_per_million") @db.Decimal(20, 8)
  cacheWritePerMillion   Decimal?      @map("cache_write_per_million") @db.Decimal(20, 8)
  effectiveFrom          DateTime      @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime?     @map("effective_to") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")
  organization           Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, provider, modelPattern])
  /// At most one ACTIVE profile per (organizationId, provider, modelPattern):
  /// enforced by partial unique index `model_pricing_profiles_active_unique`
  /// WHERE effective_to IS NULL (raw SQL, see
  /// 20260530170600_pricing_profile_active_unique). This makes the active-row
  /// lookup in findPricingProfile deterministic.
  @@map("model_pricing_profiles")
}

enum ConnectorType {
  mcp
  http
  web_search
  web_fetch
  storage
  push
  github
  oauth
  // Hosted agent mailboxes: one event per outbound send and per processed
  // inbound message — never one per protocol command. No cost fields; UOA
  // remains the sole commercial authority.
  email
  other
}

// Per-call usage ledger for non-AI third-party connectors (MCP servers, HTTP
// tools, web search/fetch, push, storage, GitHub, OAuth). Sibling to
// TokenLedgerEvent: same attribution dimensions (who / where-from), but counts
// calls + units instead of tokens. Written by recordConnectorUsage
// (@nessie/runtime) at the runtime dispatch site.
model ConnectorUsageEvent {
  id             String          @id @default(uuid()) @db.Uuid
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(6)
  organizationId String          @map("organization_id") @db.Uuid
  userId         String?         @map("user_id") @db.Uuid
  projectId      String?         @map("project_id") @db.Uuid
  teamId         String?         @map("team_id") @db.Uuid
  channelId      String?         @map("channel_id") @db.Uuid
  threadId       String?         @map("thread_id") @db.Uuid
  taskId         String?         @map("task_id") @db.Uuid
  runId          String?         @map("run_id") @db.Uuid
  agentId        String?         @map("agent_id") @db.Uuid
  actorId        String          @map("actor_id")
  actorType      AuditActorType? @map("actor_type")
  requestId      String?         @map("request_id")
  correlationId  String?         @map("correlation_id")
  connectorType  ConnectorType   @map("connector_type")
  connectorId    String?         @map("connector_id") @db.Uuid
  target         String?
  operation      String?
  calls          Int             @default(1)
  units          Int?
  unitType       String?         @map("unit_type")
  costAmount     Decimal?        @map("cost_amount") @db.Decimal(20, 8)
  costCurrency   String?         @map("cost_currency")
  success        Boolean?
  latencyMs      Int?            @map("latency_ms")
  metadata       Json?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, connectorType, occurredAt(sort: Desc)])
  @@index([organizationId, agentId, occurredAt(sort: Desc)])
  @@index([organizationId, userId, occurredAt(sort: Desc)])
  @@index([organizationId, channelId, occurredAt(sort: Desc)])
  @@index([organizationId, connectorId, occurredAt(sort: Desc)])
  @@index([organizationId, runId, occurredAt(sort: Desc)])
  @@map("connector_usage_events")
}

// Append-only signed-delta ledger of bytes STORED (not transferred — that is
// ConnectorUsageEvent). Each stored file emits a positive delta; each deletion
// emits a negative one. Current usage for any scope = SUM(delta_bytes) filtered
// by that scope, which is race-free and self-healing. Written exclusively by
// the FileService (@nessie/runtime).
model StorageUsageEvent {
  id             String          @id @default(uuid()) @db.Uuid
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(6)
  organizationId String          @map("organization_id") @db.Uuid
  projectId      String?         @map("project_id") @db.Uuid
  teamId         String?         @map("team_id") @db.Uuid
  spaceId        String?         @map("space_id") @db.Uuid
  uploaderId     String?         @map("uploader_id") @db.Uuid
  attachmentId   String?         @map("attachment_id") @db.Uuid
  deltaBytes     BigInt          @map("delta_bytes")
  operation      String
  actorId        String          @map("actor_id")
  actorType      AuditActorType? @map("actor_type")
  requestId      String?         @map("request_id")
  correlationId  String?         @map("correlation_id")
  metadata       Json?
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, projectId])
  @@index([organizationId, teamId])
  @@index([organizationId, spaceId])
  @@index([organizationId, uploaderId])
  @@map("storage_usage_events")
}

// ─── Memory Models ──────────────────────────────────────────────────────────

model Thought {
  id             String                       @id @default(uuid()) @db.Uuid
  content        String
  contentHash    String                       @map("content_hash")
  embedding      Unsupported("vector(1024)")?
  embeddingModel String?                      @map("embedding_model")
  dims           Int?
  searchVector   Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('english'::regconfig, COALESCE(content, ''::text))")) @map("search_vector")

  // Ownership
  ownerId   String           @map("owner_id")
  ownerType ThoughtOwnerType @map("owner_type")

  // Canonical audience
  audienceType ThoughtAudienceType? @map("audience_type")
  audienceId   String?              @map("audience_id") @db.Uuid

  // Per-agent privacy: when set, only this agent may recall the memory.
  // Orthogonal to the audience (access) axis — the audience still governs
  // which users/scopes can access it, so user-access filtering is unchanged.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?      @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  // Classification
  visibility      ThoughtVisibility     @default(private)
  sensitivityTier SensitivityTier       @default(normal) @map("sensitivity_tier")
  memoryType      ThoughtMemoryType     @default(semantic) @map("memory_type")
  memoryCategory  ThoughtMemoryCategory @default(fact) @map("memory_category")
  importance      Float                 @default(0.5)

  // LLM-extracted metadata
  metadata Json?

  // Lifecycle
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(6)
  accessCount    Int       @default(0) @map("access_count")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  reasonings ThoughtReasoning[]
  linksFrom  ThoughtLink[]      @relation("ThoughtLinksFrom")
  linksTo    ThoughtLink[]      @relation("ThoughtLinksTo")
  auditLogs  ThoughtAuditLog[]
  recalls    ThoughtRecall[]

  @@index([organizationId, visibility, createdAt])
  @@index([organizationId, memoryType, memoryCategory, createdAt])
  @@index([organizationId, audienceType, audienceId, createdAt])
  @@index([organizationId, ownerId, ownerType])
  @@index([contentHash])
  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@index([privateToAgentId])
  @@map("thoughts")
}

model KnowledgeSpace {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  metadata    Json?

  // Per-agent privacy: when set, only this agent may access the space.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  /// The agent that owns this space as its documents home.
  /// Its human audience is derived from the agent at read time and never copied.
  /// The steward is read through `Agent.ownerUserId` rather than duplicated here.
  ownerAgentId String? @map("owner_agent_id") @db.Uuid

  // Tenant scoping mirrors Thought and satisfies the shared scoped-content
  // contract used by packages/retrieval.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  visibility      ThoughtVisibility @default(project)
  // When true, reading follows `visibility` but writing is limited to members +
  // creator — i.e. the "public read-only, private write" mode.
  writeRestricted Boolean           @default(false) @map("write_restricted")
  sensitivityTier SensitivityTier   @default(normal) @map("sensitivity_tier")
  createdBy       String            @map("created_by")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  pages                KnowledgePage[]
  members              KnowledgeSpaceMember[]
  pushSurfacePresences UserPushSurfacePresence[]
  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  ownerAgent           Agent?                    @relation("AgentDocsSpaces", fields: [ownerAgentId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_spaces_org_project_updated_id_idx")
  @@index([organizationId, ownerAgentId])
  @@index([organizationId, visibility, updatedAt], map: "knowledge_spaces_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_spaces_org_sensitivity_idx")
  @@index([privateToAgentId], map: "knowledge_spaces_private_to_agent_id_idx")
  @@map("knowledge_spaces")
}

// Explicit per-space access grants. Used by `private` visibility (who can read)
// and by `writeRestricted` spaces (who can write). The space creator always has
// full access regardless of membership.
// A member row grants one principal — a user XOR an agent — access to a
// space. Exactly one of userId/agentId is set (enforced in the service layer;
// both columns are nullable so either principal kind can be granted).
model KnowledgeSpaceMember {
  id             String   @id @default(uuid()) @db.Uuid
  spaceId        String   @map("space_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  agentId        String?  @map("agent_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  space        KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user         User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent        Agent?         @relation("KnowledgeSpaceAgentMembers", fields: [agentId], references: [id], onDelete: Cascade)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@unique([spaceId, agentId])
  @@index([userId])
  @@index([agentId])
  @@index([organizationId])
  @@map("knowledge_space_members")
}

model KnowledgePage {
  id       String  @id @default(uuid()) @db.Uuid
  spaceId  String  @map("space_id") @db.Uuid
  title    String
  summary  String?
  metadata Json?

  kind               KnowledgePageKind   @default(document)
  parentPageId       String?             @map("parent_page_id") @db.Uuid
  position           Int                 @default(0)
  status             KnowledgePageStatus @default(draft)
  publishedVersionId String?             @unique(map: "knowledge_pages_published_version_id_key") @map("published_version_id") @db.Uuid

  // Per-agent privacy: when set, only this agent may access the page.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping mirrors Thought and satisfies the shared scoped-content
  // contract used by packages/retrieval.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  // Optimistic concurrency for the page row, the counterpart of
  // `Dashboard.revision` and `WorkflowTemplate.version`. `versionNumber` lives
  // on the per-version row and cannot serve an `If-Match`, so the auto-saving
  // editor needs a current-revision column here.
  revision Int @default(0)

  visibility      ThoughtVisibility @default(project)
  sensitivityTier SensitivityTier   @default(normal) @map("sensitivity_tier")
  // Ticket binding: a page carrying taskId is a ticket document. Loose scoping
  // column like the rest of the envelope (no FK) — task deletion archives
  // pages at the app layer, it does not cascade here.
  taskId          String?           @map("task_id") @db.Uuid
  createdBy       String            @map("created_by")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  space                  KnowledgeSpace            @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentPage             KnowledgePage?            @relation("KnowledgePageTree", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages             KnowledgePage[]           @relation("KnowledgePageTree")
  versions               KnowledgePageVersion[]    @relation("KnowledgePageVersions")
  publishedVersion       KnowledgePageVersion?     @relation("KnowledgePagePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  labels                 PageLabel[]
  annotations            KnowledgePageAnnotation[]
  chunks                 KnowledgePageChunk[]
  outgoingLinks          KnowledgePageLink[]       @relation("KnowledgePageLinkSource")
  incomingLinks          KnowledgePageLink[]       @relation("KnowledgePageLinkTarget")
  productIntegrationRuns ProductIntegrationRun[]
  pushAttentionAlerts    UserAlert[]               @relation("PushAttentionAlertKnowledgePage")
  project                Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([taskId], map: "knowledge_pages_task_id_idx")
  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_pages_org_project_updated_id_idx")
  @@index([organizationId, visibility, updatedAt], map: "knowledge_pages_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_pages_org_sensitivity_idx")
  @@index([spaceId, parentPageId, position], map: "knowledge_pages_space_parent_position_idx")
  @@index([publishedVersionId], map: "knowledge_pages_published_version_id_idx")
  @@index([privateToAgentId], map: "knowledge_pages_private_to_agent_id_idx")
  // Trigram GIN indexes back the ILIKE '%q%' search (native-search.ts) so it
  // doesn't sequentially scan every page per query. Requires the pg_trgm
  // extension, created in the same migration.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_pages_title_trgm_idx")
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_pages_summary_trgm_idx")
  @@map("knowledge_pages")
}

model KnowledgePageVersion {
  id            String              @id @default(uuid()) @db.Uuid
  pageId        String              @map("page_id") @db.Uuid
  versionNumber Int                 @map("version_number")
  body          String?             @db.Text
  bodyRef       String?             @map("body_ref")
  // For file nodes (KnowledgePage.kind = file): the stored object backing this
  // version. App-enforced (no FK relation), mirroring Attachment's other links.
  attachmentId  String?             @map("attachment_id") @db.Uuid
  authorType    KnowledgeAuthorType @map("author_type")
  authorId      String              @map("author_id")
  changeComment String?             @map("change_comment")
  createdAt     DateTime            @default(now()) @map("created_at")

  page             KnowledgePage        @relation("KnowledgePageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  publishedForPage KnowledgePage?       @relation("KnowledgePagePublishedVersion")
  chunks           KnowledgePageChunk[]

  @@unique([pageId, versionNumber], map: "knowledge_page_versions_page_version_key")
  @@index([pageId, createdAt(sort: Desc)], map: "knowledge_page_versions_page_created_idx")
  @@index([attachmentId], map: "knowledge_page_versions_attachment_id_idx")
  @@map("knowledge_page_versions")
}

model KnowledgePageChunk {
  id          String @id @default(uuid()) @db.Uuid
  pageId      String @map("page_id") @db.Uuid
  versionId   String @map("version_id") @db.Uuid
  chunkIndex  Int    @map("chunk_index")
  content     String @db.Text
  contentHash String @map("content_hash")
  startOffset Int    @map("start_offset")
  endOffset   Int    @map("end_offset")
  tokenCount  Int?   @map("token_count")

  embedding      Unsupported("vector(1024)")?
  embeddingModel String?                      @map("embedding_model")
  dims           Int?
  searchVector   Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('english'::regconfig, COALESCE(content, ''::text))")) @map("search_vector")

  // Mirrors KnowledgePage/Thought scoping so retrieval can enforce access in
  // the candidate query without joining back through mutable page metadata.
  organizationId   String            @map("organization_id") @db.Uuid
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String            @map("project_id") @db.Uuid
  teamId           String?           @map("team_id") @db.Uuid
  channelId        String?           @map("channel_id") @db.Uuid
  threadId         String?           @map("thread_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  visibility       ThoughtVisibility @default(project)
  sensitivityTier  SensitivityTier   @default(normal) @map("sensitivity_tier")
  privateToAgentId String?           @map("private_to_agent_id") @db.Uuid
  taskId           String?           @map("task_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  page    KnowledgePage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version KnowledgePageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([versionId, chunkIndex], map: "knowledge_page_chunks_version_chunk_key")
  @@index([pageId, versionId], map: "knowledge_page_chunks_page_version_idx")
  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_page_chunks_org_project_updated_id_idx")
  @@index([organizationId, visibility, updatedAt], map: "knowledge_page_chunks_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_page_chunks_org_sensitivity_idx")
  @@index([privateToAgentId], map: "knowledge_page_chunks_private_to_agent_id_idx")
  @@index([taskId], map: "knowledge_page_chunks_task_id_idx")
  @@map("knowledge_page_chunks")
}

// Wikilink index: one row per outgoing link in a page's latest body.
// Maintained transactionally alongside chunking on every version save.
// targetPageId is null for unresolved [[Title]] links; creating a page whose
// title matches resolves them.
model KnowledgePageLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourcePageId   String   @map("source_page_id") @db.Uuid
  targetPageId   String?  @map("target_page_id") @db.Uuid
  targetTitle    String   @map("target_title")
  createdAt      DateTime @default(now()) @map("created_at")

  sourcePage   KnowledgePage  @relation("KnowledgePageLinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage   KnowledgePage? @relation("KnowledgePageLinkTarget", fields: [targetPageId], references: [id], onDelete: SetNull)
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([sourcePageId])
  @@index([targetPageId])
  @@index([organizationId, targetTitle])
  @@map("knowledge_page_links")
}

model PageLabel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")

  page         KnowledgePage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([pageId, normalizedName], map: "page_labels_page_normalized_key")
  @@index([organizationId, normalizedName], map: "page_labels_org_normalized_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "page_labels_normalized_trgm_idx")
  @@map("page_labels")
}

model KnowledgePageAnnotation {
  id      String                   @id @default(uuid()) @db.Uuid
  pageId  String                   @map("page_id") @db.Uuid
  spaceId String                   @map("space_id") @db.Uuid
  kind    KnowledgeAnnotationKind
  state   KnowledgeAnnotationState @default(open)

  // One level of replies: top-level rows have a null parent; replies point to a
  // top-level annotation of the same page (single level enforced in the service).
  parentId String? @map("parent_id") @db.Uuid

  body String @db.Text

  // Authorship mirrors KnowledgePageVersion (type + id). delegatedByAgentId is
  // set when a user-delegating agent (PA) authors on behalf of its owner.
  authorType         KnowledgeAuthorType @map("author_type")
  authorId           String              @map("author_id")
  delegatedByAgentId String?             @map("delegated_by_agent_id") @db.Uuid

  // Text-quote anchor (notes only); null for page-level comments. Authoritative
  // re-location happens per-render; `orphaned` is a best-effort cached hint.
  anchor          Json?
  anchorVersionId String? @map("anchor_version_id") @db.Uuid
  orphaned        Boolean @default(false)

  resolvedAt     DateTime?            @map("resolved_at")
  resolvedByType KnowledgeAuthorType? @map("resolved_by_type")
  resolvedById   String?              @map("resolved_by_id")

  organizationId String @map("organization_id") @db.Uuid

  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

