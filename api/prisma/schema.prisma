  embeddingModel String?                    @map("embedding_model")
  dims          Int?
  searchVector Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('english'::regconfig, COALESCE(content, ''::text))")) @map("search_vector")

  // Ownership
  ownerId   String           @map("owner_id")
  ownerType ThoughtOwnerType @map("owner_type")

  // Canonical audience
  audienceType ThoughtAudienceType? @map("audience_type")
  audienceId   String?              @map("audience_id") @db.Uuid

  // Per-agent privacy: when set, only this agent may recall the memory.
  // Orthogonal to the audience (access) axis — the audience still governs
  // which users/scopes can access it, so user-access filtering is unchanged.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?      @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  // Classification
  visibility      ThoughtVisibility     @default(private)
  sensitivityTier SensitivityTier       @default(normal) @map("sensitivity_tier")
  memoryType      ThoughtMemoryType     @default(semantic) @map("memory_type")
  memoryCategory  ThoughtMemoryCategory @default(fact) @map("memory_category")
  importance      Float                 @default(0.5)

  // LLM-extracted metadata
  metadata Json?

  // Lifecycle
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(6)
  accessCount    Int       @default(0) @map("access_count")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  reasonings ThoughtReasoning[]
  linksFrom  ThoughtLink[]      @relation("ThoughtLinksFrom")
  linksTo    ThoughtLink[]      @relation("ThoughtLinksTo")
  auditLogs  ThoughtAuditLog[]
  recalls    ThoughtRecall[]

  @@index([organizationId, visibility, createdAt])
  @@index([organizationId, memoryType, memoryCategory, createdAt])
  @@index([organizationId, audienceType, audienceId, createdAt])
  @@index([organizationId, ownerId, ownerType])
  @@index([contentHash])
  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@index([privateToAgentId])
  @@map("thoughts")
}

model KnowledgeSpace {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  metadata    Json?

  // Per-agent privacy: when set, only this agent may access the space.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping mirrors Thought and satisfies the shared scoped-content
  // contract used by packages/retrieval.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  visibility      ThoughtVisibility @default(project)
  sensitivityTier SensitivityTier   @default(normal) @map("sensitivity_tier")
  createdBy       String            @map("created_by")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  pages KnowledgePage[]

  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_spaces_org_project_updated_id_idx")
  @@index([organizationId, visibility, updatedAt], map: "knowledge_spaces_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_spaces_org_sensitivity_idx")
  @@index([privateToAgentId], map: "knowledge_spaces_private_to_agent_id_idx")
  @@map("knowledge_spaces")
}

model KnowledgePage {
  id       String @id @default(uuid()) @db.Uuid
  spaceId  String @map("space_id") @db.Uuid
  title    String
  summary  String?
  metadata Json?

  parentPageId       String? @map("parent_page_id") @db.Uuid
  position           Int     @default(0)
  status             KnowledgePageStatus @default(draft)
  publishedVersionId String? @unique(map: "knowledge_pages_published_version_id_key") @map("published_version_id") @db.Uuid

  // Per-agent privacy: when set, only this agent may access the page.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping mirrors Thought and satisfies the shared scoped-content
  // contract used by packages/retrieval.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  visibility      ThoughtVisibility @default(project)
  sensitivityTier SensitivityTier   @default(normal) @map("sensitivity_tier")
  createdBy       String            @map("created_by")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  space            KnowledgeSpace        @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentPage       KnowledgePage?        @relation("KnowledgePageTree", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages       KnowledgePage[]       @relation("KnowledgePageTree")
  versions         KnowledgePageVersion[] @relation("KnowledgePageVersions")
  publishedVersion KnowledgePageVersion? @relation("KnowledgePagePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  labels           PageLabel[]

  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_pages_org_project_updated_id_idx")
  @@index([organizationId, visibility, updatedAt], map: "knowledge_pages_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_pages_org_sensitivity_idx")
  @@index([spaceId, parentPageId, position], map: "knowledge_pages_space_parent_position_idx")
  @@index([publishedVersionId], map: "knowledge_pages_published_version_id_idx")
  @@index([privateToAgentId], map: "knowledge_pages_private_to_agent_id_idx")
  @@map("knowledge_pages")
}

model KnowledgePageVersion {
  id            String              @id @default(uuid()) @db.Uuid
  pageId        String              @map("page_id") @db.Uuid
  versionNumber Int                 @map("version_number")
  body          String?             @db.Text
  bodyRef       String?             @map("body_ref")
  authorType    KnowledgeAuthorType @map("author_type")
  authorId      String              @map("author_id")
  changeComment String?             @map("change_comment")
  createdAt     DateTime            @default(now()) @map("created_at")

  page             KnowledgePage  @relation("KnowledgePageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  publishedForPage KnowledgePage? @relation("KnowledgePagePublishedVersion")

  @@unique([pageId, versionNumber], map: "knowledge_page_versions_page_version_key")
  @@index([pageId, createdAt(sort: Desc)], map: "knowledge_page_versions_page_created_idx")
  @@map("knowledge_page_versions")
}

model PageLabel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")

  page KnowledgePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, normalizedName], map: "page_labels_page_normalized_key")
  @@index([organizationId, normalizedName], map: "page_labels_org_normalized_idx")
  @@map("page_labels")
}

model ThoughtReasoning {
  id        String  @id @default(uuid()) @db.Uuid
  thoughtId String  @map("thought_id") @db.Uuid
  thought   Thought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  reasoningType ReasoningType @map("reasoning_type")
  alternatives  Json?
  criteria      Json?
  constraints   Json?
  tradeoffs     String?
  confidence    Float?
  reasoning     String

  actorType String @map("actor_type")
  actorId   String @map("actor_id")

  outcome      OutcomeStatus @default(pending)
  outcomeNotes String?       @map("outcome_notes")
  outcomeAt    DateTime?     @map("outcome_at")

  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([thoughtId, createdAt])
  @@index([organizationId, outcome])
  @@index([organizationId, actorId])
  @@map("thought_reasonings")
}

model ThoughtLink {
  id        String              @id @default(uuid()) @db.Uuid
  sourceId  String              @map("source_id") @db.Uuid
  targetId  String              @map("target_id") @db.Uuid
  source    Thought             @relation("ThoughtLinksFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Thought             @relation("ThoughtLinksTo", fields: [targetId], references: [id], onDelete: Cascade)
  relation  ThoughtLinkRelation
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  @@unique([sourceId, targetId, relation])
  @@index([targetId])
  @@map("thought_links")
}

model ThoughtAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  thoughtId String   @map("thought_id") @db.Uuid
  thought   Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  action    String
  actorType String   @map("actor_type")
  actorId   String   @map("actor_id")
  diff      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([thoughtId, createdAt])
  @@map("thought_audit_logs")
}

model ThoughtRecall {
  id                 String                       @id @default(uuid()) @db.Uuid
  thoughtId          String                       @map("thought_id") @db.Uuid
  thought            Thought                      @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  requesterUserId    String?                      @map("requester_user_id") @db.Uuid
  sessionId          String?                      @map("session_id")
  channelId          String?                      @map("channel_id") @db.Uuid
  outputAudienceType ThoughtAudienceType?         @map("output_audience_type")
  outputAudienceId   String?                      @map("output_audience_id") @db.Uuid
  queryText          String                       @map("query_text")
  queryEmbedding     Unsupported("vector(1536)")? @map("query_embedding")
  similarity         Float?
  rankPosition       Int                          @map("rank_position")
  retrievalMode      String                       @default("hybrid") @map("retrieval_mode")
  wasInjected        Boolean                      @default(false) @map("was_injected")
  wasReferenced      Boolean                      @default(false) @map("was_referenced")
  userSignal         String?                      @map("user_signal")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([thoughtId])
  @@index([requesterUserId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([outputAudienceType, outputAudienceId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("thought_recalls")
}

model Call {
  id           String            @id @default(uuid()) @db.Uuid
  channelId    String            @map("channel_id") @db.Uuid
  roomId       String            @unique @map("room_id")
  status       String            @default("active")
  startedById  String            @map("started_by_id") @db.Uuid
  startedAt    DateTime          @default(now()) @map("started_at")
  endedAt      DateTime?         @map("ended_at")
  channel      Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  startedBy    User              @relation("CallStarter", fields: [startedById], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([channelId])
  @@index([status])
  @@map("calls")
}

model CallParticipant {
  id       String    @id @default(uuid()) @db.Uuid
  callId   String    @map("call_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User      @relation("CallParticipation", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@map("call_participants")
}

/// Encrypted MCP OAuth token storage (production SecretStore backing table).
/// Rows hold AES-256-GCM ciphertext of the OAuth token bundle keyed by the
/// opaque `secret_oauth_*` ref handed back to the credential resolution chain.
model McpOAuthSecret {
  ref        String   @id
  ciphertext String
  iv         String
  authTag    String   @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("mcp_oauth_secret")
}

// ─── File uploads / attachments (Slack-parity files slice) ──────────────────
// Standalone, relation-free model so the files slice can land additively
// without editing the User / Message / Organization models. The link to a
// message is a nullable scalar `messageId` set after upload when the message
// is created; integrity is enforced at the application layer.
model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  uploaderId     String?  @map("uploader_id") @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  kind           String
  mime           String
  filename       String
  sizeBytes      Int      @map("size_bytes")
  storageKey     String   @map("storage_key")
  width          Int?
  height         Int?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([messageId])
  @@index([organizationId, createdAt])
  @@map("attachments")
}

// ─── Push credentials (platform-global, super-admin only) ───────────────────
// Non-secret metadata for the Apple APNs / Google FCM credentials that the
// central push gateway uses. The secret bytes themselves (the `.p8` key, the
// FCM service-account JSON) live encrypted in `mcp_oauth_secret` via the
// SecretStore under a stable ref (`secretRef`); they are NEVER stored here and
// NEVER returned from any endpoint. One row per provider (apns | fcm).
enum PushProvider {
  apns
  fcm
}

enum PushApnsEnvironment {
  sandbox
  production
}

model PushCredential {
  id              String               @id @default(uuid()) @db.Uuid
  provider        PushProvider         @unique
  // Opaque ref into the encrypted SecretStore (`mcp_oauth_secret`).
  secretRef       String               @map("secret_ref")
  // APNs metadata (null for fcm rows).
  apnsKeyId       String?              @map("apns_key_id")
  apnsTeamId      String?              @map("apns_team_id")
  apnsTopic       String?              @map("apns_topic")
  apnsEnvironment PushApnsEnvironment? @map("apns_environment")
  // FCM metadata (null for apns rows).
  fcmProjectId    String?              @map("fcm_project_id")
  fcmClientEmail  String?              @map("fcm_client_email")
  updatedByUserId String               @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("push_credentials")
}
