enum UserAlertKind {
  mention
}

// Persistent per-user alert records. v1 writes one `mention` row per directly
// @mentioned user in the message-create transaction (self-mentions skipped;
// broadcast mentions intentionally create no rows). The model is deliberately
// generic so future kinds (approval nudges, needs-action items) write into the
// same alerts substrate. A muted channel still gets the row — mute suppresses
// the push, never the durable alert.
model UserAlert {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  kind           UserAlertKind
  messageId      String?       @map("message_id") @db.Uuid
  threadId       String?       @map("thread_id") @db.Uuid
  channelId      String?       @map("channel_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  actorAgentId   String?       @map("actor_agent_id") @db.Uuid
  readAt         DateTime?     @map("read_at")
  createdAt      DateTime      @default(now()) @map("created_at")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  message        Message?      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  thread         Thread?       @relation(fields: [threadId], references: [id], onDelete: Cascade)
  channel        Channel?      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  actorUser      User?         @relation("UserAlertActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAgent     Agent?        @relation(fields: [actorAgentId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([organizationId, userId, createdAt])
  @@map("user_alerts")
}

model ThreadStreamEvent {
  id        BigInt   @id @default(autoincrement())
  threadId  String   @map("thread_id") @db.Uuid
  eventName String   @map("event_name")
  data      Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, id], map: "idx_thread_stream_events_replay")
  @@map("thread_stream_events")
}

model RealtimeEvent {
  id             BigInt   @id @default(autoincrement())
  organizationId String   @map("organization_id") @db.Uuid
  channelId      String   @map("channel_id") @db.Uuid
  eventType      String   @map("event_type")
  payload        Json     @db.JsonB
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz()

  @@index([channelId, id], map: "idx_realtime_events_replay")
  @@index([organizationId, createdAt])
  @@map("realtime_events")
}

// ─── User presence registry (foreground SSE streams) ────────────────────────
// One row per user, shared through Postgres so out-of-process workers can
// decide whether a user currently has a live foreground connection. Relation-
// free like device tokens: the SSE route owns lifecycle updates.
enum UserPresenceManualState {
  active
  away
}

model UserPresence {
