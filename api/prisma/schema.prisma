/// A globally exclusive exact domain claim. `challengeDigest` is retained for
/// evidence and comparison; the raw random TXT challenge is encrypted in the
/// service boundary and is never returned after creation.
model AutomaticMembershipDomainClaim {
  id                       String                          @id @default(uuid()) @db.Uuid
  organizationId           String                          @map("organization_id") @db.Uuid
  domain                   String                          @map("domain_ascii")
  state                    AutomaticMembershipClaimState  @default(pending)
  challengeDigest          String                          @map("challenge_digest")
  challengeEncrypted       String                          @map("challenge_encrypted")
  challengeGeneration      Int                             @default(1) @map("challenge_generation")
  notificationEmail        String?                         @map("notification_email")
  classifierVersion        String                          @map("classifier_version")
  verifiedAt               DateTime?                       @map("verified_at")
  verificationExpiresAt    DateTime?                       @map("verification_expires_at")
  lastDnsCheckAt           DateTime?                       @map("last_dns_check_at")
  lastDnsFailure           String?                         @map("last_dns_failure")
  releasedAt               DateTime?                       @map("released_at")
  createdAt                DateTime                        @default(now()) @map("created_at")
  updatedAt                DateTime                        @updatedAt @map("updated_at")
  organization             Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rules                    AutomaticMembershipRule[]

  @@index([organizationId, state])
  @@index([state, verificationExpiresAt])
  @@map("automatic_membership_domain_claims")
}

