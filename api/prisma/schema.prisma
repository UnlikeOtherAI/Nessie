  label            String
  description      String
  // Spec §3.1: `overview` is a required human-readable summary. No DB
  // default — every new row must supply a non-empty value. Pre-reconcile
  // rows backfilled with `''` remain legal (NOT NULL is preserved).
  overview         String
  instructions     String                  @default("")
  safe             Boolean                 @default(false)
  builtin          Boolean                 @default(false)
  enabled          Boolean                 @default(true)
  handlerKind      String                  @default("builtin") @map("handler_kind")
  metadata         Json?                   @default("{}")
  source           ToolRegistrySource      @default(builtin)
  transport        ToolRegistryTransport   @default(direct)
