model UserStatusRule {
  id           String              @id @default(uuid()) @db.Uuid
  statusId     String              @map("status_id") @db.Uuid
  scope        UserStatusRuleScope @default(fallback)
  channelId    String?             @map("channel_id") @db.Uuid
  projectId    String?             @map("project_id") @db.Uuid
  agentId      String?             @map("agent_id") @db.Uuid
  agentEnabled Boolean             @default(true) @map("agent_enabled")
  instructions String
  priority     Int                 @default(0)
  createdAt    DateTime            @default(now()) @map("created_at")
  updatedAt    DateTime            @updatedAt @map("updated_at")
  status       UserStatus          @relation(fields: [statusId], references: [id], onDelete: Cascade)
  channel      Channel?            @relation(fields: [channelId], references: [id], onDelete: Cascade)
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  agent        Agent?              @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([statusId, priority])
  @@index([channelId])
  @@index([projectId])
  @@index([agentId])
  @@map("user_status_rules")
}

model Message {
  id                          String                         @id @default(uuid()) @db.Uuid
  threadId                    String                         @map("thread_id") @db.Uuid
  agentId                     String?                        @map("agent_id") @db.Uuid
  // Present only when the organization-singleton Personal Assistant spoke from
  // a member's explicit shared-channel presence. It is structural provenance,
  // never a display-name inference.
  onBehalfOfUserId            String?                        @map("on_behalf_of_user_id") @db.Uuid
  userId                      String?                        @map("user_id") @db.Uuid
  role                        MessageRole
  content                     String
  metadata                    Json?                          @default("{}")
  // Message-level reply threads: null = top-level post in the container
  // thread; set = reply belonging to that root's reply thread (one level
  // deep — replies to replies attach to the same root).
  rootMessageId               String?                        @map("root_message_id") @db.Uuid
  // Materialized per-root reply metadata, maintained transactionally on
  // reply create. replyParticipantIds holds distinct author ids (user or
  // agent) of replies, capped for cheap collapsed-bar rendering.
  replyCount                  Int                            @default(0) @map("reply_count")
  lastReplyAt                 DateTime?                      @map("last_reply_at")
  replyParticipantIds         String[]                       @map("reply_participant_ids") @db.Uuid
  // Client-minted idempotency key for one unsent draft. A composer retrying a
  // send (double submit, a flaky network) sends the same key and the route
  // resolves it to the message the first attempt created instead of a second
  // copy. Unique per thread; NULLs are distinct in PostgreSQL, so every message
  // posted without one is unaffected.
  clientMessageId             String?                        @map("client_message_id")
  createdAt                   DateTime                       @default(now()) @map("created_at")
  editedAt                    DateTime?                      @map("edited_at")
  deletedAt                   DateTime?                      @map("deleted_at")
  thread                      Thread                         @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agent                       Agent?                         @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user                        User?                          @relation(fields: [userId], references: [id], onDelete: SetNull)
  rootMessage                 Message?                       @relation("MessageReplies", fields: [rootMessageId], references: [id], onDelete: SetNull)
  replies                     Message[]                      @relation("MessageReplies")
  reactions                   MessageReaction[]
  userAlerts                  UserAlert[]
  threadFollows               MessageThreadFollow[]
  productIntegrationRuns      ProductIntegrationRun[]
  appConnectionRequestCards   AgentAppConnectionRequest[]    @relation("AgentAppConnectionRequestCardMessage")
  agentCards                  AgentCard[]                    @relation("AgentCardMessage")
  agentCardResponses          AgentCard[]                    @relation("AgentCardResponseMessage")
  handoffBriefs               AgentHandoffRequest[]          @relation("AgentHandoffBriefMessage")
  originAppConnectionRequests AgentAppConnectionRequest[]    @relation("AgentAppConnectionRequestOriginTriggerMessage")
  triggeredRuns               Run[]                          @relation("RunTriggerMessage")
  workflowRunOrigins          WorkflowRun[]                  @relation("WorkflowRunOriginMessage")
  workflowRunReplyRoots       WorkflowRun[]                  @relation("WorkflowRunReplyRootMessage")
  runThreadPendingMessages    RunThreadPendingMessage[]
  basisScopes                 MessageBasisScope[]
  disclosureGrants            DisclosureGrant[]
  pushSurfacePresences        UserPushSurfacePresence[]      @relation("PushSurfaceReplyRoot")
  conversationReadStates      MessageConversationReadState[] @relation("MessageConversationReadRoot")

  @@unique([threadId, clientMessageId], map: "messages_thread_id_client_message_id_key")
  @@index([threadId, createdAt])
  @@index([agentId, createdAt])
  @@index([rootMessageId, createdAt])
  @@map("messages")
}

/// Denormalised copy of the producing run's disclosure basis, carried on the
/// message so the read predicate filters a conversation window with one
/// anti-join instead of joining back through runs. Zero rows = unrestricted,
/// which is the overwhelming majority. Source of truth is `RunBasisScope`.
model MessageBasisScope {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  messageId      String       @map("message_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Disclosure scope: user | channel | team | project | organization | agent
  scopeType      String       @map("scope_type")
  scopeId        String       @map("scope_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  message        Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([messageId, scopeType, scopeId], map: "message_basis_scopes_message_scope_key")
  @@index([organizationId], map: "message_basis_scopes_org_idx")
  @@map("message_basis_scopes")
}

/// The acknowledgement card's "share this reply": one message, one audience,
/// granted by a human who currently satisfies that message's full basis.
/// Evaluated at read time against the granter's live membership, so a grant goes
/// inert when its granter loses access and revocation needs no propagation.
model DisclosureGrant {
  id              String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  messageId       String       @map("message_id") @db.Uuid
  grantedByUserId String       @map("granted_by_user_id") @db.Uuid
  /// 'user' | 'channel'
  audienceKind    String       @map("audience_kind")
  audienceId      String       @map("audience_id") @db.Uuid
  expiresAt       DateTime?    @map("expires_at")
  revokedAt       DateTime?    @map("revoked_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  message         Message      @relation(fields: [messageId], references: [id], onDelete: Cascade)
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  grantedBy       User         @relation(fields: [grantedByUserId], references: [id], onDelete: Cascade)

  @@unique([messageId, audienceKind, audienceId], map: "disclosure_grants_message_audience_key")
  @@index([organizationId], map: "disclosure_grants_org_idx")
  @@map("disclosure_grants")
}

/// "Allow always": a standing permission for ONE source scope into ONE
/// destination channel for ONE agent. Non-widening is structural rather than a
/// rule — evaluation is a single exact-key lookup with no wildcard, inheritance,
/// or fallback, so a grant for P into C implies nothing about Q into C or P
/// into D. `expiresAt` is chosen by the granter from a tier-capped duration
/// menu; null means "until revoked", which the most private tiers cannot select.
model ScopeDisclosureGrant {
  id                   String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId       String       @map("organization_id") @db.Uuid
  sourceScopeType      String       @map("source_scope_type")
  sourceScopeId        String       @map("source_scope_id") @db.Uuid
  destinationChannelId String       @map("destination_channel_id") @db.Uuid
  agentId              String       @map("agent_id") @db.Uuid
  grantedByUserId      String       @map("granted_by_user_id") @db.Uuid
  expiresAt            DateTime?    @map("expires_at")
  revokedAt            DateTime?    @map("revoked_at")
  createdAt            DateTime     @default(now()) @map("created_at")
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  destinationChannel   Channel      @relation(fields: [destinationChannelId], references: [id], onDelete: Cascade)
  agent                Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  grantedBy            User         @relation(fields: [grantedByUserId], references: [id], onDelete: Cascade)

  @@unique([sourceScopeType, sourceScopeId, destinationChannelId, agentId], map: "scope_disclosure_grants_key")
  @@index([organizationId], map: "scope_disclosure_grants_org_idx")
  @@index([destinationChannelId], map: "scope_disclosure_grants_destination_idx")
  @@map("scope_disclosure_grants")
}

/// The primary disclosure-provenance record: scoped sources a run consumed that
/// the destination's own scope chain does NOT imply. Everything a run
/// materialises — messages, thinking chunks, tool calls, checkpoints, plan
/// artifacts, workflow output — is governed by this one ledger.
/// `RunCheckpoint.runId` is unique, so checkpoints inherit it without a table of
/// their own.
model RunBasisScope {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  runId          String       @map("run_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  /// Disclosure scope: user | channel | team | project | organization | agent
  scopeType      String       @map("scope_type")
  scopeId        String       @map("scope_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at")
  run            Run          @relation(fields: [runId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([runId, scopeType, scopeId], map: "run_basis_scopes_run_scope_key")
  @@index([organizationId], map: "run_basis_scopes_org_idx")
  @@map("run_basis_scopes")
}

model MessageThreadFollow {
  id            String   @id @default(uuid()) @db.Uuid
  rootMessageId String   @map("root_message_id") @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
