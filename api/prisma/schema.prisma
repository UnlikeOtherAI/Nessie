  instructions     String                  @default("")
  safe             Boolean                 @default(false)
  builtin          Boolean                 @default(false)
  enabled          Boolean                 @default(true)
  handlerKind      String                  @default("builtin") @map("handler_kind")
  metadata         Json?                   @default("{}")
  source           ToolRegistrySource      @default(builtin)
  transport        ToolRegistryTransport   @default(direct)
  transportConfig  Json                    @default("{}") @map("transport_config")
  bundleId         String?                 @map("bundle_id") @db.Uuid
  mcpInstanceId    String?                 @map("mcp_instance_id") @db.Uuid
  inputSchema      Json                    @default("{}") @map("input_schema")
  outputSchema     Json?                   @map("output_schema")
  tags             String[]                @default([])
  baseSearchTerms  String[]                @default([]) @map("base_search_terms")
  allowSearchTerms String[]                @default([]) @map("allow_search_terms")
  // The `{content:'',mergeMode:'append'}` default is implementation-chosen,
  // not spec-mandated. Spec §3.1 only requires that every row carries a
  // `basePrompt` object; the empty/append seed keeps backfills cheap.
  basePrompt       Json                    @default("{\"content\": \"\", \"mergeMode\": \"append\"}") @map("base_prompt")
  commonPrompt     Json?                   @map("common_prompt")
  defaultConfig    Json                    @default("{}") @map("default_config")
  searchableText   String                  @default("") @map("searchable_text")
  status           ToolRegistryEntryStatus @default(active)
  version          String                  @default("0.0.0")
  createdBy        String                  @default("system") @map("created_by")
  owner            String                  @default("system")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  bundle      ToolBundle?        @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  mcpInstance McpServerInstance? @relation(fields: [mcpInstanceId], references: [id], onDelete: SetNull)
  grants      ToolGrant[]

  @@unique([organizationId, scopeKey, toolId], map: "tool_registry_entries_org_scope_tool_key")
  @@index([organizationId, enabled])
  @@index([builtin, enabled])
  @@index([organizationId, source])
  @@index([organizationId, status])
  @@index([bundleId])
  @@index([mcpInstanceId])
  @@index([tags], type: Gin)
  @@index([updatedAt])
  @@map("tool_registry_entries")
}

