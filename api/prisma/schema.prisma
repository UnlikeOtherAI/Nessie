model ToolGrant {
  id        String          @id @default(uuid()) @db.Uuid
  toolId    String          @map("tool_id") @db.Uuid
  state     ToolGrantState  @default(inherit)
  config    Json            @default("{}")
  source    ToolGrantSource
  /// roleId is a free-form RBAC role identifier, not a FK: roles are string /
  /// policy constructs (no Role table exists), so no relation is added here.
  roleId    String?         @map("role_id") @db.Uuid
  agentId   String?         @map("agent_id") @db.Uuid
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  tool  ToolRegistryEntry @relation(fields: [toolId], references: [id], onDelete: Cascade)
  agent Agent?            @relation(fields: [agentId], references: [id], onDelete: Cascade)

  /// Raw-SQL migration `20260901200000_tool_grant_principal_integrity` adds:
  /// - exactly one of roleId or agentId is non-null;
  /// - one role grant per (toolId, roleId); and
  /// - one direct grant per (toolId, agentId).
  @@index([toolId])
  @@index([roleId])
  @@index([agentId])
  @@map("tool_grants")
}

