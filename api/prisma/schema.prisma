/// An opt-in structural trace of work an agent performed in one conversation.
/// Raw recordings are review-only; they are never a runnable automation.
model Demonstration {
  id                  String              @id @default(uuid()) @db.Uuid
  organizationId      String              @map("organization_id") @db.Uuid
  agentId             String              @map("agent_id") @db.Uuid
  channelId           String              @map("channel_id") @db.Uuid
  threadId            String              @map("thread_id") @db.Uuid
  startedByUserId     String              @map("started_by_user_id") @db.Uuid
  status              DemonstrationStatus @default(recording)
  stepCount           Int                 @default(0) @map("step_count")
  generalizationError String?             @map("generalization_error")
  startedAt           DateTime            @default(now()) @map("started_at")
  capturedAt          DateTime?           @map("captured_at")
  expiresAt           DateTime            @map("expires_at")
  workflowTemplate    WorkflowTemplate?   @relation("DemonstrationWorkflowTemplate")
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  agent               Agent               @relation("AgentDemonstrations", fields: [agentId], references: [id], onDelete: Cascade)
  channel             Channel             @relation(fields: [channelId], references: [id], onDelete: Cascade)
  thread              Thread              @relation(fields: [threadId], references: [id], onDelete: Cascade)
