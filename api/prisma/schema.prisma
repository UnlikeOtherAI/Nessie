  @@index([channelId, id], map: "idx_realtime_events_replay")
  @@index([organizationId, recipientUserId, id], map: "idx_realtime_events_user_replay")
  @@index([organizationId, createdAt])
  @@map("realtime_events")
}

// ─── User presence registry (foreground SSE streams) ────────────────────────
// One row per user, shared through Postgres so out-of-process workers can
// decide whether a user currently has a live foreground connection. Relation-
// free like device tokens: the SSE route owns lifecycle updates.
enum UserPresenceManualState {
  active
  away
}

model UserPresence {
  userId         String                   @id @map("user_id") @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  connections    Int                      @default(0)
  lastSeenAt     DateTime                 @map("last_seen_at")
  lastActiveAt   DateTime?                @map("last_active_at")
  manualState    UserPresenceManualState? @map("manual_state")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([lastSeenAt])
  @@index([organizationId])
  @@map("user_presence")
}

// Each active app/browser surface reports its structured destination every
// 25 seconds. Delivery workers use this short-lived, per-session state to skip
// a push only when the recipient is already looking at that exact destination.
enum PushSurfaceKind {
  channel
  ops_usage
  project_board
  knowledge_space
  // The Triggers page. Modelled so a trigger-health notification names its real
  // destination rather than borrowing another surface's identity, which would
  // suppress it for anyone who happened to be on that other page.
  triggers
}

model UserPushSurfacePresence {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  clientId          String           @map("client_id") @db.Uuid
  surfaceKind       PushSurfaceKind? @map("surface_kind")
  channelId         String?          @map("channel_id") @db.Uuid
  threadId          String?          @map("thread_id") @db.Uuid
  rootMessageId     String?          @map("root_message_id") @db.Uuid
  projectId         String?          @map("project_id") @db.Uuid
  knowledgeSpaceId  String?          @map("knowledge_space_id") @db.Uuid
  heartbeatSequence BigInt           @map("heartbeat_sequence")
  lastSeenAt        DateTime         @map("last_seen_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel           Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  thread            Thread?          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  rootMessage       Message?         @relation("PushSurfaceReplyRoot", fields: [rootMessageId], references: [id], onDelete: Cascade)
  project           Project?         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  knowledgeSpace    KnowledgeSpace?  @relation(fields: [knowledgeSpaceId], references: [id], onDelete: Cascade)

  @@unique([userId, clientId])
  @@index([organizationId, userId, surfaceKind, channelId, lastSeenAt], map: "idx_push_presence_channel")
  @@index([organizationId, userId, surfaceKind, channelId, threadId, lastSeenAt], map: "idx_push_presence_thread")
  @@index([organizationId, userId, surfaceKind, channelId, threadId, rootMessageId, lastSeenAt], map: "idx_push_presence_reply_root")
  @@index([organizationId, userId, surfaceKind, projectId, lastSeenAt], map: "idx_push_presence_project")
  @@index([organizationId, userId, surfaceKind, knowledgeSpaceId, lastSeenAt], map: "idx_push_presence_knowledge_space")
  @@index([userId, lastSeenAt])
  @@map("user_push_surface_presence")
}

model UserStatus {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  userId            String               @map("user_id") @db.Uuid
  label             String
  emoji             String?
  isActive          Boolean              @default(false) @map("is_active")
  agentEnabled      Boolean              @default(false) @map("agent_enabled")
  agentInstructions String?              @map("agent_instructions")
  createdAt         DateTime             @default(now()) @map("created_at")
  updatedAt         DateTime             @updatedAt @map("updated_at")
  organization      Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  schedules         UserStatusSchedule[]
  rules             UserStatusRule[]

  @@index([organizationId, userId])
  @@index([userId, isActive])
  @@map("user_statuses")
}

model UserStatusSchedule {
  id        String                 @id @default(uuid()) @db.Uuid
  statusId  String                 @map("status_id") @db.Uuid
  kind      UserStatusScheduleKind
  label     String?
  enabled   Boolean                @default(true)
  startsAt  DateTime?              @map("starts_at")
  endsAt    DateTime?              @map("ends_at")
  dayOfWeek Int?                   @map("day_of_week")
  startTime String?                @map("start_time")
  endTime   String?                @map("end_time")
  timezone  String                 @default("UTC")
  createdAt DateTime               @default(now()) @map("created_at")
  updatedAt DateTime               @updatedAt @map("updated_at")
  status    UserStatus             @relation(fields: [statusId], references: [id], onDelete: Cascade)

  @@index([statusId])
  @@index([kind, enabled])
