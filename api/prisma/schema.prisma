model ModelPricingProfile {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  provider               String
  modelPattern           String        @map("model_pattern")
  currency               String        @default("USD")
  source                 PricingSource
  inputPerMillion        Float?        @map("input_per_million")
  outputPerMillion       Float?        @map("output_per_million")
  cachedInputPerMillion  Float?        @map("cached_input_per_million")
  cachedOutputPerMillion Float?        @map("cached_output_per_million")
  cacheReadPerMillion    Float?        @map("cache_read_per_million")
  cacheWritePerMillion   Float?        @map("cache_write_per_million")
  effectiveFrom          DateTime      @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime?     @map("effective_to") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at")
