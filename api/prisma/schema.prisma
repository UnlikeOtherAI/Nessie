model Agent {
  id                             String                          @id @default(uuid()) @db.Uuid
  name                           String
  role                           String                          @default("assistant")
  status                         AgentStatus                     @default(idle)
  agentKind                      AgentKind                       @default(shared) @map("agent_kind")
  systemManaged                  Boolean                         @default(false) @map("system_managed")
  /// The global-agent blueprint this row instantiates ('agent-designer', ...).
  /// One row per organisation per slug, and a database CHECK requires
  /// `systemManaged` + a non-null `organizationId` alongside it, so a cross-org
  /// or user-authored row carrying a slug cannot exist. This is the
  /// discriminator `ensureGlobalAgent` keys on — never the display name, which
  /// is what made the Librarian's bootstrap fragile — and the structural way
  /// the worker knows which blueprint a run belongs to.
  systemSlug                     String?                         @map("system_slug")
  surfacePolicy                  AgentSurfacePolicy              @default(shared) @map("surface_policy")
  delegationMode                 AgentDelegationMode             @default(none) @map("delegation_mode")
  visibility                     AgentVisibility                 @default(team) @map("visibility")
  executionMode                  AgentExecutionMode              @default(inference) @map("execution_mode")
  effort                         AgentEffort                     @default(medium)
  systemPrompt                   String?                         @map("system_prompt")
  toolPolicy                     Json?                           @map("tool_policy")
  // Optional explicit per-run caps ({ maxTokens?, maxToolCalls?, maxIterations?,
  // maxWallclockMs?, maxCostCents? }). Absent key = that dimension is governed
  // only by the deployment backstop. `effort` no longer implies spend caps —
  // see docs/plans/2026-08-05-run-budgets-context-and-research-routing.md.
  runLimits                      Json?                           @map("run_limits")
  todosEnabled                   Boolean                         @default(false) @map("todos_enabled")
  /// The Gemini Live voice this agent speaks in on a call, as one of
  /// `GEMINI_LIVE_VOICES` (`packages/schemas/src/voice.ts`). NULL = the
  /// deployment default (`NESSIE_VOICE_GEMINI_VOICE`). Stored as text rather
  /// than an enum because the set is Google's, not ours: it changes when Google
  /// publishes a voice, and a migration per voice would be the wrong ceremony.
  voiceName                      String?                         @map("voice_name")
  /// How this agent talks to people, in the person's own words. Prompt text,
  /// never a preset id — the Agent Designer's dropdown only seeds the field.
  /// Reaches both the typed system prompt and the voice system instruction.
  speakingStyle                  String?                         @map("speaking_style")
  provider                       String?                         @map("provider")
  model                          String?                         @map("model")
  /// Set when this agent runs on its owner's personal subscription. The
  /// selection is an explicit pointer, never a parse of `provider`, because a
  /// person may link two accounts at the same provider and the two must be
  /// distinguishable at run resolution. `provider` still carries the
  /// `subscription/<key>` namespace so a value that escapes this branch fails
  /// closed (a `/` is illegal in a Ledger service id) instead of dispatching.
  modelSubscriptionId            String?                         @map("model_subscription_id") @db.Uuid
  routingProfileId               String?                         @map("routing_profile_id") @db.Uuid
  avatarAttachmentId             String?                         @map("avatar_attachment_id") @db.Uuid
  avatarBackgroundColor          String?                         @map("avatar_background_color")
  parentAgentId                  String?                         @map("parent_agent_id") @db.Uuid
  /// Stewardship — the person this agent belongs to, their "virtual employee".
  /// NOT the same concept as `Task.ownerUserId`, which is work assignment.
  /// NULL means unowned (org-level), which is a rendered category, not an error.
  ///
  /// The composite relation to OrganizationMember enforces TENANCY at the
  /// storage boundary: the owner must be a member of THIS agent's organization,
  /// which a bare User FK cannot express and which matters because
  /// `spawn_subtask` writes agents outside the shared creation chokepoint.
  /// It does NOT prove the membership is live — deactivated rows are retained
  /// deliberately — so every read re-derives `deactivatedAt: null` instead of
  /// trusting the pointer. See docs/plans/2026-08-29-people-and-their-agents.md.
  ownerUserId                    String?                         @map("owner_user_id") @db.Uuid
  /// Intentionally nullable and without an Organization FK: system / personal-
  /// assistant agents may be global (no owning org). Do not "fix" to required.
  organizationId                 String?                         @map("organization_id") @db.Uuid
  projectId                      String?                         @map("project_id") @db.Uuid
  teamId                         String?                         @map("team_id") @db.Uuid
  createdAt                      DateTime                        @default(now()) @map("created_at")
  updatedAt                      DateTime                        @updatedAt @map("updated_at")
  parentAgent                    Agent?                          @relation("AgentHierarchy", fields: [parentAgentId], references: [id], onDelete: SetNull)
  childAgents                    Agent[]                         @relation("AgentHierarchy")
  avatarAttachment               Attachment?                     @relation("AgentAvatar", fields: [avatarAttachmentId], references: [id], onDelete: SetNull)
  bindings                       AgentBinding[]
  scopeDisclosureGrants          ScopeDisclosureGrant[]
  routingProfile                 InferenceRoutingProfile?        @relation(fields: [routingProfileId], references: [id], onDelete: SetNull)
  messages                       Message[]
  reactions                      MessageReaction[]
  runs                           Run[]
  triggers                       AgentTrigger[]
  tasks                          Task[]                          @relation("AgentRunTasks")
  assignedTasks                  Task[]                          @relation("AgentAssignedTasks")
  approvalRequests               ApprovalRequest[]
  plans                          Plan[]
  resourceLocks                  ResourceLock[]
  toolGrants                     ToolGrant[]
  statusRules                    UserStatusRule[]
  workflowStepRuns               WorkflowStepRun[]               @relation("WorkflowStepAssignedAgent")
  executionEnvironmentInstances  ExecutionEnvironmentInstance[]
  executorPrivateAssignments     ExecutorPrivateAssignment[]     @relation("ExecutorPrivateAssignmentAgent")
  executorOperationGrants        ExecutorAgentOperationGrant[]
  executorAvailabilityCandidates ExecutorAvailabilityCandidate[]
  knowledgeSpaceMemberships      KnowledgeSpaceMember[]          @relation("KnowledgeSpaceAgentMembers")
  docsSpaces                     KnowledgeSpace[]                @relation("AgentDocsSpaces")
  userAlertActivity              UserAlert[]
  callsCreatedVia                Call[]                          @relation("CallCreatedViaAgent")
  runThreadPendingMessages       RunThreadPendingMessage[]
  todoTemplates                  AgentTodoTemplate[]             @relation("AgentTodoTemplateAgent")
  todos                          AgentTodo[]                     @relation("AgentTodoAgent")
  demonstrations                 Demonstration[]                 @relation("AgentDemonstrations")
  demonstrationSteps             DemonstrationStep[]             @relation("AgentDemonstrationSteps")
  appConnectionRequests          AgentAppConnectionRequest[]
  handoffsMade                   AgentHandoffRequest[]           @relation("AgentHandoffFromAgent")
  handoffsReceived               AgentHandoffRequest[]           @relation("AgentHandoffTargetAgent")
  organization                   Organization?                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // NoAction, not the Prisma default SetNull: on a COMPOSITE foreign key
  // SET NULL blanks every referencing column, which would wipe the agent's
  // organizationId along with its owner. organization_members rows are never
  // deleted (deactivation is a reversible flag), so this never fires.
  ownerMembership                OrganizationMember?             @relation("AgentOwner", fields: [organizationId, ownerUserId], references: [organizationId, userId], onDelete: NoAction, onUpdate: NoAction)
  /// SetNull, not Cascade: disconnecting a subscription must never delete the
  /// agent. The run-time gate then fails closed on the dangling selection and
  /// names the remedy, which is the behaviour a person expects.
  modelSubscription              ModelSubscription?              @relation(fields: [modelSubscriptionId], references: [id], onDelete: SetNull)

  agentCards AgentCard[]
  mailbox    AgentMailbox?

  cloudBrowserSessions    CloudBrowserSession[]
  agentBrowsers           AgentBrowser[]
  sendAuthorizationGrants SendAuthorizationGrant[]
  mailboxAccess           MailboxConnectionAgentAccess[]

  @@unique([organizationId, id])
  @@unique([organizationId, systemSlug])
  @@index([organizationId])
  @@index([organizationId, projectId])
  @@index([avatarAttachmentId])
  @@index([organizationId, agentKind, systemManaged])
  @@index([routingProfileId])
  // "which agents does this person steward" — the first non-channel-derived
  // agent read, and the tree's level-3 query.
  @@index([organizationId, ownerUserId])
  @@index([organizationId, visibility, ownerUserId], map: "agents_org_visibility_owner_idx")
  @@map("agents")
}

