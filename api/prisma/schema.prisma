model OrganizationMember {
  id                      String                   @id @default(uuid()) @db.Uuid
  organizationId          String                   @map("organization_id") @db.Uuid
  userId                  String                   @map("user_id") @db.Uuid
  role                    MemberRole               @default(member)
  // When set, the membership is deactivated: the user is denied access to this
  // organisation (enforced in authenticateRequest) but the row + audit history
  // are kept so an owner can reactivate. Reversible — no hard delete.
  deactivatedAt           DateTime?                @map("deactivated_at")
  createdAt               DateTime                 @default(now()) @map("created_at")
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user                    User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Agents this member stewards. Tenancy only — a retained deactivated row
  /// still satisfies the FK, so readers re-derive liveness.
  ownedAgents             Agent[]                  @relation("AgentOwner")
  /// Personal model subscriptions this member has linked. Same tenancy-only
  /// contract as `ownedAgents`: liveness is re-derived, never assumed.
  modelSubscriptions      ModelSubscription[]      @relation("ModelSubscriptionOwner")
  /// Personal Browserbase connections. Tenancy only, exactly as `ownedAgents`.
  cloudBrowserConnections CloudBrowserConnection[] @relation("CloudBrowserConnectionOwner")
  scopedSettings          ScopedSetting[]            @relation("ScopedSettingOwner")
  agentBrowserLogins      AgentBrowserLogin[]      @relation("AgentBrowserLoginMember")
  /// Personal SMTP/IMAP mailboxes. Tenancy only, exactly as `ownedAgents`.
  mailboxConnections      MailboxConnection[]      @relation("MailboxConnectionOwner")

  @@unique([organizationId, userId])
  @@map("organization_members")
}

