/// This model documents the raw-SQL queue table so Prisma Migrate stays in sync
/// with the development database. Queue polling and dequeue remain SQL-backed.
model QueueJob {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  topic          String
  payload        Json
  status         String    @default("pending")
  idempotencyKey String?   @map("idempotency_key")
  attempt        Int       @default(0)
  maxAttempts    Int       @default(3) @map("max_attempts")
  lockedUntil    DateTime? @map("locked_until") @db.Timestamptz(6)
  enqueuedAt     DateTime  @default(now()) @map("enqueued_at") @db.Timestamptz(6)
  startedAt      DateTime? @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  errorMessage   String?   @map("error_message")

  @@unique([idempotencyKey])
  @@index([status, enqueuedAt])
  /// Partial poll index `idx_queue_jobs_poll` on (topic, status, locked_until)
  /// WHERE status IN ('pending','processing') exists in the DB (created in
  /// 20260408000223_phase1_step1_init). Prisma cannot express partial indexes,
  /// so it is managed purely in raw SQL; 20260530170500_recreate_queue_poll_index
  /// recreates it idempotently. Prisma may still report it as drift — this is a
  /// known limitation, not a missing index.
  @@map("queue_jobs")
}

