generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  idle
  thinking
  executing
  waiting_approval
  error
  offline
}

enum AgentKind {
  shared
  personal_assistant
}

enum AgentSurfacePolicy {
  shared
  dm_only
}

enum AgentDelegationMode {
  none
  act_as_requesting_user
}

enum RunStatus {
  pending
  running
  waiting_approval
  completed
  failed
  cancelled
}

enum AgentTriggerType {
  manual
  scheduled
  webhook
  event
  interval
}

enum AgentTriggerStatus {
  active
  paused
  error
}

enum AgentTriggerDeliveryStatus {
  pending
  delivered
  failed
  skipped
}

enum PlanStatus {
  draft
  active
  waiting
  completed
  failed
  cancelled
}

enum PlanStepStatus {
  pending
  running
  completed
  failed
  skipped
  blocked
}

enum MailboxMessageStatus {
  queued
  processing
  delivered
  dead_letter
}

enum WorkflowInstallationStatus {
  draft
  active
  paused
  disabled
}

enum WorkflowRunStatus {
  pending
  running
  completed
  failed
  cancelled
}

enum WorkflowStepRunStatus {
  pending
  running
  completed
  failed
  skipped
  blocked
}

enum ExecutionProvider {
  docker
  gcloud
}

enum ExecutionMode {
  container
  vm
  function
}

enum ExecutionEnvironmentInstanceStatus {
  pending
  provisioning
  ready
  failed
  terminated
}

enum ExecutionRunnerStatus {
  active
  draining
  offline
}

enum ExecutionLeaseStatus {
  issued
  acknowledged
  completed
  revoked
  expired
}

enum ResourceLockType {
  exclusive
  shared
}

enum TaskStatus {
  inbox
  assigned
  in_progress
  review
  done
  failed
  cancelled
  awaiting_approval
}

enum ChannelType {
  standard
  dm
}

enum ChannelSystemType {
  personal_assistant
}

enum ChannelVisibility {
  public
  protected
  private
}

enum MessageRole {
  user
  assistant
  system
}

// ─── Phase 2 Enums ──────────────────────────────────────────────────────────

enum PolicyScope {
  organization
  project
  team
  channel
  agent
  tool
  user
}

enum PolicyResourceType {
  agent
  channel
  project
  tool
  session
  task
  review
  approval
  admin
  secret
}

enum PolicyAction {
  view
  invoke
  create
  edit
  assign
  approve
  review
  search
  export_action @map("export")
  admin
  resolve
  rotate
  revoke
  bind
  link
  reindex
  summarize
  read
  import_action @map("import")
  grant
  enroll
  challenge
}

enum PolicyEffect {
  allow
  deny
}

enum ApprovalStatus {
  pending
  approved
  rejected
  expired
}

enum AuditActorType {
  user
  agent
  service
  system
}

enum AuditOutcome {
  success
  denied
  error
}

enum PricingSource {
  provider_default @map("provider-default")
  org_override     @map("org-override")
  team_override    @map("team-override")
  manual
}

enum OperationType {
  chat
  completion
  embedding
  translation
  reasoning
  tool_translation @map("tool-translation")
  other
}

enum InferenceConnectorKind {
  compiled
  openai_compatible @map("openai-compatible")
}

enum InferenceLifecycleStatus {
  draft
  approved
  deprecated
}

enum InferenceHealthStatus {
  healthy
  degraded
  unreachable
  unknown
}

enum InferenceCapabilitySource {
  static
  live
  manual
}

enum InferenceExposure {
  standard
  admin_only @map("admin-only")
}

enum InferenceRoutingMode {
  single
  fallback
  committee
  pipeline
  shadow
}

enum InferenceStageRole {
  advisor
  executor
  synthesizer
  judge
  shadow
}

enum InferenceStreamPolicy {
  primary_only   @map("primary-only")
  buffered_judge @map("buffered-judge")
}

enum InferenceEvalStatus {
  queued
  running
  completed
  failed
  cancelled
}

// ─── Memory Enums ───────────────────────────────────────────────────────────

enum ThoughtOwnerType {
  user
  agent
  service
}

enum ThoughtVisibility {
  private
  channel
  team
  project
  organization
}

enum ThoughtAudienceType {
  user
  channel
  team
  project
  organization
}

enum SensitivityTier {
  normal
  sensitive
  restricted
}

enum ReasoningType {
  decision
  evaluation
  constraint
  pattern
  correction
  validation
}

enum OutcomeStatus {
  pending
  successful
  partially
  failed
  superseded
}

enum ThoughtLinkRelation {
  supersedes
  derived_from
  contradicts
  supports
  relates_to
}

// ─── MCP Universal Connector Enums ──────────────────────────────────────────

enum McpCatalogProtocol {
  stdio
  http
  sse
  ws
}

enum McpCatalogAuthMethod {
  api_key
  bearer
  basic
  oauth2
  none
}

enum McpCatalogStatus {
  draft
  pending_approval
  published
  rejected
  deprecated
}

enum McpCatalogVisibility {
  private
  public
}

enum McpServerScopeType {
  system
  organization
  project
  team
  channel
  user
}

enum McpServerLifecycleState {
  pending_setup
  active
  paused
  error
}

enum McpCredentialPrincipalType {
  user
  agent
  channel
  team
  project
  organization
}

enum ToolRegistrySource {
  builtin
  custom
  mcp_remote          @map("mcp-remote")
  interactive_session @map("interactive-session")
}

enum ToolRegistryTransport {
  direct
  mcp
  http
  stdio
  pty
}

enum ToolRegistryEntryStatus {
  active
  pending_review
  disabled
}

enum ToolBundleStatus {
  pending_review
  approved
  rejected
  disabled
}

enum ToolGrantState {
  inherit
  allowed
  denied
}

enum ToolGrantSource {
  role
  agent_override @map("agent-override")
}

model User {
  id                  String               @id @default(uuid()) @db.Uuid
  email               String               @unique
  displayName         String               @map("display_name")
  passwordHash        String?              @map("password_hash")
  avatarUrl           String?              @map("avatar_url")
  pronouns            String?
  preferences         Json?
  createdAt           DateTime             @default(now()) @map("created_at")
  updatedAt           DateTime             @updatedAt @map("updated_at")
  organizationMembers OrganizationMember[]
  projectMembers      ProjectMember[]
  teamMembers         TeamMember[]
  channelMembers      ChannelMember[]
  callsStarted        Call[]               @relation("CallStarter")
  callParticipants    CallParticipant[]    @relation("CallParticipation")
  messages            Message[]
  reactions           MessageReaction[]
  threadReadStates    ThreadReadState[]
  assignedTasks       Task[]               @relation("TaskAssignee")
  ownedTasks          Task[]               @relation("TaskOwner")
  createdTasks        Task[]               @relation("TaskCreatedBy")

  @@map("users")
}

model Organization {
  id        String               @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime             @default(now()) @map("created_at")
  updatedAt DateTime             @updatedAt @map("updated_at")
  members   OrganizationMember[]
  projects  Project[]
  channels  Channel[]
  thoughts  Thought[]
  tasks     Task[]

  @@map("organizations")
}

model OrganizationMember {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  role           String       @default("member")
  createdAt      DateTime     @default(now()) @map("created_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@map("organization_members")
}

model Project {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  organizationId String          @map("organization_id") @db.Uuid
  createdAt      DateTime        @default(now()) @map("created_at")
  updatedAt      DateTime        @updatedAt @map("updated_at")
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  teams          Team[]

  @@map("projects")
}

model ProjectMember {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Team {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  projectId     String       @map("project_id") @db.Uuid
  systemManaged Boolean      @default(false) @map("system_managed")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")
  project       Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members       TeamMember[]
  channels      Channel[]

  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid()) @db.Uuid
  teamId    String   @map("team_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("team_members")
}

model Channel {
  id                String             @id @default(uuid()) @db.Uuid
  label             String
  type              ChannelType        @default(standard)
  systemChannelType ChannelSystemType? @map("system_channel_type")
  organizationId    String             @map("organization_id") @db.Uuid
  teamId            String             @map("team_id") @db.Uuid
  visibility        ChannelVisibility  @default(public)
  dmKey             String?            @unique @map("dm_key")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  organization      Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  team              Team               @relation(fields: [teamId], references: [id], onDelete: Cascade)
  members           ChannelMember[]
  calls             Call[]
  agentBindings     AgentBinding[]
  triggerTargets    AgentTrigger[]     @relation("TriggerTargetChannel")
  threads           Thread[]

  @@index([organizationId, type])
  @@map("channels")
}

model ChannelMember {
  id        String   @id @default(uuid()) @db.Uuid
  channelId String   @map("channel_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  channel   Channel  @relation(fields: [channelId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([channelId, userId])
  @@index([userId])
  @@map("channel_members")
}

model Thread {
  id              String                @id @default(uuid()) @db.Uuid
  channelId       String                @map("channel_id") @db.Uuid
  title           String?
  createdAt       DateTime              @default(now()) @map("created_at")
  updatedAt       DateTime              @updatedAt @map("updated_at")
  channel         Channel               @relation(fields: [channelId], references: [id], onDelete: Cascade)
  mailboxMessages AgentMailboxMessage[]
  messages        Message[]
  readStates      ThreadReadState[]
  runs            Run[]
  streamEvents    ThreadStreamEvent[]
  triggerTargets  AgentTrigger[]        @relation("TriggerTargetThread")

  @@index([channelId, createdAt])
  @@map("threads")
}

model ThreadReadState {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastReadAt DateTime @map("last_read_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_read_states")
}

model ThreadStreamEvent {
  id        BigInt   @id @default(autoincrement())
  threadId  String   @map("thread_id") @db.Uuid
  eventName String   @map("event_name")
  data      Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, id], map: "idx_thread_stream_events_replay")
  @@map("thread_stream_events")
}

model Message {
  id        String            @id @default(uuid()) @db.Uuid
  threadId  String            @map("thread_id") @db.Uuid
  agentId   String?           @map("agent_id") @db.Uuid
  userId    String?           @map("user_id") @db.Uuid
  role      MessageRole
  content   String
  metadata  Json?             @default("{}")
  createdAt DateTime          @default(now()) @map("created_at")
  thread    Thread            @relation(fields: [threadId], references: [id], onDelete: Cascade)
  agent     Agent?            @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user      User?             @relation(fields: [userId], references: [id], onDelete: SetNull)
  reactions MessageReaction[]

  @@index([threadId, createdAt])
  @@index([agentId, createdAt])
  @@map("messages")
}

model MessageReaction {
  id        String   @id @default(uuid()) @db.Uuid
  messageId String   @map("message_id") @db.Uuid
  agentId   String?  @map("agent_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  emoji     String
  createdAt DateTime @default(now()) @map("created_at")
  message   Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  agent     Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([messageId, agentId, emoji])
  @@unique([messageId, userId, emoji])
  @@index([messageId])
  @@map("message_reactions")
}

model Agent {
  id                            String                         @id @default(uuid()) @db.Uuid
  name                          String
  role                          String                         @default("assistant")
  status                        AgentStatus                    @default(idle)
  agentKind                     AgentKind                      @default(shared) @map("agent_kind")
  systemManaged                 Boolean                        @default(false) @map("system_managed")
  surfacePolicy                 AgentSurfacePolicy             @default(shared) @map("surface_policy")
  delegationMode                AgentDelegationMode            @default(none) @map("delegation_mode")
  systemPrompt                  String?                        @map("system_prompt")
  toolPolicy                    Json?                          @map("tool_policy")
  provider                      String?                        @map("provider")
  model                         String?                        @map("model")
  routingProfileId              String?                        @map("routing_profile_id") @db.Uuid
  parentAgentId                 String?                        @map("parent_agent_id") @db.Uuid
  organizationId                String?                        @map("organization_id") @db.Uuid
  projectId                     String?                        @map("project_id") @db.Uuid
  teamId                        String?                        @map("team_id") @db.Uuid
  createdAt                     DateTime                       @default(now()) @map("created_at")
  updatedAt                     DateTime                       @updatedAt @map("updated_at")
  parentAgent                   Agent?                         @relation("AgentHierarchy", fields: [parentAgentId], references: [id], onDelete: SetNull)
  childAgents                   Agent[]                        @relation("AgentHierarchy")
  bindings                      AgentBinding[]
  routingProfile                InferenceRoutingProfile?       @relation(fields: [routingProfileId], references: [id], onDelete: SetNull)
  messages                      Message[]
  reactions                     MessageReaction[]
  runs                          Run[]
  triggers                      AgentTrigger[]
  tasks                         Task[]
  approvalRequests              ApprovalRequest[]
  workflowStepRuns              WorkflowStepRun[]              @relation("WorkflowStepAssignedAgent")
  executionEnvironmentInstances ExecutionEnvironmentInstance[]

  @@index([organizationId])
  @@index([organizationId, projectId])
  @@index([organizationId, agentKind, systemManaged])
  @@index([routingProfileId])
  @@map("agents")
}

model InferenceProvider {
  id                        String                        @id @default(uuid()) @db.Uuid
  organizationId            String                        @map("organization_id") @db.Uuid
  providerKey               String                        @map("provider_key")
  connectorKind             InferenceConnectorKind        @map("connector_kind")
  displayName               String                        @map("display_name")
  enabled                   Boolean                       @default(false)
  lifecycleStatus           InferenceLifecycleStatus      @default(draft) @map("lifecycle_status")
  baseUrl                   String?                       @map("base_url")
  supportsModelDiscovery    Boolean                       @default(true) @map("supports_model_discovery")
  activeCredentialBindingId String?                       @unique @map("active_credential_binding_id") @db.Uuid
  healthStatus              InferenceHealthStatus         @default(unknown) @map("health_status")
  lastCheckedAt             DateTime?                     @map("last_checked_at")
  createdByActorId          String                        @map("created_by_actor_id")
  updatedByActorId          String                        @map("updated_by_actor_id")
  approvedByActorId         String?                       @map("approved_by_actor_id")
  approvedAt                DateTime?                     @map("approved_at")
  createdAt                 DateTime                      @default(now()) @map("created_at")
  updatedAt                 DateTime                      @updatedAt @map("updated_at")
  activeCredentialBinding   InferenceCredentialBinding?   @relation("ProviderActiveCredentialBinding", fields: [activeCredentialBindingId], references: [id], onDelete: SetNull)
  credentialBindings        InferenceCredentialBinding[]  @relation("ProviderCredentialBindings")
  models                    InferenceModel[]
  capabilityOverrides       InferenceCapabilityOverride[]

  @@index([organizationId, providerKey])
  @@index([organizationId, enabled, lifecycleStatus])
  @@index([organizationId, healthStatus])
  @@map("inference_providers")
}

model InferenceCredentialBinding {
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @map("organization_id") @db.Uuid
  providerId        String             @map("provider_id") @db.Uuid
  label             String
  authSecretRef     String             @map("auth_secret_ref")
  createdByActorId  String             @map("created_by_actor_id")
  revokedAt         DateTime?          @map("revoked_at")
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  provider          InferenceProvider  @relation("ProviderCredentialBindings", fields: [providerId], references: [id], onDelete: Cascade)
  activeForProvider InferenceProvider? @relation("ProviderActiveCredentialBinding")

  @@unique([providerId, label])
  @@index([organizationId, providerId, createdAt(sort: Desc)])
  @@map("inference_credential_bindings")
}

model InferenceModel {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  providerId         String                    @map("provider_id") @db.Uuid
  model              String
  displayName        String?                   @map("display_name")
  enabled            Boolean                   @default(false)
  lifecycleStatus    InferenceLifecycleStatus  @default(draft) @map("lifecycle_status")
  capabilitySnapshot Json                      @default("{}") @map("capability_snapshot_json")
  source             InferenceCapabilitySource @default(static)
  discoveredAt       DateTime                  @default(now()) @map("discovered_at")
  lastVerifiedAt     DateTime?                 @map("last_verified_at")
  createdByActorId   String                    @map("created_by_actor_id")
  updatedByActorId   String                    @map("updated_by_actor_id")
  approvedByActorId  String?                   @map("approved_by_actor_id")
  approvedAt         DateTime?                 @map("approved_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  provider           InferenceProvider         @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, model])
  @@index([organizationId, providerId, enabled, lifecycleStatus])
  @@map("inference_models")
}

model InferenceCapabilityOverride {
  id                String                   @id @default(uuid()) @db.Uuid
  organizationId    String                   @map("organization_id") @db.Uuid
  providerId        String                   @map("provider_id") @db.Uuid
  model             String
  lifecycleStatus   InferenceLifecycleStatus @default(draft) @map("lifecycle_status")
  overrideSnapshot  Json                     @default("{}") @map("override_snapshot_json")
  createdByActorId  String                   @map("created_by_actor_id")
  updatedByActorId  String                   @map("updated_by_actor_id")
  createdAt         DateTime                 @default(now()) @map("created_at")
  clearedAt         DateTime?                @map("cleared_at")
  approvedByActorId String?                  @map("approved_by_actor_id")
  approvedAt        DateTime?                @map("approved_at")
  updatedAt         DateTime                 @updatedAt @map("updated_at")
  provider          InferenceProvider        @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([providerId, model])
  @@index([organizationId, providerId, lifecycleStatus])
  @@map("inference_capability_overrides")
}

model ToolMediatorProfile {
  id                 String                    @id @default(uuid()) @db.Uuid
  organizationId     String                    @map("organization_id") @db.Uuid
  label              String
  enabled            Boolean                   @default(false)
  lifecycleStatus    InferenceLifecycleStatus  @default(draft) @map("lifecycle_status")
  translatorProvider String                    @map("translator_provider")
  translatorModel    String                    @map("translator_model")
  mediatorConfig     Json                      @default("{}") @map("mediator_config_json")
  createdByActorId   String                    @map("created_by_actor_id")
  updatedByActorId   String                    @map("updated_by_actor_id")
  approvedByActorId  String?                   @map("approved_by_actor_id")
  approvedAt         DateTime?                 @map("approved_at")
  createdAt          DateTime                  @default(now()) @map("created_at")
  updatedAt          DateTime                  @updatedAt @map("updated_at")
  routingProfiles    InferenceRoutingProfile[]

  @@unique([organizationId, label])
  @@index([organizationId, enabled, lifecycleStatus])
  @@map("tool_mediator_profiles")
}

model InferenceRoutingProfile {
  id                    String                   @id @default(uuid()) @db.Uuid
  organizationId        String                   @map("organization_id") @db.Uuid
  label                 String
  enabled               Boolean                  @default(false)
  exposure              InferenceExposure        @default(standard)
  lifecycleStatus       InferenceLifecycleStatus @default(draft) @map("lifecycle_status")
  mode                  InferenceRoutingMode
  streamPolicy          InferenceStreamPolicy    @default(primary_only) @map("stream_policy")
  toolMediatorProfileId String?                  @map("tool_mediator_profile_id") @db.Uuid
  routeGraph            Json                     @default("{}") @map("route_graph_json")
  createdByActorId      String                   @map("created_by_actor_id")
  updatedByActorId      String                   @map("updated_by_actor_id")
  approvedByActorId     String?                  @map("approved_by_actor_id")
  approvedAt            DateTime?                @map("approved_at")
  createdAt             DateTime                 @default(now()) @map("created_at")
  updatedAt             DateTime                 @updatedAt @map("updated_at")
  toolMediatorProfile   ToolMediatorProfile?     @relation(fields: [toolMediatorProfileId], references: [id], onDelete: SetNull)
  agents                Agent[]
  targetEvalSuites      InferenceEvalSuite[]     @relation("EvalSuiteTargetRoute")
  judgeEvalSuites       InferenceEvalSuite[]     @relation("EvalSuiteJudgeRoute")

  @@unique([organizationId, label])
  @@index([organizationId, enabled, lifecycleStatus])
  @@index([organizationId, exposure, lifecycleStatus])
  @@map("inference_routing_profiles")
}

model InferenceEvalSuite {
  id                     String                   @id @default(uuid()) @db.Uuid
  organizationId         String                   @map("organization_id") @db.Uuid
  label                  String
  exposure               InferenceExposure        @default(standard)
  enabled                Boolean                  @default(false)
  datasetRef             Json                     @map("dataset_ref_json")
  targetRoutingProfileId String                   @map("target_routing_profile_id") @db.Uuid
  judgeRoutingProfileId  String?                  @map("judge_routing_profile_id") @db.Uuid
  lifecycleStatus        InferenceLifecycleStatus @default(draft) @map("lifecycle_status")
  createdByActorId       String                   @map("created_by_actor_id")
  updatedByActorId       String                   @map("updated_by_actor_id")
  approvedByActorId      String?                  @map("approved_by_actor_id")
  approvedAt             DateTime?                @map("approved_at")
  createdAt              DateTime                 @default(now()) @map("created_at")
  updatedAt              DateTime                 @updatedAt @map("updated_at")
  targetRoutingProfile   InferenceRoutingProfile  @relation("EvalSuiteTargetRoute", fields: [targetRoutingProfileId], references: [id], onDelete: Restrict)
