  catalogEntry           McpCatalogEntry               @relation(fields: [catalogEntryId], references: [id], onDelete: Cascade)
  credentialOverrides    McpServerCredentialOverride[]
  toolRegistryEntries    ToolRegistryEntry[]
  productIntegrationRuns ProductIntegrationRun[]
  appConnectionRequests  AgentAppConnectionRequest[]
  organization           Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([catalogEntryId, scopeType, scopeId])
  @@index([organizationId, scopeType, scopeId])
  @@index([organizationId, lifecycleState])
  @@map("mcp_server_instances")
}

model McpServerCredentialOverride {
