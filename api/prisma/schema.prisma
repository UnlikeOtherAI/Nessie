  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  projectId      String?        @map("project_id") @db.Uuid
  teamId         String?        @map("team_id") @db.Uuid
  channelId      String?        @map("channel_id") @db.Uuid
  actorType      AuditActorType @map("actor_type")
  actorId        String         @map("actor_id")
  action         String
  resourceType   String         @map("resource_type")
  resourceId     String?        @map("resource_id")
  outcome        AuditOutcome
  reason         String?
  metadata       Json?
  requestId      String         @map("request_id")
  ipAddress      String?        @map("ip_address")
  userAgent      String?        @map("user_agent")
  createdAt      DateTime       @default(now()) @map("created_at")
  // Tamper-evident per-organization SHA-256 hash chain. Nullable: rows written
  // before the chain existed are a pre-chain epoch (both null); the chain starts
  // at the first new row per org (genesis: prevHash = null). See
  // @nessie/db audit-chain.ts and docs/functionality.md §Audit trail.
  prevHash       String?        @map("prev_hash")
  entryHash      String?        @map("entry_hash")

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, action, createdAt(sort: Desc)])
  @@index([organizationId, actorId, createdAt(sort: Desc)])
  @@index([organizationId, resourceType, resourceId])
  // Serves listAuditLog's resourceType filter + createdAt-desc ordering
  // (audit.ts): the resourceType/resourceId index above cannot satisfy the sort.
  @@index([organizationId, resourceType, createdAt(sort: Desc)])
  @@map("audit_logs")
}

/// Compliance note: token_ledger_events INTENTIONALLY has no Organization FK on
/// organization_id. Ledger rows must survive organization deletion for billing /
/// audit retention, so org deletes must not cascade them away. Do not add a FK.
model TokenLedgerEvent {
  id                    String             @id @default(uuid()) @db.Uuid
  occurredAt            DateTime           @map("occurred_at") @db.Timestamptz(6)
  /// Stable per-inference idempotency key. The write path
  /// (worker persistInvocationLedgerEvents) sets this from the inference
  /// invocation id; a unique constraint + skipDuplicates makes redelivery after
  /// a crash a no-op instead of double-counting cost. Nullable for legacy rows.
  inferenceInvocationId String?            @unique @map("inference_invocation_id")
  organizationId        String             @map("organization_id") @db.Uuid
  userId                String?            @map("user_id") @db.Uuid
  projectId             String?            @map("project_id") @db.Uuid
  teamId                String?            @map("team_id") @db.Uuid
  channelId             String?            @map("channel_id") @db.Uuid
  threadId              String?            @map("thread_id") @db.Uuid
  sessionId             String?            @map("session_id")
  taskId                String?            @map("task_id") @db.Uuid
  runId                 String?            @map("run_id") @db.Uuid
  agentId               String?            @map("agent_id") @db.Uuid
  actorId               String             @map("actor_id")
  actorType             AuditActorType?    @map("actor_type")
  requestId             String             @map("request_id")
  correlationId         String?            @map("correlation_id")
  provider              String
  model                 String
  providerId            String?            @map("provider_id") @db.Uuid
  modelId               String?            @map("model_id") @db.Uuid
  operationType         OperationType      @map("operation_type")
  inputTokens           Int?               @map("input_tokens")
  outputTokens          Int?               @map("output_tokens")
  cachedInputTokens     Int?               @map("cached_input_tokens")
  cachedOutputTokens    Int?               @map("cached_output_tokens")
  cacheReadTokens       Int?               @map("cache_read_tokens")
  cacheWriteTokens      Int?               @map("cache_write_tokens")
  totalTokens           Int?               @map("total_tokens")
  providerCostAmount    Decimal?           @map("provider_cost_amount") @db.Decimal(20, 8)
  providerCostCurrency  String?            @map("provider_cost_currency")
  pricingProfileId      String?            @map("pricing_profile_id") @db.Uuid
  pricingSource         PricingSource?     @map("pricing_source")
  pricingCurrency       String?            @map("pricing_currency")
  pricingInputPerM      Decimal?           @map("pricing_input_per_m") @db.Decimal(20, 8)
  pricingOutputPerM     Decimal?           @map("pricing_output_per_m") @db.Decimal(20, 8)
  estimatedCostAmount   Decimal?           @map("estimated_cost_amount") @db.Decimal(20, 8)
  estimatedCostCurrency String?            @map("estimated_cost_currency")
  metadata              Json?
  inferenceProvider     InferenceProvider? @relation(fields: [providerId], references: [id], onDelete: SetNull)
  inferenceModel        InferenceModel?    @relation(fields: [modelId], references: [id], onDelete: SetNull)

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, provider, model, occurredAt(sort: Desc)])
  @@index([organizationId, agentId, occurredAt(sort: Desc)])
  @@index([organizationId, userId, occurredAt(sort: Desc)])
  @@index([organizationId, actorId, occurredAt(sort: Desc)])
  @@index([organizationId, projectId, occurredAt(sort: Desc)])
  @@index([organizationId, teamId, occurredAt(sort: Desc)])
  @@index([organizationId, channelId, occurredAt(sort: Desc)])
  @@index([organizationId, runId, occurredAt(sort: Desc)])
  // Budget period sums query by project/team ALONE (scopeUsageWhere), so they
  // need indexes leading with project_id / team_id, not organization_id.
  @@index([projectId, occurredAt(sort: Desc)])
  @@index([teamId, occurredAt(sort: Desc)])
  @@map("token_ledger_events")
}

enum BudgetMode {
  off
  warn
  enforce
  degrade
  unlimited
}

enum BudgetScopeType {
  organization
  project
  team
}

enum BudgetPeriod {
  weekly
  monthly
  yearly
}

model Budget {
  id                   String          @id @default(uuid()) @db.Uuid
  organizationId       String          @map("organization_id") @db.Uuid
  scopeType            BudgetScopeType @map("scope_type")
  scopeId              String          @map("scope_id") @db.Uuid
  costLimitUsd         Decimal?        @map("cost_limit_usd") @db.Decimal(14, 4)
  tokenLimit           Int?            @map("token_limit")
  // Hard storage quota (bytes) for this scope. When set and exceeded, the
  // FileService blocks new uploads. Null = unlimited.
  storageLimitBytes    BigInt?         @map("storage_limit_bytes")
  mode                 BudgetMode      @default(off)
  period               BudgetPeriod    @default(monthly)
  warnThresholdPercent Int             @default(80) @map("warn_threshold_percent")
  blockHumansWhenOver  Boolean         @default(false) @map("block_humans_when_over")
  degradeModel         String?         @map("degrade_model")
  degradeProvider      String?         @map("degrade_provider")
  createdAt            DateTime        @default(now()) @map("created_at")
  updatedAt            DateTime        @updatedAt @map("updated_at")
  organization         Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([scopeType, scopeId])
  @@index([organizationId])
  @@map("budgets")
}

// Durable dedupe marker for budget alerts. One row per governing budget scope,
// period window, and alert kind ('threshold' when cumulative spend first crosses
// the warn threshold, 'blocked' when the gate first blocks a run). The unique
// constraint makes "notify at most once per budget per period per kind" atomic
// and crash-safe: the worker inserts with skipDuplicates and only the first
// inserter delivers the notification. organizationId is a scalar (no relation),
// matching the token_ledger_events pattern — this is append-only ops telemetry.
model BudgetAlert {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  scopeType      BudgetScopeType @map("scope_type")
  scopeId        String          @map("scope_id") @db.Uuid
  period         BudgetPeriod
  periodStart    DateTime        @map("period_start") @db.Timestamptz(6)
  kind           String
  percentUsed    Int?            @map("percent_used")
  spentUsd       Decimal?        @map("spent_usd") @db.Decimal(14, 4)
  costLimitUsd   Decimal?        @map("cost_limit_usd") @db.Decimal(14, 4)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@unique([scopeType, scopeId, periodStart, kind])
  @@index([organizationId, createdAt])
  @@map("budget_alerts")
}

model ModelPricingProfile {
  id                     String        @id @default(uuid()) @db.Uuid
  organizationId         String        @map("organization_id") @db.Uuid
  provider               String
  modelPattern           String        @map("model_pattern")
  currency               String        @default("USD")
  source                 PricingSource
  inputPerMillion        Decimal?      @map("input_per_million") @db.Decimal(20, 8)
  outputPerMillion       Decimal?      @map("output_per_million") @db.Decimal(20, 8)
  cachedInputPerMillion  Decimal?      @map("cached_input_per_million") @db.Decimal(20, 8)
  cachedOutputPerMillion Decimal?      @map("cached_output_per_million") @db.Decimal(20, 8)
  cacheReadPerMillion    Decimal?      @map("cache_read_per_million") @db.Decimal(20, 8)
  cacheWritePerMillion   Decimal?      @map("cache_write_per_million") @db.Decimal(20, 8)
  effectiveFrom          DateTime      @map("effective_from") @db.Timestamptz(6)
  effectiveTo            DateTime?     @map("effective_to") @db.Timestamptz(6)
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@index([organizationId, provider, modelPattern])
  /// At most one ACTIVE profile per (organizationId, provider, modelPattern):
  /// enforced by partial unique index `model_pricing_profiles_active_unique`
  /// WHERE effective_to IS NULL (raw SQL, see
  /// 20260530170600_pricing_profile_active_unique). This makes the active-row
  /// lookup in findPricingProfile deterministic.
  @@map("model_pricing_profiles")
}

enum ConnectorType {
  mcp
  http
  web_search
  web_fetch
  storage
  push
  github
  oauth
  other
}

// Per-call usage ledger for non-AI third-party connectors (MCP servers, HTTP
// tools, web search/fetch, push, storage, GitHub, OAuth). Sibling to
// TokenLedgerEvent: same attribution dimensions (who / where-from), but counts
// calls + units instead of tokens. Written by recordConnectorUsage
// (@nessie/runtime) at the runtime dispatch site.
model ConnectorUsageEvent {
  id             String         @id @default(uuid()) @db.Uuid
  occurredAt     DateTime       @map("occurred_at") @db.Timestamptz(6)
  organizationId String         @map("organization_id") @db.Uuid
  userId         String?        @map("user_id") @db.Uuid
  projectId      String?        @map("project_id") @db.Uuid
  teamId         String?        @map("team_id") @db.Uuid
  channelId      String?        @map("channel_id") @db.Uuid
  threadId       String?        @map("thread_id") @db.Uuid
  taskId         String?        @map("task_id") @db.Uuid
  runId          String?        @map("run_id") @db.Uuid
  agentId        String?        @map("agent_id") @db.Uuid
  actorId        String         @map("actor_id")
  actorType      AuditActorType? @map("actor_type")
  requestId      String?        @map("request_id")
  correlationId  String?        @map("correlation_id")
  connectorType  ConnectorType  @map("connector_type")
  connectorId    String?        @map("connector_id") @db.Uuid
  target         String?
  operation      String?
  calls          Int            @default(1)
  units          Int?
  unitType       String?        @map("unit_type")
  costAmount     Decimal?       @map("cost_amount") @db.Decimal(20, 8)
  costCurrency   String?        @map("cost_currency")
  success        Boolean?
  latencyMs      Int?           @map("latency_ms")
  metadata       Json?

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, connectorType, occurredAt(sort: Desc)])
  @@index([organizationId, agentId, occurredAt(sort: Desc)])
  @@index([organizationId, userId, occurredAt(sort: Desc)])
  @@index([organizationId, channelId, occurredAt(sort: Desc)])
  @@index([organizationId, connectorId, occurredAt(sort: Desc)])
  @@index([organizationId, runId, occurredAt(sort: Desc)])
  @@map("connector_usage_events")
}

// Append-only signed-delta ledger of bytes STORED (not transferred — that is
// ConnectorUsageEvent). Each stored file emits a positive delta; each deletion
// emits a negative one. Current usage for any scope = SUM(delta_bytes) filtered
// by that scope, which is race-free and self-healing. Written exclusively by
// the FileService (@nessie/runtime).
model StorageUsageEvent {
  id             String          @id @default(uuid()) @db.Uuid
  occurredAt     DateTime        @map("occurred_at") @db.Timestamptz(6)
  organizationId String          @map("organization_id") @db.Uuid
  projectId      String?         @map("project_id") @db.Uuid
  teamId         String?         @map("team_id") @db.Uuid
  spaceId        String?         @map("space_id") @db.Uuid
  uploaderId     String?         @map("uploader_id") @db.Uuid
  attachmentId   String?         @map("attachment_id") @db.Uuid
  deltaBytes     BigInt          @map("delta_bytes")
  operation      String
  actorId        String          @map("actor_id")
  actorType      AuditActorType? @map("actor_type")
  requestId      String?         @map("request_id")
  correlationId  String?         @map("correlation_id")
  metadata       Json?

  @@index([organizationId, occurredAt(sort: Desc)])
  @@index([organizationId, projectId])
  @@index([organizationId, teamId])
  @@index([organizationId, spaceId])
  @@index([organizationId, uploaderId])
  @@map("storage_usage_events")
}

// ─── Memory Models ──────────────────────────────────────────────────────────

model Thought {
  id             String                       @id @default(uuid()) @db.Uuid
  content        String
  contentHash    String                       @map("content_hash")
  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")
  dims           Int?
  searchVector   Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('english'::regconfig, COALESCE(content, ''::text))")) @map("search_vector")

  // Ownership
  ownerId   String           @map("owner_id")
  ownerType ThoughtOwnerType @map("owner_type")

  // Canonical audience
  audienceType ThoughtAudienceType? @map("audience_type")
  audienceId   String?              @map("audience_id") @db.Uuid

  // Per-agent privacy: when set, only this agent may recall the memory.
  // Orthogonal to the audience (access) axis — the audience still governs
  // which users/scopes can access it, so user-access filtering is unchanged.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String?      @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  // Classification
  visibility      ThoughtVisibility     @default(private)
  sensitivityTier SensitivityTier       @default(normal) @map("sensitivity_tier")
  memoryType      ThoughtMemoryType     @default(semantic) @map("memory_type")
  memoryCategory  ThoughtMemoryCategory @default(fact) @map("memory_category")
  importance      Float                 @default(0.5)

  // LLM-extracted metadata
  metadata Json?

  // Lifecycle
  lastAccessedAt DateTime? @map("last_accessed_at") @db.Timestamptz(6)
  accessCount    Int       @default(0) @map("access_count")
  deletedAt      DateTime? @map("deleted_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  // Relations
  reasonings ThoughtReasoning[]
  linksFrom  ThoughtLink[]      @relation("ThoughtLinksFrom")
  linksTo    ThoughtLink[]      @relation("ThoughtLinksTo")
  auditLogs  ThoughtAuditLog[]
  recalls    ThoughtRecall[]

  @@index([organizationId, visibility, createdAt])
  @@index([organizationId, memoryType, memoryCategory, createdAt])
  @@index([organizationId, audienceType, audienceId, createdAt])
  @@index([organizationId, ownerId, ownerType])
  @@index([contentHash])
  @@index([channelId, createdAt])
  @@index([userId, createdAt])
  @@index([privateToAgentId])
  @@map("thoughts")
}

model KnowledgeSpace {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  description String?
  metadata    Json?

  // Per-agent privacy: when set, only this agent may access the space.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping mirrors Thought and satisfies the shared scoped-content
  // contract used by packages/retrieval.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  visibility      ThoughtVisibility @default(project)
  // When true, reading follows `visibility` but writing is limited to members +
  // creator — i.e. the "public read-only, private write" mode.
  writeRestricted Boolean           @default(false) @map("write_restricted")
  sensitivityTier SensitivityTier   @default(normal) @map("sensitivity_tier")
  createdBy       String            @map("created_by")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  pages   KnowledgePage[]
  members KnowledgeSpaceMember[]

  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_spaces_org_project_updated_id_idx")
  @@index([organizationId, visibility, updatedAt], map: "knowledge_spaces_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_spaces_org_sensitivity_idx")
  @@index([privateToAgentId], map: "knowledge_spaces_private_to_agent_id_idx")
  @@map("knowledge_spaces")
}

// Explicit per-space access grants. Used by `private` visibility (who can read)
// and by `writeRestricted` spaces (who can write). The space creator always has
// full access regardless of membership.
// A member row grants one principal — a user XOR an agent — access to a
// space. Exactly one of userId/agentId is set (enforced in the service layer;
// both columns are nullable so either principal kind can be granted).
model KnowledgeSpaceMember {
  id             String   @id @default(uuid()) @db.Uuid
  spaceId        String   @map("space_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  agentId        String?  @map("agent_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  space KnowledgeSpace @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user  User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  agent Agent?         @relation("KnowledgeSpaceAgentMembers", fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@unique([spaceId, agentId])
  @@index([userId])
  @@index([agentId])
  @@index([organizationId])
  @@map("knowledge_space_members")
}

model KnowledgePage {
  id       String  @id @default(uuid()) @db.Uuid
  spaceId  String  @map("space_id") @db.Uuid
  title    String
  summary  String?
  metadata Json?

  kind               KnowledgePageKind   @default(document)
  parentPageId       String?             @map("parent_page_id") @db.Uuid
  position           Int                 @default(0)
  status             KnowledgePageStatus @default(draft)
  publishedVersionId String?             @unique(map: "knowledge_pages_published_version_id_key") @map("published_version_id") @db.Uuid

  // Per-agent privacy: when set, only this agent may access the page.
  privateToAgentId String? @map("private_to_agent_id") @db.Uuid

  // Tenant scoping mirrors Thought and satisfies the shared scoped-content
  // contract used by packages/retrieval.
  organizationId String       @map("organization_id") @db.Uuid
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      String       @map("project_id") @db.Uuid
  teamId         String?      @map("team_id") @db.Uuid
  channelId      String?      @map("channel_id") @db.Uuid
  threadId       String?      @map("thread_id") @db.Uuid
  userId         String?      @map("user_id") @db.Uuid

  visibility      ThoughtVisibility @default(project)
  sensitivityTier SensitivityTier   @default(normal) @map("sensitivity_tier")
  // Ticket binding: a page carrying taskId is a ticket document. Loose scoping
  // column like the rest of the envelope (no FK) — task deletion archives
  // pages at the app layer, it does not cascade here.
  taskId          String?           @map("task_id") @db.Uuid
  createdBy       String            @map("created_by")
  deletedAt       DateTime?         @map("deleted_at")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  space            KnowledgeSpace         @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  parentPage       KnowledgePage?         @relation("KnowledgePageTree", fields: [parentPageId], references: [id], onDelete: SetNull)
  childPages       KnowledgePage[]        @relation("KnowledgePageTree")
  versions         KnowledgePageVersion[] @relation("KnowledgePageVersions")
  publishedVersion KnowledgePageVersion?  @relation("KnowledgePagePublishedVersion", fields: [publishedVersionId], references: [id], onDelete: SetNull)
  labels           PageLabel[]
  annotations      KnowledgePageAnnotation[]
  chunks           KnowledgePageChunk[]
  outgoingLinks    KnowledgePageLink[]       @relation("KnowledgePageLinkSource")
  incomingLinks    KnowledgePageLink[]       @relation("KnowledgePageLinkTarget")
  productIntegrationRuns ProductIntegrationRun[]

  @@index([taskId], map: "knowledge_pages_task_id_idx")
  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_pages_org_project_updated_id_idx")
  @@index([organizationId, visibility, updatedAt], map: "knowledge_pages_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_pages_org_sensitivity_idx")
  @@index([spaceId, parentPageId, position], map: "knowledge_pages_space_parent_position_idx")
  @@index([publishedVersionId], map: "knowledge_pages_published_version_id_idx")
  @@index([privateToAgentId], map: "knowledge_pages_private_to_agent_id_idx")
  // Trigram GIN indexes back the ILIKE '%q%' search (native-search.ts) so it
  // doesn't sequentially scan every page per query. Requires the pg_trgm
  // extension, created in the same migration.
  @@index([title(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_pages_title_trgm_idx")
  @@index([summary(ops: raw("gin_trgm_ops"))], type: Gin, map: "knowledge_pages_summary_trgm_idx")
  @@map("knowledge_pages")
}

model KnowledgePageVersion {
  id            String              @id @default(uuid()) @db.Uuid
  pageId        String              @map("page_id") @db.Uuid
  versionNumber Int                 @map("version_number")
  body          String?             @db.Text
  bodyRef       String?             @map("body_ref")
  // For file nodes (KnowledgePage.kind = file): the stored object backing this
  // version. App-enforced (no FK relation), mirroring Attachment's other links.
  attachmentId  String?             @map("attachment_id") @db.Uuid
  authorType    KnowledgeAuthorType @map("author_type")
  authorId      String              @map("author_id")
  changeComment String?             @map("change_comment")
  createdAt     DateTime            @default(now()) @map("created_at")

  page             KnowledgePage  @relation("KnowledgePageVersions", fields: [pageId], references: [id], onDelete: Cascade)
  publishedForPage KnowledgePage? @relation("KnowledgePagePublishedVersion")
  chunks           KnowledgePageChunk[]

  @@unique([pageId, versionNumber], map: "knowledge_page_versions_page_version_key")
  @@index([pageId, createdAt(sort: Desc)], map: "knowledge_page_versions_page_created_idx")
  @@index([attachmentId], map: "knowledge_page_versions_attachment_id_idx")
  @@map("knowledge_page_versions")
}

model KnowledgePageChunk {
  id          String @id @default(uuid()) @db.Uuid
  pageId      String @map("page_id") @db.Uuid
  versionId   String @map("version_id") @db.Uuid
  chunkIndex  Int    @map("chunk_index")
  content     String @db.Text
  contentHash String @map("content_hash")
  startOffset Int    @map("start_offset")
  endOffset   Int    @map("end_offset")
  tokenCount  Int?   @map("token_count")

  embedding      Unsupported("vector(1536)")?
  embeddingModel String?                      @map("embedding_model")
  dims           Int?
  searchVector   Unsupported("tsvector")?     @default(dbgenerated("to_tsvector('english'::regconfig, COALESCE(content, ''::text))")) @map("search_vector")

  // Mirrors KnowledgePage/Thought scoping so retrieval can enforce access in
  // the candidate query without joining back through mutable page metadata.
  organizationId   String            @map("organization_id") @db.Uuid
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  projectId        String            @map("project_id") @db.Uuid
  teamId           String?           @map("team_id") @db.Uuid
  channelId        String?           @map("channel_id") @db.Uuid
  threadId         String?           @map("thread_id") @db.Uuid
  userId           String?           @map("user_id") @db.Uuid
  visibility       ThoughtVisibility @default(project)
  sensitivityTier  SensitivityTier   @default(normal) @map("sensitivity_tier")
  privateToAgentId String?           @map("private_to_agent_id") @db.Uuid
  taskId           String?           @map("task_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  page    KnowledgePage        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  version KnowledgePageVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, chunkIndex], map: "knowledge_page_chunks_version_chunk_key")
  @@index([pageId, versionId], map: "knowledge_page_chunks_page_version_idx")
  @@index([organizationId, projectId, updatedAt(sort: Desc), id(sort: Desc)], map: "knowledge_page_chunks_org_project_updated_id_idx")
  @@index([organizationId, visibility, updatedAt], map: "knowledge_page_chunks_org_visibility_updated_idx")
  @@index([organizationId, sensitivityTier], map: "knowledge_page_chunks_org_sensitivity_idx")
  @@index([privateToAgentId], map: "knowledge_page_chunks_private_to_agent_id_idx")
  @@index([taskId], map: "knowledge_page_chunks_task_id_idx")
  @@map("knowledge_page_chunks")
}

// Wikilink index: one row per outgoing link in a page's latest body.
// Maintained transactionally alongside chunking on every version save.
// targetPageId is null for unresolved [[Title]] links; creating a page whose
// title matches resolves them.
model KnowledgePageLink {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  sourcePageId   String   @map("source_page_id") @db.Uuid
  targetPageId   String?  @map("target_page_id") @db.Uuid
  targetTitle    String   @map("target_title")
  createdAt      DateTime @default(now()) @map("created_at")

  sourcePage KnowledgePage  @relation("KnowledgePageLinkSource", fields: [sourcePageId], references: [id], onDelete: Cascade)
  targetPage KnowledgePage? @relation("KnowledgePageLinkTarget", fields: [targetPageId], references: [id], onDelete: SetNull)

  @@index([sourcePageId])
  @@index([targetPageId])
  @@index([organizationId, targetTitle])
  @@map("knowledge_page_links")
}

model PageLabel {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  pageId         String   @map("page_id") @db.Uuid
  name           String
  normalizedName String   @map("normalized_name")
  createdAt      DateTime @default(now()) @map("created_at")

  page KnowledgePage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@unique([pageId, normalizedName], map: "page_labels_page_normalized_key")
  @@index([organizationId, normalizedName], map: "page_labels_org_normalized_idx")
  @@index([normalizedName(ops: raw("gin_trgm_ops"))], type: Gin, map: "page_labels_normalized_trgm_idx")
  @@map("page_labels")
}

model KnowledgePageAnnotation {
  id      String                   @id @default(uuid()) @db.Uuid
  pageId  String                   @map("page_id") @db.Uuid
  spaceId String                   @map("space_id") @db.Uuid
  kind    KnowledgeAnnotationKind
  state   KnowledgeAnnotationState @default(open)

  // One level of replies: top-level rows have a null parent; replies point to a
  // top-level annotation of the same page (single level enforced in the service).
  parentId String? @map("parent_id") @db.Uuid

  body String @db.Text

  // Authorship mirrors KnowledgePageVersion (type + id). delegatedByAgentId is
  // set when a user-delegating agent (PA) authors on behalf of its owner.
  authorType         KnowledgeAuthorType @map("author_type")
  authorId           String              @map("author_id")
  delegatedByAgentId String?             @map("delegated_by_agent_id") @db.Uuid

  // Text-quote anchor (notes only); null for page-level comments. Authoritative
  // re-location happens per-render; `orphaned` is a best-effort cached hint.
  anchor          Json?
  anchorVersionId String?  @map("anchor_version_id") @db.Uuid
  orphaned        Boolean  @default(false)

  resolvedAt     DateTime?            @map("resolved_at")
  resolvedByType KnowledgeAuthorType? @map("resolved_by_type")
  resolvedById   String?              @map("resolved_by_id")

  organizationId String @map("organization_id") @db.Uuid

  editedAt  DateTime? @map("edited_at")
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  page      KnowledgePage                     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  parent    KnowledgePageAnnotation?          @relation("AnnotationReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   KnowledgePageAnnotation[]         @relation("AnnotationReplies")
  reactions KnowledgePageAnnotationReaction[]

  @@index([pageId, kind, parentId, createdAt(sort: Desc)], map: "kb_annotations_page_kind_parent_created_idx")
  @@index([organizationId, pageId], map: "kb_annotations_org_page_idx")
  @@index([parentId], map: "kb_annotations_parent_idx")
  @@map("knowledge_page_annotations")
}

model KnowledgePageAnnotationReaction {
  id             String   @id @default(uuid()) @db.Uuid
  annotationId   String   @map("annotation_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  agentId        String?  @map("agent_id") @db.Uuid
  emoji          String
  createdAt      DateTime @default(now()) @map("created_at")

  annotation KnowledgePageAnnotation @relation(fields: [annotationId], references: [id], onDelete: Cascade)

  @@unique([annotationId, userId, emoji], map: "kb_annotation_reactions_user_emoji_key")
  @@unique([annotationId, agentId, emoji], map: "kb_annotation_reactions_agent_emoji_key")
  @@index([annotationId], map: "kb_annotation_reactions_annotation_idx")
  @@map("knowledge_page_annotation_reactions")
}

model ThoughtReasoning {
  id        String  @id @default(uuid()) @db.Uuid
  thoughtId String  @map("thought_id") @db.Uuid
  thought   Thought @relation(fields: [thoughtId], references: [id], onDelete: Cascade)

  reasoningType ReasoningType @map("reasoning_type")
  alternatives  Json?
  criteria      Json?
  constraints   Json?
  tradeoffs     String?
  confidence    Float?
  reasoning     String

  actorType String @map("actor_type")
  actorId   String @map("actor_id")

  outcome      OutcomeStatus @default(pending)
  outcomeNotes String?       @map("outcome_notes")
  outcomeAt    DateTime?     @map("outcome_at")

  organizationId String @map("organization_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([thoughtId, createdAt])
  @@index([organizationId, outcome])
  @@index([organizationId, actorId])
  @@map("thought_reasonings")
}

model ThoughtLink {
  id        String              @id @default(uuid()) @db.Uuid
  sourceId  String              @map("source_id") @db.Uuid
  targetId  String              @map("target_id") @db.Uuid
  source    Thought             @relation("ThoughtLinksFrom", fields: [sourceId], references: [id], onDelete: Cascade)
  target    Thought             @relation("ThoughtLinksTo", fields: [targetId], references: [id], onDelete: Cascade)
  relation  ThoughtLinkRelation
  metadata  Json?
  createdAt DateTime            @default(now()) @map("created_at")

  @@unique([sourceId, targetId, relation])
  @@index([targetId])
  @@map("thought_links")
}

model ThoughtAuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  thoughtId String   @map("thought_id") @db.Uuid
  thought   Thought  @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  action    String
  actorType String   @map("actor_type")
  actorId   String   @map("actor_id")
  diff      Json?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([thoughtId, createdAt])
  @@map("thought_audit_logs")
}

model ThoughtRecall {
  id                 String                       @id @default(uuid()) @db.Uuid
  thoughtId          String                       @map("thought_id") @db.Uuid
  thought            Thought                      @relation(fields: [thoughtId], references: [id], onDelete: Cascade)
  requesterUserId    String?                      @map("requester_user_id") @db.Uuid
  sessionId          String?                      @map("session_id")
  channelId          String?                      @map("channel_id") @db.Uuid
  outputAudienceType ThoughtAudienceType?         @map("output_audience_type")
  outputAudienceId   String?                      @map("output_audience_id") @db.Uuid
  queryText          String                       @map("query_text")
  queryEmbedding     Unsupported("vector(1536)")? @map("query_embedding")
  similarity         Float?
  rankPosition       Int                          @map("rank_position")
  retrievalMode      String                       @default("hybrid") @map("retrieval_mode")
  wasInjected        Boolean                      @default(false) @map("was_injected")
  wasReferenced      Boolean                      @default(false) @map("was_referenced")
  userSignal         String?                      @map("user_signal")
  createdAt          DateTime                     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([thoughtId])
  @@index([requesterUserId, createdAt(sort: Desc)])
  @@index([sessionId, createdAt(sort: Desc)])
  @@index([outputAudienceType, outputAudienceId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("thought_recalls")
}

model Call {
  id           String            @id @default(uuid()) @db.Uuid
  channelId    String            @map("channel_id") @db.Uuid
  roomId       String            @unique @map("room_id")
  status       String            @default("active")
  startedById  String            @map("started_by_id") @db.Uuid
  startedAt    DateTime          @default(now()) @map("started_at")
  endedAt      DateTime?         @map("ended_at")
  channel      Channel           @relation(fields: [channelId], references: [id], onDelete: Cascade)
  startedBy    User              @relation("CallStarter", fields: [startedById], references: [id], onDelete: Cascade)
  participants CallParticipant[]

  @@index([channelId])
  @@index([status])
  @@map("calls")
}

model CallParticipant {
  id       String    @id @default(uuid()) @db.Uuid
  callId   String    @map("call_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  joinedAt DateTime  @default(now()) @map("joined_at")
  leftAt   DateTime? @map("left_at")
  call     Call      @relation(fields: [callId], references: [id], onDelete: Cascade)
  user     User      @relation("CallParticipation", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([callId, userId])
  @@map("call_participants")
}

/// Encrypted MCP OAuth token storage (production SecretStore backing table).
/// Rows hold AES-256-GCM ciphertext of the OAuth token bundle keyed by the
/// opaque `secret_oauth_*` ref handed back to the credential resolution chain.
model McpOAuthSecret {
  ref        String   @id
  ciphertext String
  iv         String
  authTag    String   @map("auth_tag")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("mcp_oauth_secret")
}

/// Per-organization signing secret for an integrated product's inbound webhooks
/// (e.g. DeepSignal `insight.surfaced`). Set once by an org admin who pastes the
/// secret the product returned at webhook-registration time. Stored encrypted at
/// rest (AES-256-GCM under a key derived from the deployment auth secret); the
/// plaintext is only ever read to verify an inbound HMAC signature.
model ProductWebhookSecret {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  productSlug    String   @map("product_slug")
  ciphertext     String
  iv             String
  authTag        String   @map("auth_tag")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, productSlug])
  @@map("product_webhook_secrets")
}

/// One-shot OAuth authorization state (RFC 6749 `state` + PKCE verifier and
/// the dynamic-flow parameters the callback needs). Postgres-backed so any
/// API/worker process can mint a flow that another process completes; rows
/// are deleted on first read and expire after 10 minutes.
model McpOAuthState {
  token     String   @id
  payload   Json
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("mcp_oauth_states")
}

/// OAuth client obtained via Dynamic Client Registration (RFC 7591), one per
/// (organization, authorization-server issuer). Public clients carry no
/// secret; when a server issues one anyway it is stored behind an encrypted
/// `secret_*` ref, never in plaintext.
model McpOAuthClient {
  id              String       @id @default(uuid()) @db.Uuid
  organizationId  String       @map("organization_id") @db.Uuid
  issuer          String
  clientId        String       @map("client_id")
  clientSecretRef String?      @map("client_secret_ref")
  redirectUris    String[]     @map("redirect_uris")
  metadata        Json         @default("{}")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, issuer])
  @@map("mcp_oauth_clients")
}

// ─── File uploads / attachments (Slack-parity files slice) ──────────────────
// Standalone, relation-free model so the files slice can land additively
// without editing the User / Message / Organization models. The link to a
// message is a nullable scalar `messageId` set after upload when the message
// is created; integrity is enforced at the application layer.
model Attachment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  uploaderId     String?  @map("uploader_id") @db.Uuid
  messageId      String?  @map("message_id") @db.Uuid
  // App-enforced link to a knowledge-base page when this attachment is one of a
  // page's drawer attachments (no FK relation, mirroring messageId).
  knowledgePageId String? @map("knowledge_page_id") @db.Uuid
  kind           String
  mime           String
  filename       String
  // BigInt: uploads can be up to 5 GB, which overflows a 32-bit Int.
  sizeBytes      BigInt   @map("size_bytes")
  storageKey     String   @map("storage_key")
  width          Int?
  height         Int?
  createdAt      DateTime @default(now()) @map("created_at")

  logoForOrganizations Organization[] @relation("OrganizationLogo")
  avatarForUsers       User[]         @relation("UserAvatar")
  avatarForAgents      Agent[]        @relation("AgentAvatar")
  feedbackItems        Feedback[]     @relation("FeedbackAttachment")

  @@index([messageId])
  @@index([knowledgePageId])
  @@index([organizationId, createdAt])
  @@map("attachments")
}

// In-app user feedback. Each row is one submission; when GitHub is configured
// it is mirrored to an issue (github_issue_number/url) and status becomes
// "submitted" (else "saved"; "failed" if the GitHub call errored).
model Feedback {
  id                String       @id @default(uuid()) @db.Uuid
  organizationId    String       @map("organization_id") @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  title             String
  body              String
  attachmentId      String?      @map("attachment_id") @db.Uuid
  githubIssueNumber Int?         @map("github_issue_number")
  githubIssueUrl    String?      @map("github_issue_url")
  status            String       @default("saved")
  createdAt         DateTime     @default(now()) @map("created_at")
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attachment        Attachment?  @relation("FeedbackAttachment", fields: [attachmentId], references: [id], onDelete: SetNull)

  @@index([organizationId, userId, createdAt])
  @@map("feedback")
}

// ─── Device-token registry (native push targeting) ──────────────────────────
// One row per (user, native device token). Mobile apps register the *native*
// APNs/FCM token on every launch so the push pipeline can fan a notification
// out to a user's devices. `organization_id`-scoped like every other child
// table; the worker only ever sends a user's own tokens. Relation-free so the
// slice lands additively; integrity is enforced at the application layer.
enum DevicePlatform {
  ios
  android
}

model DeviceToken {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @map("organization_id") @db.Uuid
  userId         String         @map("user_id") @db.Uuid
  platform       DevicePlatform
  token          String
  appVersion     String?        @map("app_version")
  lastSeenAt     DateTime       @default(now()) @map("last_seen_at")
  createdAt      DateTime       @default(now()) @map("created_at")

  @@unique([userId, token])
  @@index([organizationId])
  @@index([userId])
  @@map("device_tokens")
}

// ─── Web Push subscription registry (browser push targeting) ────────────────
// One row per (user, browser PushSubscription). The admin SPA subscribes via
// the Push API and POSTs the resulting endpoint + keys here; the worker fans a
// notification out to a user's browser subscriptions exactly like device
// tokens. `endpoint` is unique per browser; `p256dh`/`auth` are the per-
// subscription public key and secret used for RFC 8291 payload encryption.
// `organization_id`-scoped like every child table; integrity enforced at the
// application layer to keep the slice additive.
model WebPushSubscription {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  endpoint       String
  p256dh         String
  auth           String
  userAgent      String?  @map("user_agent")
  lastSeenAt     DateTime @default(now()) @map("last_seen_at")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([userId, endpoint])
  @@index([organizationId])
  @@index([userId])
  @@map("web_push_subscriptions")
}

// ─── Push credentials (platform-global, super-admin only) ───────────────────
// Non-secret metadata for the Apple APNs / Google FCM credentials that the
// central push gateway uses. The secret bytes themselves (the `.p8` key, the
// FCM service-account JSON) live encrypted in `mcp_oauth_secret` via the
// SecretStore under a stable ref (`secretRef`); they are NEVER stored here and
// NEVER returned from any endpoint. One row per provider (apns | fcm).
enum PushProvider {
  apns
  fcm
  webpush
}

enum PushDeliveryStatus {
  sent
  failed
  dead
}

enum PushApnsEnvironment {
  sandbox
  production
}

model PushCredential {
  id              String               @id @default(uuid()) @db.Uuid
  provider        PushProvider         @unique
  // Opaque ref into the encrypted SecretStore (`mcp_oauth_secret`).
  secretRef       String               @map("secret_ref")
  // APNs metadata (null for fcm rows).
  apnsKeyId       String?              @map("apns_key_id")
  apnsTeamId      String?              @map("apns_team_id")
  apnsTopic       String?              @map("apns_topic")
  apnsEnvironment PushApnsEnvironment? @map("apns_environment")
  // FCM metadata (null for apns rows).
  fcmProjectId    String?              @map("fcm_project_id")
  fcmClientEmail  String?              @map("fcm_client_email")
  updatedByUserId String               @map("updated_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")

  @@map("push_credentials")
}

model PushDelivery {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  userId         String             @map("user_id") @db.Uuid
  messageId      String?            @map("message_id") @db.Uuid
  provider       PushProvider
  status         PushDeliveryStatus
  errorCode      String?            @map("error_code")
  attempts       Int                @default(1)
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("push_deliveries")
}

// ─── Individual Communications Connectors ───────────────────────────────────
// Per-user connections to Slack / Google (Gmail) / Microsoft (Teams+Outlook).
// The connector layer only authenticates, retrieves, syncs, and normalizes into
// one shared event model — it holds no business intelligence. Tokens live in a
// separate credential table (never shipped to the browser); ingestion is
// idempotent on the deterministic canonical key
// `provider:tenantId:conversationId:messageId` with explicit edit-versioning;
// sync jobs resume from stored cursors. Connections are per-user, never
// per-workspace. See docs/plans/2026-07-21-individual-communications-connector.md.

enum CommsProvider {
  slack
  google
  microsoft
}

enum CommsConnectionStatus {
  active
  needs_reauthorization
  disconnected
  error
}

enum CommsSyncPhase {
  history
  incremental
  reconciliation
}

enum CommsSyncStatus {
  pending
  running
  completed
  failed
}

enum CommsSubscriptionStatus {
  active
  expired
  failed
}

/// A single user's authenticated connection to one external communications
/// provider tenant. Scoped to the organization AND the owning user — a
/// connection is never shared across a workspace. The unique key makes
/// re-connecting the same provider account idempotent.
model CommsConnection {
  id                     String                @id @default(uuid()) @db.Uuid
  organizationId         String                @map("organization_id") @db.Uuid
  ownerUserId            String                @map("owner_user_id") @db.Uuid
  provider               CommsProvider
  externalTenantId       String                @map("external_tenant_id")
  externalUserId         String                @map("external_user_id")
  status                 CommsConnectionStatus @default(active)
  grantedScopes          Json                  @default("[]") @map("granted_scopes")
  initialSyncCompletedAt DateTime?             @map("initial_sync_completed_at")
  lastSuccessfulSyncAt   DateTime?             @map("last_successful_sync_at")
  createdAt              DateTime              @default(now()) @map("created_at")
  updatedAt             DateTime              @updatedAt @map("updated_at")

  credential    CommsConnectionCredential?
  resources     CommsResource[]
  syncJobs      CommsSyncJob[]
  events        CommsEvent[]
  subscriptions CommsSubscription[]

  @@unique([organizationId, ownerUserId, provider, externalTenantId, externalUserId])
  @@index([organizationId, ownerUserId])
  @@index([status])
  @@map("comms_connections")
}

/// Encrypted OAuth token bundle for a connection, isolated in its own table so
/// token material never sits alongside connection metadata or normalized event
/// data. Ciphertext is produced with the shared `@nessie/runtime` AES-256-GCM
/// secret-crypto primitives (packed iv/authTag/ciphertext), never sent to the
/// browser. `keyVersion` supports future key rotation; `scopeHash` lets a
/// re-auth detect a scope change without decrypting.
model CommsConnectionCredential {
  id                     String    @id @default(uuid()) @db.Uuid
  connectionId           String    @unique @map("connection_id") @db.Uuid
  accessTokenCiphertext  String    @map("access_token_ciphertext")
  refreshTokenCiphertext String?   @map("refresh_token_ciphertext")
  expiresAt              DateTime? @map("expires_at")
  keyVersion             Int       @default(1) @map("key_version")
  scopeHash              String    @map("scope_hash")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  connection CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@map("comms_connection_credentials")
}

/// Single-use, short-lived OAuth authorization state bound to the initiating
/// user + provider + organization. `payload` carries the PKCE verifier and
/// redirect parameters the callback needs. Consumed on first read and expired
/// by TTL, mirroring `mcp_oauth_states`.
model CommsOAuthState {
  token          String        @id
  organizationId String        @map("organization_id") @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  provider       CommsProvider
  payload        Json
  expiresAt      DateTime      @map("expires_at")
  consumedAt     DateTime?     @map("consumed_at")
  createdAt      DateTime      @default(now()) @map("created_at")

  @@index([organizationId, userId, provider])
  @@index([expiresAt])
  @@map("comms_oauth_states")
}

/// A syncable resource inside a connection: a Slack channel/DM, a Teams chat or
/// channel, a Gmail label, an Outlook folder, etc. `resourceType` is a free
/// string so providers can name their own container kinds. Unique per external
/// id within the connection.
model CommsResource {
  id            String          @id @default(uuid()) @db.Uuid
  connectionId  String          @map("connection_id") @db.Uuid
  resourceType  String          @map("resource_type")
  externalId    String          @map("external_id")
  name          String?
  visibility    String?
  userHasAccess Boolean         @default(true) @map("user_has_access")
  syncEnabled   Boolean         @default(true) @map("sync_enabled")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  connection    CommsConnection     @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  syncJobs      CommsSyncJob[]
  subscriptions CommsSubscription[]

  @@unique([connectionId, externalId])
  @@index([connectionId, syncEnabled])
  @@map("comms_resources")
}

/// A resumable sync job for a connection (optionally scoped to one resource).
/// `cursor` is the provider pagination/delta token; a failed job resumes from
/// it rather than restarting. `oldest`/`newestImportedAt` bound the imported
/// window for history back-fill and incremental catch-up.
model CommsSyncJob {
  id               String          @id @default(uuid()) @db.Uuid
  connectionId     String          @map("connection_id") @db.Uuid
  resourceId       String?         @map("resource_id") @db.Uuid
  phase            CommsSyncPhase
  cursor           String?
  oldestImportedAt DateTime?       @map("oldest_imported_at")
  newestImportedAt DateTime?       @map("newest_imported_at")
  status           CommsSyncStatus @default(pending)
  retryCount       Int             @default(0) @map("retry_count")
  lastError        String?         @map("last_error")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  connection CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  resource   CommsResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@index([connectionId, status])
  @@index([resourceId])
  @@map("comms_sync_jobs")
}

/// The normalized event store: every imported message/thread/email in one
/// provider-agnostic shape. `canonicalMessageId` is the deterministic key
/// (`provider:tenantId:conversationId:messageId`); edits create a new `version`
/// of the same canonical id rather than mutating in place, so the unique key is
/// (connectionId, canonicalMessageId, version). Deletes flip `isDeleted`.
model CommsEvent {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  connectionId       String        @map("connection_id") @db.Uuid
  canonicalMessageId String        @map("canonical_message_id")
  version            Int           @default(1)
  isDeleted          Boolean       @default(false) @map("is_deleted")
  editedAt           DateTime?     @map("edited_at")
  provider           CommsProvider
  externalTenantId   String        @map("external_tenant_id")
  conversationId     String        @map("conversation_id")
  threadId           String?       @map("thread_id")
  messageId          String        @map("message_id")
  eventType          String        @map("event_type")
  occurredAt         DateTime      @map("occurred_at")
  senderExternalId   String?       @map("sender_external_id")
  senderDisplayName  String?       @map("sender_display_name")
  senderEmail        String?       @map("sender_email")
  participants       Json          @default("[]")
  subject            String?
  contentText        String?       @map("content_text")
  contentHtml        String?       @map("content_html")
  attachments        Json          @default("[]")
  mentions           Json          @default("[]")
  reactions          Json          @default("[]")
  visibility         String
  sourceUrl          String?       @map("source_url")
  rawPayloadRef      String?       @map("raw_payload_ref")
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  connection CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  @@unique([connectionId, canonicalMessageId, version])
  @@index([organizationId, connectionId, occurredAt])
  @@index([connectionId, conversationId, occurredAt])
  @@map("comms_events")
}

/// A provider webhook/watch subscription that must be renewed before it
/// expires (Microsoft Graph subscriptions, Gmail watch, Slack Events). The
/// renewal sweep queries by `status` + `expiresAt`. `clientState` is the
/// provider-echoed validation token.
model CommsSubscription {
  id                    String                  @id @default(uuid()) @db.Uuid
  connectionId          String                  @map("connection_id") @db.Uuid
  resourceId            String?                 @map("resource_id") @db.Uuid
  provider              CommsProvider
  externalSubscriptionId String                 @map("external_subscription_id")
  clientState           String?                 @map("client_state")
  expiresAt             DateTime                @map("expires_at")
  status                CommsSubscriptionStatus @default(active)
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")

  connection CommsConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  resource   CommsResource?  @relation(fields: [resourceId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalSubscriptionId])
  @@index([status, expiresAt])
  @@map("comms_subscriptions")
}

/// Fixed-window counters for the auth-sensitive request rate limiter
/// (api/src/services/rate-limit.ts). One row per (bucket, key, window start);
/// atomic upsert-increment makes multi-replica counting safe. Rows are
/// deleted once their window has passed (probabilistic cleanup per hit), so
/// the table stays bounded by active keys per window. `keyHash` is a SHA-256
/// of the caller identity (IP or user id) — raw IPs are never persisted.
model RateLimitBucket {
  id          String   @id @default(uuid()) @db.Uuid
  bucket      String
  keyHash     String   @map("key_hash")
  windowStart DateTime @map("window_start") @db.Timestamptz(6)
  count       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([bucket, keyHash, windowStart])
  @@index([windowStart])
  @@map("rate_limit_buckets")
}
