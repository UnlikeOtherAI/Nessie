model ThreadReadState {
  id         String   @id @default(uuid()) @db.Uuid
  threadId   String   @map("thread_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  lastReadAt DateTime @map("last_read_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  thread     Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([threadId, userId])
  @@index([userId])
  @@map("thread_read_states")
}

// Read state for one reachable message-level reply conversation. A root post
// is also the root of its own conversation, so this cursor keeps a reply panel
// from acknowledging a different root in the same channel container.
// ThreadReadState remains the migration baseline for roots that have not yet
// been explicitly acknowledged under this precise model.
model MessageConversationReadState {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  rootMessageId     String   @map("root_message_id") @db.Uuid
  userId            String   @map("user_id") @db.Uuid
  lastReadAt        DateTime @map("last_read_at")
  // Paired with the timestamp because Postgres stores timestamps at
  // millisecond precision; this makes the conversation high-water mark exact.
  lastReadMessageId String?  @map("last_read_message_id") @db.Uuid
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  rootMessage       Message  @relation("MessageConversationReadRoot", fields: [rootMessageId], references: [id], onDelete: Cascade)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([rootMessageId, userId])
  @@index([userId])
  @@map("message_conversation_read_states")
}

enum UserAlertKind {
  mention
  task_assigned
  knowledge_published
  // A scheduled trigger stopped being runnable. Durable rather than push-only
  // because the whole defect this fixes was a failure nobody could see: a push
  // is missable, the bell is not.
  trigger_health
  call_missed
  team_invitation
  // An agent is waiting on this person to approve an action it cannot take
  // alone. Durable rather than push-only for the same reason as
  // trigger_health: a push at 06:00 is missable and the request expires.
  approval_requested
}

// Persistent per-user alert records. v1 writes one `mention` row per directly
// @mentioned user in the message-create transaction (self-mentions skipped;
// broadcast mentions intentionally create no rows). The model is deliberately
// generic so future kinds (approval nudges, needs-action items) write into the
// same alerts substrate. A muted channel still gets the row — mute suppresses
// the push, never the durable alert.
model UserAlert {
  id                String           @id @default(uuid()) @db.Uuid
  organizationId    String           @map("organization_id") @db.Uuid
  userId            String           @map("user_id") @db.Uuid
  kind              UserAlertKind
  messageId         String?          @map("message_id") @db.Uuid
  threadId          String?          @map("thread_id") @db.Uuid
  channelId         String?          @map("channel_id") @db.Uuid
  projectId         String?          @map("project_id") @db.Uuid
  taskId            String?          @map("task_id") @db.Uuid
  knowledgePageId   String?          @map("knowledge_page_id") @db.Uuid
  triggerId         String?          @map("trigger_id") @db.Uuid
  callId            String?          @map("call_id") @db.Uuid
  approvalRequestId String?          @map("approval_request_id") @db.Uuid
  // A source-event generation key. New attention rows must carry one; legacy
  // mention rows predate this field and remain NULL.
  eventKey          String?          @map("event_key")
  // Ephemeral UOA invitation display/acceptance payload. Reconciled from each
  // verified directory read and deleted as soon as the invite disappears.
  metadata          Json?            @db.JsonB
  actorUserId       String?          @map("actor_user_id") @db.Uuid
  actorAgentId      String?          @map("actor_agent_id") @db.Uuid
  readAt            DateTime?        @map("read_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  organization      Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  message           Message?         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  thread            Thread?          @relation(fields: [threadId], references: [id], onDelete: Cascade)
  channel           Channel?         @relation(fields: [channelId], references: [id], onDelete: Cascade)
  project           Project?         @relation("PushAttentionAlertProject", fields: [projectId], references: [id], onDelete: Cascade)
  task              Task?            @relation("PushAttentionAlertTask", fields: [taskId], references: [id], onDelete: Cascade)
  knowledgePage     KnowledgePage?   @relation("PushAttentionAlertKnowledgePage", fields: [knowledgePageId], references: [id], onDelete: Cascade)
  approvalRequest   ApprovalRequest? @relation(fields: [approvalRequestId], references: [id], onDelete: Cascade)
  trigger           AgentTrigger?    @relation("TriggerHealthAlert", fields: [triggerId], references: [id], onDelete: Cascade)
  call              Call?            @relation("CallMissedAlert", fields: [callId], references: [id], onDelete: Cascade)
  actorUser         User?            @relation("UserAlertActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorAgent        Agent?           @relation(fields: [actorAgentId], references: [id], onDelete: SetNull)

  @@unique([userId, eventKey])
  @@index([userId, readAt, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([userId, kind, projectId, readAt, createdAt])
  @@index([callId])
  @@map("user_alerts")
}

model ThreadStreamEvent {
  id        BigInt   @id @default(autoincrement())
  threadId  String   @map("thread_id") @db.Uuid
  eventName String   @map("event_name")
  data      Json     @db.JsonB
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz()
  thread    Thread   @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId, id], map: "idx_thread_stream_events_replay")
  @@map("thread_stream_events")
