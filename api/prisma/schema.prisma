  mcpInstance McpServerInstance? @relation(fields: [mcpInstanceId], references: [id], onDelete: SetNull)
  grants      ToolGrant[]

  @@unique([organizationId, scopeKey, toolId], map: "tool_registry_entries_org_scope_tool_key")
  @@index([organizationId, enabled])
  @@index([builtin, enabled])
  @@index([organizationId, source])
  @@index([organizationId, status])
  @@index([bundleId])
  @@index([mcpInstanceId])
  @@index([tags], type: Gin)
  @@index([updatedAt])
