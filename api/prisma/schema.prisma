// How much work an agent may spend per run. Scales the worker agentic-loop
// budget and the provider `reasoning_effort`. `medium` is the default;
// `xhigh` is effectively unbounded (governed only by scope Budgets + the
// loop's repeated-call detection).
enum AgentEffort {
  low
  medium
  high
  xhigh
}

// How an agent's turns are executed. `inference` (the default for every
// existing agent) runs Nessie's own agentic loop; `external_mcp` proxies each
// turn directly to an external product over MCP with no Nessie inference.
enum AgentExecutionMode {
