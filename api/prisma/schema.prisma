model ToolRegistryEntry {
  id               String                  @id @default(uuid()) @db.Uuid
  organizationId   String?                 @map("organization_id") @db.Uuid
  scopeKey         String                  @map("scope_key")
  toolId           String                  @map("tool_id")
  label            String
  description      String
  // Spec §3.1: `overview` is a required human-readable summary. No DB
  // default — every new row must supply a non-empty value. Pre-reconcile
  // rows backfilled with `''` remain legal (NOT NULL is preserved).
  overview         String
  instructions     String                  @default("")
  safe             Boolean                 @default(false)
  builtin          Boolean                 @default(false)
  enabled          Boolean                 @default(true)
  handlerKind      String                  @default("builtin") @map("handler_kind")
  metadata         Json?                   @default("{}")
  source           ToolRegistrySource      @default(builtin)
  transport        ToolRegistryTransport   @default(direct)
  transportConfig  Json                    @default("{}") @map("transport_config")
  bundleId         String?                 @map("bundle_id") @db.Uuid
  mcpInstanceId    String?                 @map("mcp_instance_id") @db.Uuid
  inputSchema      Json                    @default("{}") @map("input_schema")
  outputSchema     Json?                   @map("output_schema")
  tags             String[]                @default([])
  baseSearchTerms  String[]                @default([]) @map("base_search_terms")
  allowSearchTerms String[]                @default([]) @map("allow_search_terms")
  // The `{content:'',mergeMode:'append'}` default is implementation-chosen,
  // not spec-mandated. Spec §3.1 only requires that every row carries a
  // `basePrompt` object; the empty/append seed keeps backfills cheap.
  basePrompt       Json                    @default("{\"content\": \"\", \"mergeMode\": \"append\"}") @map("base_prompt")
  commonPrompt     Json?                   @map("common_prompt")
  defaultConfig    Json                    @default("{}") @map("default_config")
  searchableText   String                  @default("") @map("searchable_text")
  status           ToolRegistryEntryStatus @default(active)
  version          String                  @default("0.0.0")
  createdBy        String                  @default("system") @map("created_by")
  owner            String                  @default("system")
  createdAt        DateTime                @default(now()) @map("created_at")
  updatedAt        DateTime                @updatedAt @map("updated_at")

  bundle       ToolBundle?        @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  mcpInstance  McpServerInstance? @relation(fields: [mcpInstanceId], references: [id], onDelete: SetNull)
  grants       ToolGrant[]
  organization Organization?      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scopeKey, toolId], map: "tool_registry_entries_org_scope_tool_key")
  @@index([organizationId, enabled])
  @@index([builtin, enabled])
  @@index([organizationId, source])
  @@index([organizationId, status])
  @@index([bundleId])
  @@index([mcpInstanceId])
  @@index([tags], type: Gin)
  @@index([updatedAt])
  @@map("tool_registry_entries")
}

model McpCatalogEntry {
  id                     String               @id @default(uuid()) @db.Uuid
  organizationId         String?              @map("organization_id") @db.Uuid
  name                   String
  label                  String
  description            String
  protocol               McpCatalogProtocol
  authMethod             McpCatalogAuthMethod @map("auth_method")
  authConfig             Json                 @default("{}") @map("auth_config")
  defaultTransportConfig Json                 @default("{}") @map("default_transport_config")
  iconUrl                String?              @map("icon_url")
  vendor                 String?
  sourceUrl              String?              @map("source_url")
  signature              String?
  status                 McpCatalogStatus     @default(draft)
  visibility             McpCatalogVisibility @default(private)
  // Admin lock: members cannot install (or re-register the same endpoint as)
  // a locked connector; owners/admins are exempt. Purely an install-time
  // gate — already-installed instances keep working until removed.
  locked                 Boolean              @default(false)
  lockedAt               DateTime?            @map("locked_at")
  lockedBy               String?              @map("locked_by") @db.Uuid
  ownerUserId            String?              @map("owner_user_id") @db.Uuid
  submittedAt            DateTime?            @map("submitted_at")
  reviewedAt             DateTime?            @map("reviewed_at")
  reviewedBy             String?              @map("reviewed_by") @db.Uuid
  rejectionReason        String?              @map("rejection_reason")
  /// No FK on `createdBy`: it is NOT NULL, so onDelete:SetNull is impossible and
  /// onDelete:Restrict would orphan-block legitimate user deletions. Left as a
  /// bare provenance UUID by design. ownerUserId / reviewedBy (nullable) DO
  /// carry SetNull FKs.
  createdBy              String               @map("created_by") @db.Uuid
  createdAt              DateTime             @default(now()) @map("created_at")
  updatedAt              DateTime             @updatedAt @map("updated_at")

  // ─── App Store presentation + curation ───
  //
  // `name` is mutable and only unique among *public* entries, so it cannot
  // address an app in a URL. `slug` is the immutable public identity behind
  // `/apps/:slug`: set once at creation, never rewritten by registry sync, and
  // globally unique when present so a deep link survives every rename.
  slug              String?                  @unique
  /// Curated overrides. Registry sync writes `upstream`, never these — that
  /// separation is what lets a sync run at any time without clobbering copy a
  /// human wrote. Readers fall back: displayName ?? label.
  displayName       String?                  @map("display_name")
  shortDescription  String?                  @map("short_description")
  longDescription   String?                  @map("long_description")
  websiteUrl        String?                  @map("website_url")
  documentationUrl  String?                  @map("documentation_url")
  repositoryUrl     String?                  @map("repository_url")
  /// Icon bytes are fetched, validated, and cached through the one
  /// `FileService` chokepoint; `iconUrl` above stays as the raw upstream URL
  /// for provenance and is NEVER rendered directly (untrusted external SVG).
  iconAttachmentId  String?                  @map("icon_attachment_id") @db.Uuid
  iconSource        String?                  @map("icon_source")
  iconResolvedAt    DateTime?                @map("icon_resolved_at")
  primaryCategory   McpAppCategory           @default(other) @map("primary_category")
  categories        McpAppCategory[]         @default([])
  tags              String[]                 @default([])
  /// Curated synonyms — how "email" finds Gmail and "issues" finds Linear.
  aliases           String[]                 @default([])
  trustLevel        McpAppTrustLevel         @default(unknown) @map("trust_level")
  moderationState   McpAppModerationState    @default(discovered) @map("moderation_state")
  appSource         McpAppSource             @default(nessie) @map("app_source")
  distribution      McpAppDistribution       @default(remote)
  featured          Boolean                  @default(false)
  featuredOrder     Int?                     @map("featured_order")
  /// Upstream registry provenance. `upstream` holds the raw normalized record
  /// so a re-sync can diff without a second fetch.
  /// The upstream registry id, and the database-arbitrated identity of an
  /// ingested app: unique where present (partial index, see the migration) so
  /// two concurrent sweeps cannot both insert the same server.
  registryName      String?                  @map("registry_name")
  registryVersion   String?                  @map("registry_version")
  upstream          Json                     @default("{}")
  upstreamUpdatedAt DateTime?                @map("upstream_updated_at")
  /// Cached capability counts, so a card can say "42 capabilities" without a
  /// probe. Refreshed on install, reconnect, and registry sync.
  toolCount         Int?                     @map("tool_count")
  resourceCount     Int?                     @map("resource_count")
  promptCount       Int?                     @map("prompt_count")
  capabilitiesAt    DateTime?                @map("capabilities_at")
  /// Weighted full-text search document, maintained by a BEFORE INSERT/UPDATE
  /// trigger (see the migration) rather than by application code, so it cannot
  /// drift from the row it describes. Not a GENERATED column: the expression
  /// uses `array_to_string`, which is only STABLE, and Postgres refuses a
  /// non-immutable generation expression.
  searchVector      Unsupported("tsvector")? @map("search_vector")

  organization          Organization?               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner                 User?                       @relation("McpCatalogOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  reviewer              User?                       @relation("McpCatalogReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  instances             McpServerInstance[]
  integratedProducts    IntegratedProduct[]
  health                McpServerHealth?
  appConnectionRequests AgentAppConnectionRequest[]

  // Uniqueness is enforced by partial indexes (see migration): public entries
  // are unique on `name` store-wide; private entries are unique per owner in
  // one organisation. A person can therefore use the same private connector
  // name in separate teams without either team exposing the other.
  // A single `@@unique` can't express either, so they live in raw SQL.
  @@index([organizationId, status])
  @@index([ownerUserId, status])
  @@index([visibility, status])
  // Store reads: the catalogue lists by moderation + trust, then groups by
  // category, and the featured strip is its own ordered slice.
  @@index([moderationState, trustLevel])
  @@index([primaryCategory, moderationState])
  @@index([featured, featuredOrder])
  // registry_name uniqueness is a PARTIAL index (WHERE registry_name IS NOT
  // NULL) — hand-authored connectors leave it null and must stay unconstrained,
  // which `@@unique` cannot express. Declared in the migration.
  @@map("mcp_catalog_entries")
}

/// One row per registry import attempt. Kept so a failed or partial sync is
/// visible and diagnosable rather than silent; `serversFailed` > 0 with a
/// completed run is the normal "one bad record, rest imported" outcome,
/// because a malformed upstream record must never fail the whole import.
model McpRegistrySyncRun {
  id             String    @id @default(uuid()) @db.Uuid
  source         String    @default("mcp-registry")
  startedAt      DateTime  @default(now()) @map("started_at")
  completedAt    DateTime? @map("completed_at")
  serversFetched Int       @default(0) @map("servers_fetched")
  serversCreated Int       @default(0) @map("servers_created")
  serversUpdated Int       @default(0) @map("servers_updated")
  serversFailed  Int       @default(0) @map("servers_failed")
  iconsCached    Int       @default(0) @map("icons_cached")
  error          String?
  /// Per-record failures, capped, so one poison record is identifiable
  /// without trawling logs.
  failures       Json      @default("[]")

  @@index([startedAt])
  @@index([completedAt])
  @@map("mcp_registry_sync_runs")
}

/// Last known reachability of an app's advertised endpoint. Deliberately a
/// side table and never awaited by a catalogue read: health must not be able
/// to slow or fail the store rendering.
