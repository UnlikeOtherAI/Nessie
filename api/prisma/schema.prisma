  externalOrgId      String?           @map("external_org_id")
  externalTeamId     String?           @map("external_team_id")
  configuredByUserId String?           @map("configured_by_user_id") @db.Uuid
  metadata           Json              @default("{}") @map("metadata_json")
  createdAt          DateTime          @default(now()) @map("created_at")
