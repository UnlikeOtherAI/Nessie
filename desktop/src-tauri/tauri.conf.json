{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nessie",
  "version": "0.1.0",
  "identifier": "com.unlikeotherai.nessie.desktop",
  "build": {
    "devUrl": "http://localhost:5455",
    "frontendDist": "https://app.nessie.works"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "Nessie",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "theme": null,
        "backgroundColor": "#2e1132"
      }
    ],
    "security": {
      "csp": null,
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "resources/executor-runtime/": "executor-runtime/"
    },
    "targets": "all",
    "publisher": "UnlikeOtherAI",
    "copyright": "Copyright (c) 2026 UnlikeOtherAI",
    "category": "Productivity",
    "shortDescription": "Native desktop shell for Nessie.",
    "longDescription": "Nessie desktop provides a native window for the Nessie self-hosted agentic work platform.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": null
    },
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nessie"
        ]
      }
    }
  }
}
