{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nessie",
  "version": "0.1.0",
  "identifier": "com.unlikeotherai.nessie.desktop",
  "build": {
    "devUrl": "http://localhost:5555",
    "frontendDist": "../../admin/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nessie",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
