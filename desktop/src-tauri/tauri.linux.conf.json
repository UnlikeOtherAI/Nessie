{
  "$schema": "https://schema.tauri.app/config/2",
  "app": {
    "enableGTKAppId": true,
    "windows": [
      {
        "create": false,
        "label": "main",
        "title": "Nessie",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false,
        "theme": null,
        "backgroundColor": "#2e1132",
        "decorations": false,
        "transparent": true
      }
    ]
  },
  "bundle": {
    "resources": [],
    "targets": [
      "deb",
      "appimage"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": false
      },
      "deb": {
        "depends": [
          "desktop-file-utils",
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "xdg-utils"
        ]
      }
    }
  }
}
