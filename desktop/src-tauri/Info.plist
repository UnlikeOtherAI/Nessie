<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>ITSAppUsesNonExemptEncryption</key>
  <false/>
  <!-- Calling the Personal Assistant captures audio inside the WebView and
       streams it to Gemini Live. Without this string macOS refuses microphone
       access outright, and WKWebView does not expose navigator.mediaDevices at
       all — which surfaces as "undefined is not an object", not as a denied
       permission prompt. -->
  <key>NSMicrophoneUsageDescription</key>
  <string>Nessie uses the microphone for voice dictation and calls with your Personal Assistant.</string>
</dict>
</plist>
