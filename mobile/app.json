{
  "expo": {
    "name": "Nessie",
    "slug": "nessie",
    "owner": "unlikeotherai",
    "version": "0.1.1",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "scheme": "nessie",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.km.nessie",
      "appleTeamId": "59S95D279D",
      "buildNumber": "12",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        },
        "NSCameraUsageDescription": "Nessie uses the camera so you can take a profile photo.",
        "NSPhotoLibraryUsageDescription": "Nessie needs access to your photos so you can choose a profile photo.",
        "NSLocalNetworkUsageDescription": "AppReveal exposes a debug MCP server on the local network for AI-assisted testing.",
        "NSBonjourServices": [
          "_appreveal._tcp"
        ]
      }
    },
    "android": {
      "package": "com.km.nessie",
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      }
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon-rounded.png",
          "imageWidth": 64,
          "resizeMode": "contain",
          "backgroundColor": "#0f172a"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.0"
          },
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "expo-notifications",
      "react-native-bottom-tabs",
      "expo-web-browser"
    ],
    "extra": {
      "eas": {
        "projectId": "7fdf89c0-9fbc-4ca9-9d01-8eeda3efd62c"
      }
    }
  }
}
