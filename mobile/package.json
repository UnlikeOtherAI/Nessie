{
  "name": "@nessie/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "build:device:ios": "pnpm dlx eas-cli@latest build --platform ios --profile device",
    "build:device:android": "pnpm dlx eas-cli@latest build --platform android --profile device",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test:deeplink-simulator": "node test/deeplink-simulator-harness.mjs",
    "test": "tsx --test src/**/*.test.ts"
  },
  "expo": {
    "install": {
      "exclude": [
        "react",
        "@types/react"
      ]
    }
  },
  "dependencies": {
    "expo": "~55.0.0",
    "expo-application": "~55.0.19",
    "expo-build-properties": "~55.0.18",
    "expo-constants": "~55.0.17",
    "expo-dev-client": "~55.0.40",
    "expo-notifications": "~55.0.27",
    "expo-screen-orientation": "~55.0.20",
    "expo-splash-screen": "~55.0.25",
    "expo-status-bar": "~55.0.6",
    "expo-web-browser": "~55.0.20",
    "react": "19.2.4",
    "react-native": "0.83.10",
    "react-native-bottom-tabs": "^1.3.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.15.3",
    "react-native-webview": "13.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.0",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "eslint": "^10.2.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "typescript": "^5.9.3"
  }
}
