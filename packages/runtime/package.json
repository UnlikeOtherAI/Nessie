{
  "name": "@nessie/runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./model": {
      "types": "./src/model.ts",
      "default": "./dist/model.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings 0",
    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@hyzyla/pdfium": "^2.1.13",
    "@nessie/schemas": "workspace:*",
    "@prisma/client": "^6.17.1",
    "cron-parser": "^5.5.0",
    "pg": "^8.16.3",
    "sharp": "^0.35.3",
    "undici": "^6.26.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pg": "^8.15.5"
  }
}
