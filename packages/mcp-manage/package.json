{
  "name": "@nessie/mcp-manage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings 0",
    "pretest": "pnpm --filter @nessie/schemas build && pnpm --filter @nessie/mcp-client build && pnpm --filter @nessie/runtime build",
    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nessie/mcp-client": "workspace:*",
    "@nessie/workspace-admin": "workspace:*",
    "@nessie/runtime": "workspace:*",
    "@nessie/schemas": "workspace:*",
    "@prisma/client": "^6.17.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.24"
  }
}
