# Keep the Docker build context lean. All workspace source (api/, worker/,
# admin/, packages/*, manifests) is kept so a frozen install + full build work;
# everything below is rebuilt inside the image or irrelevant to it.
**/node_modules
**/dist
**/build
**/*.tsbuildinfo
.git
.github
.worktrees
.turbo
.nessie
.playwright-mcp
macos
remote
tmp
output
testing
simulation
e2e
# Mobile (Expo/React Native) app: keep only its package.json so the frozen
# workspace install can discover it; its source + huge RN dep tree must never
# bloat the backend/admin images (the installs use --filter='!@nessie/mobile').
mobile/*
!mobile/package.json
# Desktop (Tauri) app: same manifest-only treatment as mobile. Rust/native
# sources and bundles stay out of production backend/admin image contexts.
desktop/*
!desktop/package.json
# Gateway push relay: keep only its package.json in existing production image
# contexts; its own Dockerfile builds the service separately.
gateway/*
!gateway/package.json
assets
UI
docs
memory
# Root-level screenshots only — keep app assets like admin/public/icon-1024.png.
/*.png
/admin/*.png
*.log
**/.DS_Store
