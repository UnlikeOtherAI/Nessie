<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The packaged Node binary's entitlements.

  The hardened runtime is mandatory for notarization, and under it a process may
  not map memory that is both writable and executable. That is precisely what
  V8 does, so a hardened Node with no entitlement dies on its first compile with
  a bare SIGKILL and no diagnostic — the failure looks like "the daemon will not
  start", not like a signing problem, which is why this file exists next to the
  build rather than as a flag inside it.

  These two are granted to the one binary that needs them. They are NOT in the
  app's own entitlements: the menu bar app does not JIT, and an entitlement
  granted bundle-wide would apply to code that never asked for it.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
