{
  "name": "@nessie/executor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "nessie-executor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings 0",
    "prepare:chrome-cookie-import": "node scripts/prepare-chrome-cookie-import.mjs",
    "start": "tsx src/index.ts",
    "test": "node --test --import tsx test/**/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nessie/runtime": "workspace:*",
    "@nessie/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.24"
  }
}
