{
  "name": "@nessie/executor",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": {
    "nessie-executor": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src test --max-warnings 0",
    "prepare:chrome-cookie-import": "node scripts/prepare-chrome-cookie-import.mjs",
    "start": "tsx src/index.ts",
    "test": "node --test --test-force-exit --import tsx test/**/*.test.ts",
    "test:mcp": "node --test --test-force-exit --import tsx test/mcp-session-manager.test.ts test/kelpie-detect.test.ts test/local-mcp-report.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nessie/local-inference-host": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@nessie/runtime": "workspace:*",
    "@nessie/schemas": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.19.24"
  }
}
