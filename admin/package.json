{
  "name": "@nessie/admin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build && (lsof -ti :5555 | xargs kill -9 2>/dev/null; true) && sh -c 'nohup vite preview >/tmp/nessie-admin-preview.log 2>&1 < /dev/null &'",
    "predev": "lsof -ti :5555 | xargs kill -9 2>/dev/null || true",
    "dev": "vite",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.0",
    "@nessie/config": "workspace:*",
    "@nessie/schemas": "workspace:*",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.96.2",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.14.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.1.10"
  }
}
