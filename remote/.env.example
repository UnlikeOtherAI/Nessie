# --- Control server ---
REMOTE_CONTROL_ADDR=:8787

# --- SSO: authentication.unlikeotherai.com ---
# Full docs: ../docs/remote/sso.md
REMOTE_UOA_BASE_URL=https://authentication.unlikeotherai.com
REMOTE_UOA_DOMAIN=remote.helper.local
REMOTE_UOA_AUDIENCE=auth.unlikeotherai.com
REMOTE_UOA_CONFIG_URL=https://remote.helper.local/auth/uoa-config
REMOTE_UOA_REDIRECT_URL=https://remote.helper.local/auth/callback
REMOTE_UOA_SHARED_SECRET=replace-me
REMOTE_UOA_OWNER_SUB=replace-with-your-uoa-sub

# --- Internal session tokens ---
REMOTE_INTERNAL_JWT_SECRET=replace-me
REMOTE_INTERNAL_JWT_TTL=30m

# --- Data stores (Phase 1+) ---
REMOTE_POSTGRES_URL=postgres://remote:remote@127.0.0.1:5432/remote?sslmode=disable
REMOTE_REDIS_URL=redis://127.0.0.1:6379/0

# --- NAT traversal (Phase 4) ---
REMOTE_COTURN_SHARED_SECRET=replace-me
REMOTE_COTURN_REALM=remote.helper.local
REMOTE_COTURN_URI=turn:turn.helper.local:3478

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=remote-control
